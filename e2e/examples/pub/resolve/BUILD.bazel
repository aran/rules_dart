load("@rules_dart//dart:defs.bzl", "dart_binary")
load(":checks.bzl", "resolved_graph_check")

exports_files(["pubspec.lock"])

# Built from the mapped `path` package, which is built against the fork of
# `petitparser`.
dart_binary(
    name = "app",
    main = "main.dart",
    deps = ["@resolve_deps//:shared_models"],
)

# `xml` is locked and depends on `petitparser`, which `resolve` maps: it gets
# the fork, and no `petitparser` the lock pins is anywhere in its closure.
resolved_graph_check(
    name = "locked_package_gets_the_mapped_target",
    direct_deps = ["petitparser"],
    package_roots = {"petitparser": "pub/resolve/third_party/petitparser"},
    target = "@resolve_deps//:xml",
)

# The hub's label for the `path` package is the workspace target.
resolved_graph_check(
    name = "hub_label_is_the_mapped_target",
    package_roots = {
        "petitparser": "pub/resolve/third_party/petitparser",
        "shared_models": "pub/resolve/shared_models",
    },
    target = "@resolve_deps//:shared_models",
)
