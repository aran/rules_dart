load("@rules_dart//dart:defs.bzl", "dart_test")
load(":checks.bzl", "ignored_package_refused_test")

exports_files(["pubspec.lock"])

# `local_greeting` has no BUILD file: it is built from its directory, and
# depends on `meta` from the lock.
dart_test(
    name = "path_packages_test",
    size = "small",
    main = "path_packages_test.dart",
    deps = ["@path_deps//:local_greeting"],
)

# `editor_only` is ignored: its hub label exists, and analysing it fails with
# the reason the lock's `pub.from_lock()` gives.
ignored_package_refused_test(
    name = "ignored_package_refused",
    target_under_test = "@path_deps//:editor_only",
)
