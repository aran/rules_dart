load("@rules_dart//dart:defs.bzl", "dart_codegen", "dart_library", "dart_package_metadata")
load("@rules_dart//dart/ext/json_serializable:defs.bzl", "json_serializable_codegen")

# gazelle:dart_pub_deps_repo pub_deps

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "codegen",
    language_version = "3.11",
    visibility = ["//gazelle/codegen:__subpackages__"],
)

dart_codegen(
    name = "_event_freezed_gen",
    src = "lib/event.dart",
    generator = "@rules_dart//dart/ext/freezed:shim",
    output_suffixes = [".freezed.dart"],
    package = ":pubspec-metadata",
    deps = ["@pub_deps//:freezed_annotation"],
)

dart_codegen(
    name = "_event_json_serializable_gen",
    src = "lib/event.dart",
    asset_deps = [":_event_freezed_gen"],
    config = "{\"field_rename\":\"pascal\"}",
    generator = "@rules_dart//dart/ext/json_serializable:shim",
    output_suffixes = [".json_serializable.g.part"],
    package = ":pubspec-metadata",
    deps = [
        "@pub_deps//:freezed_annotation",
        "@pub_deps//:json_annotation",
    ],
)

dart_codegen(
    name = "_event_combined",
    src = "lib/event.dart",
    generator = "@rules_dart//dart/ext/combining_shim:bin",
    output_suffixes = [".g.dart"],
    package = ":pubspec-metadata",
    parts = [":_event_json_serializable_gen"],
)

dart_codegen(
    name = "_profile_copy_with_gen",
    src = "lib/profile.dart",
    generator = "@rules_dart//dart/ext/copy_with_extension_gen:shim",
    output_suffixes = [".copy_with_extension_gen.g.part"],
    package = ":pubspec-metadata",
    deps = [
        "@pub_deps//:copy_with_extension",
        "@pub_deps//:json_annotation",
    ],
)

dart_codegen(
    name = "_profile_json_serializable_gen",
    src = "lib/profile.dart",
    config = "{\"field_rename\":\"pascal\"}",
    generator = "@rules_dart//dart/ext/json_serializable:shim",
    output_suffixes = [".json_serializable.g.part"],
    package = ":pubspec-metadata",
    deps = [
        "@pub_deps//:copy_with_extension",
        "@pub_deps//:json_annotation",
    ],
)

dart_codegen(
    name = "_profile_combined",
    src = "lib/profile.dart",
    generator = "@rules_dart//dart/ext/combining_shim:bin",
    output_suffixes = [".g.dart"],
    package = ":pubspec-metadata",
    parts = [
        ":_profile_copy_with_gen",
        ":_profile_json_serializable_gen",
    ],
)

dart_library(
    name = "codegen",
    srcs = [
        "lib/codegen.dart",
        "lib/event.dart",
        "lib/greeting.dart",
        "lib/member.dart",
        "lib/profile.dart",
        "lib/src/model/address.dart",
        "lib/user.dart",
        ":_event_combined",
        ":_event_freezed_gen",
        ":_profile_combined",
        ":member_codegen",
        ":src/model/address_codegen",
        ":user_codegen",
    ],
    package = ":pubspec-metadata",
    visibility = ["//visibility:public"],
    deps = [
        "@pub_deps//:copy_with_extension",
        "@pub_deps//:freezed_annotation",
        "@pub_deps//:json_annotation",
    ],
)

json_serializable_codegen(
    name = "member_codegen",
    srcs = ["lib/member.dart"],
    asset_deps = [
        "lib/event.dart",
        "lib/greeting.dart",
        ":_event_freezed_gen",
    ],
    config = "{\"field_rename\":\"pascal\"}",
    package = ":pubspec-metadata",
    deps = [
        "@pub_deps//:freezed_annotation",
        "@pub_deps//:json_annotation",
    ],
)

json_serializable_codegen(
    name = "src/model/address_codegen",
    srcs = ["lib/src/model/address.dart"],
    config = "{\"field_rename\":\"pascal\"}",
    package = ":pubspec-metadata",
    deps = ["@pub_deps//:json_annotation"],
)

json_serializable_codegen(
    name = "user_codegen",
    srcs = ["lib/user.dart"],
    config = "{\"field_rename\":\"pascal\"}",
    package = ":pubspec-metadata",
    deps = ["@pub_deps//:json_annotation"],
)
