load("@rules_dart//dart:defs.bzl", "dart_binary", "dart_program_assets", "dart_test")
load(":in_rule.bzl", "assets_test", "in_rule_assets", "known_asset")

exports_files(["pubspec.lock"])

# Each binary records the uses of `@RecordUse` classes; each linked
# `dart_program_assets` runs `glyphs`' hook/link.dart over them, and declares
# the one data asset its `dart_package_metadata` promises the hook emits.

# AOT modes: the compiler writes the recorded uses beside the executable.
dart_binary(
    name = "app",
    main = "app.dart",
    record_use = True,
    deps = ["//native_hooks/glyphs"],
)

dart_program_assets(
    name = "app_assets",
    recorded_uses = ":app",
    deps = ["//native_hooks/glyphs"],
)

dart_binary(
    name = "app_aot",
    compile_mode = "aot-snapshot",
    main = "app.dart",
    record_use = True,
    deps = ["//native_hooks/glyphs"],
)

dart_program_assets(
    name = "app_aot_assets",
    recorded_uses = ":app_aot",
    deps = ["//native_hooks/glyphs"],
)

# A kernel is not tree-shaken, so nothing is recorded: the hook sees no uses.
dart_binary(
    name = "app_kernel",
    compile_mode = "kernel",
    main = "app.dart",
    record_use = True,
    deps = ["//native_hooks/glyphs"],
)

dart_program_assets(
    name = "app_kernel_assets",
    recorded_uses = ":app_kernel",
    deps = ["//native_hooks/glyphs"],
)

# Recorded uses from anywhere, as a plain JSON file.
dart_program_assets(
    name = "file_assets",
    recorded_uses = "recorded_uses.json",
    deps = ["//native_hooks/glyphs"],
)

# A hook whose package has a part written by a generator: the package is split
# between the source tree and `bazel-out`, and the hook runs from one assembled
# directory holding both.
dart_program_assets(
    name = "generated_assets",
    recorded_uses = "recorded_uses.json",
    deps = ["//native_hooks/generated"],
)

# A hook of a package in an external repository, whose imports come from the
# rest of this closure.
dart_program_assets(
    name = "external_assets",
    recorded_uses = "recorded_uses.json",
    deps = [
        "@ext_hook",
        "@pub_deps//:data_assets",
        "@pub_deps//:hooks",
    ],
)

# The same hooks run from inside another rule's implementation.
in_rule_assets(
    name = "in_rule_assets",
    recorded_uses = ":app",
    deps = ["//native_hooks/glyphs"],
)

# The index each hook promises, named at analysis time.
[
    known_asset(
        name = name + "_index",
        asset_id = "package:glyphs/glyphs/index.json",
        assets = ":" + name,
    )
    for name in [
        "app_assets",
        "app_aot_assets",
        "app_kernel_assets",
        "file_assets",
        "in_rule_assets",
    ]
]

# A linked program whose hook promises a file.
assets_test(
    name = "app_assets_test",
    assets = ":app_assets",
    expected = ["package:glyphs/glyphs/index.json=[heart,star]"],
)

known_asset(
    name = "generated_assets_index",
    asset_id = "package:generated_hook/generated_hook/names.json",
    assets = ":generated_assets",
)

known_asset(
    name = "external_assets_index",
    asset_id = "package:ext_hook/ext_hook/names.json",
    assets = ":external_assets",
)

dart_test(
    name = "index_test",
    size = "small",
    args = [
        "$(rlocationpath :app_assets_index)",
        "heart,star",
        "$(rlocationpath :app_aot_assets_index)",
        "heart,star",
        "$(rlocationpath :app_kernel_assets_index)",
        "(none)",
        "$(rlocationpath :file_assets_index)",
        "moon",
        "$(rlocationpath :in_rule_assets_index)",
        "heart,star",
        "$(rlocationpath :generated_assets_index)",
        "alpha,beta",
        "$(rlocationpath :external_assets_index)",
        "external",
    ],
    data = [
        ":app_aot_assets_index",
        ":app_assets_index",
        ":app_kernel_assets_index",
        ":external_assets_index",
        ":file_assets_index",
        ":generated_assets_index",
        ":in_rule_assets_index",
    ],
    main = "index_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)

# Declared data assets. `sounds` declares what its build hook emits and has a
# link hook, which receives them and keeps the sounds the program uses, which
# depend on the program: it promises none, and what it keeps lands in its
# output directory. `banner` declares one and has no link hook, so it ships as
# it is.
dart_binary(
    name = "sounds_app",
    main = "sounds_app.dart",
    record_use = True,
    deps = [
        "//native_hooks/banner",
        "//native_hooks/sounds",
    ],
)

dart_program_assets(
    name = "sounds_app_assets",
    recorded_uses = ":sounds_app",
    deps = [
        "//native_hooks/banner",
        "//native_hooks/sounds",
    ],
)

# Not linked, a program ships every declared asset.
dart_program_assets(
    name = "sounds_app_unlinked_assets",
    deps = [
        "//native_hooks/banner",
        "//native_hooks/sounds",
    ],
)

assets_test(
    name = "linked_assets_test",
    assets = ":sounds_app_assets",
    expected = [
        "package:banner/banner.txt=welcome",
        "package:sounds/chime.txt=ding",
    ],
)

# A consumer handed only the data assets, a hook's output directory among them.
assets_test(
    name = "linked_data_assets_test",
    assets = ":sounds_app_assets",
    code = "none",
    expected = [
        "package:banner/banner.txt=welcome",
        "package:sounds/chime.txt=ding",
    ],
)

# A test reads what a program ships from its runfiles: the target's
# `<name>.program_assets`, through `ProgramAssets.read`, linked and not, with a
# link hook's output directory, a promised file, a code selection and a
# library linked for the program.
dart_test(
    name = "runfiles_assets_test",
    size = "small",
    args = [
        "$(rlocationpath :sounds_app_assets)",
        "package:banner/banner.txt=welcome",
        "package:sounds/chime.txt=ding",
        ";",
        "$(rlocationpath :sounds_app_unlinked_assets)",
        "package:banner/banner.txt=welcome",
        "package:sounds/bell.txt=dong",
        "package:sounds/chime.txt=ding",
        ";",
        "$(rlocationpath :app_assets)",
        "package:glyphs/glyphs/index.json=[heart,star]",
        ";",
        "$(rlocationpath :pick_add_assets)",
        "package:pick/add",
        ";",
        "$(rlocationpath :trim_add_assets)",
        "package:trim/ops",
    ],
    data = [
        ":app_assets",
        ":pick_add_assets",
        ":sounds_app_assets",
        ":sounds_app_unlinked_assets",
        ":trim_add_assets",
    ],
    main = "runfiles_assets_test.dart",
    deps = [
        "@rules_dart//dart/program_assets",
        "@rules_dart//dart/runfiles",
    ],
)

# What `sounds`' hook keeps depends on the program: one using only the bell
# ships the bell, and not the chime.
dart_binary(
    name = "bell_app",
    main = "bell_app.dart",
    record_use = True,
    deps = ["//native_hooks/sounds"],
)

dart_program_assets(
    name = "bell_app_assets",
    recorded_uses = ":bell_app",
    deps = ["//native_hooks/sounds"],
)

assets_test(
    name = "bell_app_assets_test",
    assets = ":bell_app_assets",
    expected = [
        "package:sounds/bell.txt=dong",
    ],
)

assets_test(
    name = "unlinked_assets_test",
    assets = ":sounds_app_unlinked_assets",
    expected = [
        "package:banner/banner.txt=welcome",
        "package:sounds/bell.txt=dong",
        "package:sounds/chime.txt=ding",
    ],
)

# Code assets. `pick` declares two native libraries and has a link hook,
# which receives them and keeps those the program uses, as they are declared;
# not linked, a program ships both.
dart_program_assets(
    name = "pick_add_assets",
    recorded_uses = "//native_hooks/pick:uses/add.json",
    deps = ["//native_hooks/pick"],
)

dart_program_assets(
    name = "pick_unlinked_assets",
    deps = ["//native_hooks/pick"],
)

assets_test(
    name = "pick_add_assets_test",
    assets = ":pick_add_assets",
    expected = [
        "package:pick/add",
    ],
)

# A consumer handed only the code assets, with their libraries or by name,
# where it is not given the libraries.
assets_test(
    name = "pick_add_code_assets_test",
    assets = ":pick_add_assets",
    data = False,
    expected = ["package:pick/add"],
)

assets_test(
    name = "pick_add_code_names_test",
    assets = ":pick_add_assets",
    code = "names",
    data = False,
    expected = ["package:pick/add"],
)

assets_test(
    name = "pick_unlinked_assets_test",
    assets = ":pick_unlinked_assets",
    expected = [
        "package:pick/add",
        "package:pick/mul",
    ],
)

# Native code linked per program. `trim`'s library is linked into each linked
# program exporting just the operations the program uses, and whole into an
# unlinked one.
dart_program_assets(
    name = "trim_add_assets",
    recorded_uses = "//native_hooks/trim:uses/add.json",
    deps = ["//native_hooks/trim"],
)

dart_program_assets(
    name = "trim_unlinked_assets",
    deps = ["//native_hooks/trim"],
)

# A program using none of the operations ships a library exporting none.
dart_program_assets(
    name = "trim_none_assets",
    recorded_uses = "recorded_uses.json",
    deps = ["//native_hooks/trim"],
)

[
    known_asset(
        name = name + "_ops",
        asset_id = "package:trim/ops",
        assets = ":" + name,
    )
    for name in [
        "trim_none_assets",
        "trim_add_assets",
        "trim_unlinked_assets",
    ]
]

[
    assets_test(
        name = name + "_manifest_test",
        assets = ":" + name,
        expected = ["package:trim/ops"],
    )
    for name in [
        "trim_none_assets",
        "trim_add_assets",
        "trim_unlinked_assets",
    ]
]

dart_test(
    name = "trim_none_assets_test",
    size = "small",
    args = [
        "$(rlocationpath :trim_none_assets_ops)",
        "-trim_add",
        "-trim_mul",
        "-trim_sub",
    ],
    data = [":trim_none_assets_ops"],
    main = "exports_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)

dart_test(
    name = "trim_add_assets_test",
    size = "small",
    args = [
        "$(rlocationpath :trim_add_assets_ops)",
        "+trim_add",
        "-trim_mul",
        "-trim_sub",
    ],
    data = [":trim_add_assets_ops"],
    main = "exports_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)

dart_test(
    name = "trim_unlinked_assets_test",
    size = "small",
    args = [
        "$(rlocationpath :trim_unlinked_assets_ops)",
        "+trim_add",
        "+trim_mul",
        "+trim_sub",
    ],
    data = [":trim_unlinked_assets_ops"],
    main = "exports_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)

# A binary and a test load the library `trim` links into every program as
# their program ships it, not linked: whole.
dart_test(
    name = "trim_native_test",
    size = "small",
    main = "trim_native_test.dart",
    deps = ["//native_hooks/trim"],
)

dart_binary(
    name = "trim_app",
    main = "trim_app.dart",
    deps = ["//native_hooks/trim"],
)

dart_test(
    name = "trim_app_test",
    size = "small",
    args = [
        "$(rlocationpath :trim_app)",
        "5",
    ],
    data = [":trim_app"],
    main = "run_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)

# The program's own package, `jingle`, declares data assets and a link hook,
# and no library of it is in `deps`: linked, its hook keeps the tune; not
# linked, the program ships both of its sounds.
_JINGLE_DEPS = [
    "//native_hooks/sounds",
    "@pub_deps//:data_assets",
    "@pub_deps//:hooks",
]

dart_program_assets(
    name = "jingle_assets",
    package = "//native_hooks/jingle:pubspec-metadata",
    recorded_uses = "//native_hooks/jingle:app",
    deps = _JINGLE_DEPS,
)

in_rule_assets(
    name = "jingle_in_rule_assets",
    package = "//native_hooks/jingle:pubspec-metadata",
    recorded_uses = "//native_hooks/jingle:app",
    deps = _JINGLE_DEPS,
)

dart_program_assets(
    name = "jingle_unlinked_assets",
    package = "//native_hooks/jingle:pubspec-metadata",
    deps = _JINGLE_DEPS,
)

[
    assets_test(
        name = name + "_test",
        assets = ":" + name,
        expected = [
            "package:jingle/tune.txt=tune",
            "package:sounds/chime.txt=ding",
        ],
    )
    for name in [
        "jingle_assets",
        "jingle_in_rule_assets",
    ]
]

assets_test(
    name = "jingle_unlinked_assets_test",
    assets = ":jingle_unlinked_assets",
    expected = [
        "package:jingle/hum.txt=hum",
        "package:jingle/tune.txt=tune",
        "package:sounds/bell.txt=dong",
        "package:sounds/chime.txt=ding",
    ],
)

# Expected to fail: `glyphs`' hook refuses a Glyph built at run time. Tagged
# manual so `//...` stays green; CI's expected-failure job builds it and checks
# the hook's message reaches the user.
dart_binary(
    name = "dynamic_app",
    main = "dynamic_app.dart",
    record_use = True,
    tags = ["manual"],
    deps = ["//native_hooks/glyphs"],
)

dart_program_assets(
    name = "dynamic_app_assets",
    recorded_uses = ":dynamic_app",
    tags = ["manual"],
    deps = ["//native_hooks/glyphs"],
)

# Expected to fail: `faults`' hook does what the recorded uses of each JSON
# file ask, each against one check of what a hook emits. Tagged manual so
# `//...` stays green; CI's expected-failure job builds each and checks its
# message.
[
    dart_program_assets(
        name = "faults_" + fault,
        recorded_uses = "//native_hooks/faults:uses/%s.json" % fault,
        tags = ["manual"],
        deps = ["//native_hooks/faults"],
    )
    for fault in [
        "foreign",
        "twice",
        "escape",
        "unpromised",
        "route",
        "case",
        "prefix",
    ]
]

# Expected to fail: `trim`'s tool writes a symbol name with a space in it.
# Tagged manual; CI's expected-failure job builds it.
dart_program_assets(
    name = "trim_bad_assets",
    recorded_uses = "//native_hooks/trim:uses/bad.json",
    tags = ["manual"],
    deps = ["//native_hooks/trim"],
)

# Expected to fail: `pick`'s hook emits a library it built rather than one its
# package declares, keeps one under another id, or keeps one with another link
# mode. Tagged manual; CI's expected-failure job builds each.
[
    dart_program_assets(
        name = "pick_%s_assets" % fault,
        recorded_uses = "//native_hooks/pick:uses/%s.json" % fault,
        tags = ["manual"],
        deps = ["//native_hooks/pick"],
    )
    for fault in [
        "built",
        "renamed",
        "relinked",
    ]
]

# Expected to fail: the hook imports a file of its package that no target
# declares. `no-sandbox` runs it where the file is on disk, so only the
# package's assembled directory keeps the hook from reading it. Tagged manual
# so `//...` stays green; CI's expected-failure job builds it.
dart_program_assets(
    name = "undeclared_assets",
    recorded_uses = "recorded_uses.json",
    tags = [
        "manual",
        "no-sandbox",
    ],
    deps = ["//native_hooks/undeclared"],
)

# What a consumer of what a program ships does: opens every file it ships,
# run path-mapped (`read_assets` in in_rule.bzl).
dart_binary(
    name = "read_assets",
    main = "read_assets.dart",
    deps = ["@rules_dart//dart/program_assets"],
)
