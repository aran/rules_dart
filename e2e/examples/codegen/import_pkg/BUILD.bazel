load("@rules_dart//dart:defs.bzl", "dart_binary", "dart_codegen", "dart_library", "dart_package_metadata", "dart_test")

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "import_fixture",
    language_version = "3.11",
)

# Bazel-generated standalone libraries consumed via `package:` and relative
# imports (not `part`), feeding a runnable program and a test.

dart_codegen(
    name = "via_package_gen",
    src = "lib/via_package.dart",
    generator = "//codegen/tools:lib_gen",
    output_suffixes = [".g.dart"],
    package = ":pubspec-metadata",
)

dart_codegen(
    name = "via_relative_gen",
    src = "lib/via_relative.dart",
    generator = "//codegen/tools:lib_gen",
    output_suffixes = [".g.dart"],
    package = ":pubspec-metadata",
)

dart_library(
    name = "import_fixture",
    srcs = [
        "lib/via_package.dart",
        "lib/via_relative.dart",
        ":via_package_gen",
        ":via_relative_gen",
    ],
    package = ":pubspec-metadata",
    visibility = ["//visibility:public"],
)

dart_binary(
    name = "app",
    main = "bin/main.dart",
    deps = [":import_fixture"],
)

dart_test(
    name = "lib_test",
    size = "small",
    main = "test/lib_test.dart",
    deps = [
        ":import_fixture",
        "@pub_deps//:test",
    ],
)

dart_test(
    name = "app_run_test",
    size = "small",
    data = [":app"],
    main = "test/run_test.dart",
    deps = [
        "@pub_deps//:test",
        "@rules_dart//dart/runfiles",
    ],
)
