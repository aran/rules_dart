load("@rules_dart//dart:defs.bzl", "dart_library", "dart_package_metadata")

# Dart package root. The codegen targets consuming this library live in the
# NESTED Bazel package `gen/` — package_root resolves to `nested_aggregate_pkg`
# while the generated shards' short_paths sit under `nested_aggregate_pkg/gen/`.

exports_files(
    ["lib/item.dart"],
    visibility = ["//codegen/nested_aggregate_pkg/gen:__pkg__"],
)

# Stated once, for the rules here and the ones in `gen/`.
dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "nested_aggregate_fixture",
    language_version = "3.11",
    visibility = ["//codegen/nested_aggregate_pkg/gen:__pkg__"],
)

dart_library(
    name = "item_lib",
    srcs = ["lib/item.dart"],
    package = ":pubspec-metadata",
    visibility = ["//codegen/nested_aggregate_pkg/gen:__pkg__"],
)
