load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//web/per_compiler/rules:defs.bzl", "module_library", "native_module")

# Says it is the same under every compiler, so it is built once.
write_file(
    name = "src",
    out = "lib/independent.dart",
    content = [
        "/// Generated.",
        "const int independent = 1;",
        "",
    ],
)

native_module(name = "module")

module_library(
    name = "independent",
    package_name = "independent",
    srcs = [":src"],
    modules = [":module"],
    runtime_independent = True,
    visibility = ["//visibility:public"],
)
