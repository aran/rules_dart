# One working example per rules_dart feature (README.md lists them), and the
# fixtures under fixtures/ that test their edge cases. The common setup comes
# first; each section after it sets up what one directory needs.
module(name = "examples")

bazel_dep(name = "rules_dart", version = "0.0.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")

local_path_override(
    module_name = "rules_dart",
    path = "../..",
)

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.7")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")

pub = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub")

# The lint ruleset the analysis options include. Lint-only: reached through
# options files, never through a lock, so it does not become a dependency of
# anything that compiles.
pub.package(
    name = "very_good_analysis",
    sha256 = "0bd5eb8d6be76aa0d71e70cbdae6cac8f784f761170568e3c2214a6948c7f6d3",
    version = "11.0.0",
)
use_repo(pub, "very_good_analysis")

# web/app: its pub dependencies, from the lock `dart pub get` writes beside its
# pubspec; its path package is the workspace's own target.
pub.from_lock(
    name = "pub_deps",
    lock = "//web/app:pubspec.lock",
    resolve = {"greet": "//web/app/greet"},
)
use_repo(pub, "pub_deps")

# shared_lint_rules: a module sharing a lint ruleset, which its options file
# includes by `package:` URI.
bazel_dep(name = "lint_rules", version = "0.0.0")
local_path_override(
    module_name = "lint_rules",
    path = "fixtures/modules/lint_rules",
)

# builders, native_assets: SQLite, built from its C amalgamation (the BCR
# sqlite3 module) and wrapped in a cc_shared_library, for the drift exemplar's
# database test and native_assets/sqlite3_binary: the Bazel sandbox has no
# system libsqlite3 on Linux or Windows. rules_cc is needed for the
# cc_shared_library load.
bazel_dep(name = "sqlite3", version = "3.53.4")
bazel_dep(name = "rules_cc", version = "0.2.28")

# On macOS, rules_cc leaves C++ to apple_support's toolchain. 2.9.0 builds that
# toolchain's helper tools for macOS 11, the oldest Xcode 27's libc++ accepts
# without a warning.
bazel_dep(name = "apple_support", version = "2.10.1")

# builders: the exemplars' pub dependencies, and the external-builder
# fixture's own resolution of build, source_gen and analyzer, apart from
# `pub_deps`, as a builder from another rule set has.
pub.from_lock(
    name = "pub_deps",
    lock = "//builders:pubspec.lock",
)
pub.from_lock(
    name = "builder_pub_deps",
    lock = "//builders/external_builder/builder:pubspec.lock",
)
use_repo(pub, "builder_pub_deps")

# native_assets/webcrypto: `webcrypto`, declared on its own at the version
# rules_dart curates a code asset for, and the packages its pubspec names that
# no lock here lists.
pub.package(
    name = "webcrypto",
    sha256 = "9885ed99a846191542dd6ca820c83a098117df56be57453832233a3fef68f3f2",
    version = "0.6.1",
)
pub.package(
    name = "native_toolchain_cmake",
    sha256 = "8ba223410102665483e873b83d2156720233a6a0181c07f9dc41cb2e961336b0",
    version = "0.3.2",
)
pub.package(
    name = "change_case",
    sha256 = "e41ef3df58521194ef8d7649928954805aeb08061917cf658322305e61568003",
    version = "2.2.0",
)
use_repo(pub, "webcrypto")

# A C++ toolchain for Linux arm64 execution platforms, so a C++ library built
# for the host that runs a test (or for a code generator) compiles on a Linux
# arm64 worker. hermetic-llvm's toolchain is one static binary with its own C
# library, so the worker needs no headers or shared libraries. Only the
# Linux-exec, Linux-target toolchain is registered: Mac builds keep the host's.
bazel_dep(name = "llvm", version = "0.8.26", dev_dependency = True)

llvm_tc = use_extension("@llvm//extensions:toolchain.bzl", "toolchain", dev_dependency = True)
llvm_tc.exec(
    arch = "aarch64",
    os = "linux",
)
llvm_tc.target(
    arch = "aarch64",
    os = "linux",
)
use_repo(llvm_tc, "llvm_toolchains")

register_toolchains(
    "@llvm_toolchains//:all",
    dev_dependency = True,
)

# native_hooks: its packages' pub dependencies, and a package with a link hook
# that comes from another module, as a pub package's does. Its code assets are
# built by the C toolchain the builders section sets up.
pub.from_lock(
    name = "pub_deps",
    lock = "//native_hooks:pubspec.lock",
)

bazel_dep(name = "ext_hook", version = "0.0.0")
local_path_override(
    module_name = "ext_hook",
    path = "fixtures/modules/ext_hook",
)

# gazelle: Gazelle with the rules_dart plugin, which writes the BUILD files
# under gazelle/, and the runtime packages of gazelle/codegen. Building the Go
# binaries goes through the C++ toolchain, apple_support's on macOS (the
# builders section).
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "rules_dart_gazelle_plugin", version = "0.0.0")
local_path_override(
    module_name = "rules_dart_gazelle_plugin",
    path = "../../gazelle",
)

pub.from_lock(
    name = "pub_deps",
    lock = "//gazelle/codegen:pubspec.lock",
)

# pub/package: one pub.dev package, declared on its own with its version and
# archive digest.
pub.package(
    name = "path",
    sha256 = "75cca69d1490965be98c73ceaea117e8a04dd21217b37b292c9ddbec0d955bc5",
    version = "1.9.1",
)
use_repo(pub, "path")

# pub/lock: the packages of a pubspec.lock, through a dev-only use of the pub
# extension, as a module whose dependents need none of them would declare
# them; and the package metadata every fetched package carries.
bazel_dep(name = "package_metadata", version = "0.0.15")

pub_dev = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub", dev_dependency = True)
pub_dev.from_lock(
    name = "lock_deps",
    lock = "//pub/lock:pubspec.lock",
)
use_repo(pub_dev, "lock_deps")

# pub/resolve: the lock lists `shared_models` as a `path` package, which must
# be mapped, and `petitparser` as a hosted one, mapped here to a fork that
# `xml` must then get. A mapping replaces the package for every module,
# rules_dart's own tools included, so no other lock here may list either.
pub.from_lock(
    name = "resolve_deps",
    lock = "//pub/resolve:pubspec.lock",
    resolve = {
        "petitparser": "//pub/resolve/third_party/petitparser",
        "shared_models": "//pub/resolve/shared_models",
    },
)
use_repo(pub, "resolve_deps")

# codegen: copy_to_directory for a package assembled by hand
# (codegen/source_set_pkg), and the fixture packages' pub dependencies.
bazel_dep(name = "bazel_lib", version = "3.7.2")

pub.from_lock(
    name = "pub_deps",
    lock = "//codegen:pubspec.lock",
)

# fix: the fixture generator's own pub resolution (fix/tools), and
# fix/unused's conformance test's, `package:test` among them.
pub.from_lock(
    name = "generator_pub_deps",
    lock = "//fix/tools:pubspec.lock",
)
pub.from_lock(
    name = "test_pub_deps",
    lock = "//fix/unused:pubspec.lock",
)
use_repo(pub, "generator_pub_deps", "test_pub_deps")

# tests/package_test: tests under `package:test`, with pub dependencies from
# the lock beside its pubspec. Each lock that names the hub `pub_deps` adds
# its packages to it.
pub.from_lock(
    name = "pub_deps",
    lock = "//tests/package_test:pubspec.lock",
)

# web/per_compiler: its fixtures' pub dependencies, and the fixture generator's
# own pub resolution, apart from the fixtures' code.
pub.from_lock(
    name = "pub_deps",
    lock = "//web/per_compiler:pubspec.lock",
)
pub.from_lock(
    name = "generator_pub_deps",
    lock = "//web/per_compiler/tools:pubspec.lock",
)

# cross_compile: the platforms it builds for.
bazel_dep(name = "rules_platform", version = "0.1.0")

# fixtures/no_pubspec: pub packages without a pubspec, each pinned here, where
# Bazel pins any other archive, rather than resolved from a pubspec into a
# lock. Each is built with the dependencies its archive's pubspec states, so
# `json_annotation` needs no word about `meta` beyond the pin that supplies it.
pub.package(
    name = "json_annotation",
    sha256 = "2a743920d81b7910627f68ee2c9ac1fc0bfee32b9fc3403587d7c6791ca12f80",
    version = "4.12.0",
)
pub.package(
    name = "meta",
    sha256 = "307249ce4ff29d58a18e97f6345f539382eb9c9c29ecda628900f31de0443dd9",
    version = "1.19.0",
)
use_repo(pub, "change_case", "json_annotation", "meta", "native_toolchain_cmake")

# fixtures/kernel_source_refused: each repository is declared wrongly in its
# own way, and fails only when it is fetched. `/usr` is a directory that is
# not a Dart SDK checkout.
dart_kernel_source = use_repo_rule("@rules_dart//dart:repositories.bzl", "dart_kernel_source")

dart_kernel_source(
    name = "both",
    dart_version = "3.13.7",
    path = "/usr",
)

dart_kernel_source(
    name = "neither",
)

dart_kernel_source(
    name = "not_a_checkout",
    path = "/usr",
)
