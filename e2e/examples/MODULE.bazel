# One working example per rules_dart feature (README.md lists them), and the
# fixtures under fixtures/ that test their edge cases. The common setup comes
# first; each section after it sets up what one directory needs.
module(name = "examples")

bazel_dep(name = "rules_dart", version = "0.0.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")

local_path_override(
    module_name = "rules_dart",
    path = "../..",
)

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.7")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")

pub = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub")

# The lint ruleset the analysis options include. Lint-only: reached through
# options files, never through a lock, so it does not become a dependency of
# anything that compiles.
pub.package(
    name = "very_good_analysis",
    sha256 = "0bd5eb8d6be76aa0d71e70cbdae6cac8f784f761170568e3c2214a6948c7f6d3",
    version = "11.0.0",
)
use_repo(pub, "very_good_analysis")

# web/app: its pub dependencies, from the lock `dart pub get` writes beside its
# pubspec; its path package is the workspace's own target.
pub.from_lock(
    name = "pub_deps",
    lock = "//web/app:pubspec.lock",
    resolve = {"greet": "//web/app/greet"},
)
use_repo(pub, "pub_deps")

# tests/package_test: tests under `package:test`, with pub dependencies from
# the lock beside its pubspec. Each lock that names the hub `pub_deps` adds
# its packages to it.
pub.from_lock(
    name = "pub_deps",
    lock = "//tests/package_test:pubspec.lock",
)

# cross_compile: the platforms it builds for.
bazel_dep(name = "rules_platform", version = "0.1.0")

# fixtures/no_pubspec: pub packages without a pubspec, each pinned here, where
# Bazel pins any other archive, rather than resolved from a pubspec into a
# lock. Each is built with the dependencies its archive's pubspec states, so
# `json_annotation` needs no word about `meta` beyond the pin that supplies it.
pub.package(
    name = "json_annotation",
    sha256 = "2a743920d81b7910627f68ee2c9ac1fc0bfee32b9fc3403587d7c6791ca12f80",
    version = "4.12.0",
)
pub.package(
    name = "meta",
    sha256 = "307249ce4ff29d58a18e97f6345f539382eb9c9c29ecda628900f31de0443dd9",
    version = "1.19.0",
)
use_repo(pub, "json_annotation", "meta")

# fixtures/kernel_source_refused: each repository is declared wrongly in its
# own way, and fails only when it is fetched. `/usr` is a directory that is
# not a Dart SDK checkout.
dart_kernel_source = use_repo_rule("@rules_dart//dart:repositories.bzl", "dart_kernel_source")

dart_kernel_source(
    name = "both",
    dart_version = "3.13.7",
    path = "/usr",
)

dart_kernel_source(
    name = "neither",
)

dart_kernel_source(
    name = "not_a_checkout",
    path = "/usr",
)
