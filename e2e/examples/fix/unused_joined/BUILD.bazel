load("@rules_dart//dart:defs.bzl", "dart_library", "dart_package_metadata")

# A fixture of `@rules_dart//dart/unused_deps`, which //fix/write_back runs. It
# lists a dep its file does not import, so it fails to build, and is `manual`.
# The run writes the dep as two joined strings, which buildifier makes one: the
# fixer cannot then find it in this file, and must leave the file alone.

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "fix_unused_joined",
)

dart_library(
    name = "leaf",
    srcs = ["lib/leaf.dart"],
    package = ":pubspec-metadata",
)

dart_library(
    name = "lib",
    srcs = ["lib/joined.dart"],
    package = ":pubspec-metadata",
    tags = ["manual"],
    deps = ["//fix/unused_joined:leaf"],
)
