load("@rules_dart//dart:defs.bzl", "dart_analysis_config", "dart_analysis_options")

# The options of everything below here: a ruleset another Bazel module
# shares, included by `package:` URI (analysis_options.yaml). The workspace's
# `analysis_config` lists them.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    visibility = ["//:__pkg__"],
    deps = ["@lint_rules//dep_rules"],
)

# Expected to fail: an options target from another repository governs nothing
# here. Built by hand, so `manual`.
dart_analysis_config(
    name = "cross_repo_config",
    options = ["@lint_rules//:options"],
    tags = ["manual"],
)
