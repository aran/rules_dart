# Analyze and format-check every Dart target a test run names, under
# //:analysis_config.
test --aspects=@rules_dart//dart:analyze.bzl%dart_analyze
test --output_groups=+dart_analyze
test --output_groups=+dart_format
common --@rules_dart//dart:analysis_config=//:analysis_config

# cross_compile: `dart compile --target-os` downloads its cross binaries unless
# they are already in its cache, so a sandbox without network is what proves
# the cross toolchains supply them. Nothing here needs the network.
build --sandbox_default_allow_network=false

# Path mapping, as a downstream that shares results across configurations
# builds: every action that supports it sees `bazel-out/cfg/...` for each
# output directory and runs sandboxed, persistent workers included;
# native_hooks' `read_assets` opens every file a program's manifest names that
# way. Windows has
# no sandbox, so there Bazel would fail a path-mapped action.
common --enable_platform_specific_config
common:linux --experimental_output_paths=strip
common:macos --experimental_output_paths=strip

# tests: the `--@rules_dart//dart:extra_dart_defines` command-line channel, the
# way a real config group would use it: one define this build sets only from
# the flag, and one that collides with a target's own `defines` so the
# precedence is observable. See `//tests:defines_test`.
build --@rules_dart//dart:extra_dart_defines=E2E_FLAG=from_flag
build --@rules_dart//dart:extra_dart_defines=E2E_WINNER=flag

# tests/package_test/coverage: `check` checks that a generated source and a
# test's own files are reported, which Bazel instruments only when asked.
coverage --experimental_collect_code_coverage_for_generated_files
coverage --instrument_test_targets

# pub/git: the client's GIT_* variables reach repository rules. These would
# relocate or reconfigure git, or are values git refuses outright; a git
# package must fetch the same bytes with them set. No other repository here
# runs git.
common --repo_env=GIT_DIR=/nonexistent/git-dir
common --repo_env=GIT_WORK_TREE=/nonexistent/work-tree
common --repo_env=GIT_INDEX_FILE=/nonexistent/index
common --repo_env=GIT_OBJECT_DIRECTORY=/nonexistent/objects
common "--repo_env=GIT_CONFIG_PARAMETERS='core.autocrlf'='true'"
common --repo_env=GIT_ATTR_SOURCE=

# fix/deep: targets tagged `deep` are left out of building, not only of
# testing, unless `--config=deep` is passed.
build --build_tag_filters=-deep
build:deep --build_tag_filters=

try-import %workspace%/.bazelrc.user
