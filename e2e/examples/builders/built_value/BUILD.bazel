load(
    "@rules_dart//dart:defs.bzl",
    "dart_library",
    "dart_package_metadata",
    "dart_test",
)
load("@rules_dart//dart/ext/built_value:defs.bzl", "built_value_codegen")

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "built_value_sample",
    language_version = "3.11",
)

# Comprehensive e2e for built_value_codegen:
#  - user.dart / profile.dart — Built<T, TBuilder> value classes, one with
#    nullable + BuiltList fields and a Serializer<T> getter
#  - serializers.dart — @SerializersFor(...) + StandardJsonPlugin
#
# The serializers codegen runs on serializers.dart alone but needs to
# resolve the `Profile` reference in `@SerializersFor([Profile])` at
# analysis time: cross-file visibility inside the same package, which
# the macro gives each source's generator by staging the macro's other
# sources beside it.

built_value_codegen(
    name = "built_value_codegen",
    srcs = [
        "lib/profile.dart",
        "lib/serializers.dart",
        "lib/user.dart",
    ],
    package = ":pubspec-metadata",
    deps = ["@pub_deps//:built_collection"],
)

dart_library(
    name = "built_value",
    srcs = [
        "lib/profile.dart",
        "lib/serializers.dart",
        "lib/user.dart",
        ":built_value_codegen",
    ],
    package = ":pubspec-metadata",
    visibility = ["//visibility:public"],
    deps = [
        "@pub_deps//:built_collection",
        "@pub_deps//:built_value",
    ],
)

dart_test(
    name = "user_test",
    size = "small",
    main = "test/user_test.dart",
    deps = [
        ":built_value",
        "@pub_deps//:test",
    ],
)

dart_test(
    name = "profile_serializer_test",
    size = "small",
    main = "test/profile_serializer_test.dart",
    deps = [
        ":built_value",
        "@pub_deps//:built_collection",
        "@pub_deps//:test",
    ],
)
