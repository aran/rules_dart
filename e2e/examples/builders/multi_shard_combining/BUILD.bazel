# Two SharedPartBuilders fan into the combining shim for one `.g.dart`.

load(
    "@rules_dart//dart:defs.bzl",
    "dart_codegen",
    "dart_library",
    "dart_package_metadata",
    "dart_test",
)

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "multi_shard_combining",
)

_ANN_DEPS = [
    "@pub_deps//:copy_with_extension",
    "@pub_deps//:json_annotation",
]

dart_codegen(
    name = "_user_json_part",
    src = "lib/user.dart",
    generator = "@rules_dart//dart/ext/json_serializable:shim",
    output_suffixes = [".json_serializable.g.part"],
    package = ":pubspec-metadata",
    deps = _ANN_DEPS,
)

dart_codegen(
    name = "_user_copy_with_part",
    src = "lib/user.dart",
    generator = "@rules_dart//dart/ext/copy_with_extension_gen:shim",
    output_suffixes = [".copy_with_extension_gen.g.part"],
    package = ":pubspec-metadata",
    deps = _ANN_DEPS,
)

dart_codegen(
    name = "_user_combined",
    src = "lib/user.dart",
    generator = "@rules_dart//dart/ext/combining_shim:bin",
    output_suffixes = [".g.dart"],
    package = ":pubspec-metadata",
    parts = [
        ":_user_copy_with_part",
        ":_user_json_part",
    ],
)

dart_library(
    name = "multi_shard_combining",
    srcs = [
        "lib/user.dart",
        ":_user_combined",
    ],
    package = ":pubspec-metadata",
    visibility = ["//visibility:public"],
    deps = _ANN_DEPS,
)

dart_test(
    name = "user_test",
    size = "small",
    main = "test/user_test.dart",
    deps = [
        ":multi_shard_combining",
        "@pub_deps//:test",
    ],
)
