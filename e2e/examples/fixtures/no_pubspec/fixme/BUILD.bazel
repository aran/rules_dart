load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@rules_dart//dart:defs.bzl", "dart_library", "dart_package_metadata")
load("//fixtures/no_pubspec:checks.bzl", "fix_changes")

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "fixme",
    language_version = "3.11",
)

# A library with a `prefer_final_locals` violation to fix, so it opts out of
# the analysis the rest of the workspace passes.
dart_library(
    name = "fixme",
    srcs = ["lib/fixme.dart"],
    package = ":pubspec-metadata",
    tags = ["no-dart-analyze"],
)

fix_changes(
    name = "fixes",
    target = ":fixme",
)

# The one file fixed: the local it never reassigns is made final.
diff_test(
    name = "fixes_test",
    size = "small",
    file1 = ":fixes",
    file2 = "golden/fixes.json",
)
