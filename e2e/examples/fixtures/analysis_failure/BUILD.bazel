load(
    "@rules_dart//dart:defs.bzl",
    "dart_analysis_options",
    "dart_binary",
    "dart_library",
)

# Every target in this directory and below is expected to FAIL to build under
# `bazel test`, which applies the `dart_analyze` aspect's analysis and format
# check (see the workspace's `.bazelrc`), so each is `manual` and `//...`
# leaves it out. The expected-failure CI job builds each one and greps for its
# diagnostic, so each target fails with a diagnostic no other target shares.

# The options of every file here without nearer ones: none of their own, so
# the SDK's defaults apply, as in a repository with no options file. The
# workspace's `analysis_config` lists this and the nearer ones below.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    visibility = ["//:__pkg__"],
)

# bad.dart carries an unused_local_variable diagnostic: the analyze action's
# error path (diagnostics must fail the build, not be swallowed by the runner),
# named at its workspace path.
dart_library(
    name = "bad_lib",
    srcs = ["lib/bad.dart"],
    tags = ["manual"],
)

# The same guard for an entrypoint. A `dart_binary`'s `main` is under no `lib/`,
# so it is staged for analysis from `DartAnalyzableInfo` rather than from any
# package's sources — and a diagnostic in it must fail the build exactly as one
# in a library does. Without this, staging that quietly dropped the entrypoint
# would leave the analyzer reporting "No issues found" on a file it never read.
dart_binary(
    name = "bad_bin",
    main = "bad_main.dart",
    tags = ["manual"],
)

# The format check's three red paths are `fmt`, `fmt_unresolved` and
# `undeclared_include`. A formatting violation must fail the build, and —
# the reason the other two exist — a *broken options file* must fail it too.
# `dart format` treats an unresolvable `include:` as a warning, exits 0, and
# silently formats at stock defaults, so without the runner's escalation a
# misconfigured ruleset and a correctly formatted codebase would look identical.
