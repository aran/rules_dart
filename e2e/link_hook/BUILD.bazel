load("@rules_dart//dart:defs.bzl", "dart_analysis_config", "dart_analysis_options", "dart_binary", "dart_program_assets", "dart_test")
load(":in_rule.bzl", "in_rule_assets", "known_asset")

exports_files(["pubspec.lock"])

# Each binary records the uses of `@RecordUse` classes; each linked
# `dart_program_assets` runs `glyphs`' hook/link.dart over them, and declares
# the one data asset its `dart_package_metadata` promises the hook emits.

# AOT modes: the compiler writes the recorded uses beside the executable.
dart_binary(
    name = "app",
    main = "app.dart",
    record_use = True,
    deps = ["//glyphs"],
)

dart_program_assets(
    name = "app_assets",
    recorded_uses = ":app",
    deps = ["//glyphs"],
)

dart_binary(
    name = "app_aot",
    compile_mode = "aot-snapshot",
    main = "app.dart",
    record_use = True,
    deps = ["//glyphs"],
)

dart_program_assets(
    name = "app_aot_assets",
    recorded_uses = ":app_aot",
    deps = ["//glyphs"],
)

# A kernel is not tree-shaken, so nothing is recorded: the hook sees no uses.
dart_binary(
    name = "app_kernel",
    compile_mode = "kernel",
    main = "app.dart",
    record_use = True,
    deps = ["//glyphs"],
)

dart_program_assets(
    name = "app_kernel_assets",
    recorded_uses = ":app_kernel",
    deps = ["//glyphs"],
)

# Recorded uses from anywhere, as a plain JSON file.
dart_program_assets(
    name = "file_assets",
    recorded_uses = "recorded_uses.json",
    deps = ["//glyphs"],
)

# A hook whose package has a part written by a generator: the package is split
# between the source tree and `bazel-out`, and the hook runs from one assembled
# directory holding both.
dart_program_assets(
    name = "generated_assets",
    recorded_uses = "recorded_uses.json",
    deps = ["//generated"],
)

# A hook of a package in an external repository, whose imports come from the
# rest of this closure.
dart_program_assets(
    name = "external_assets",
    recorded_uses = "recorded_uses.json",
    deps = [
        "@ext_hook",
        "@pub_deps//:data_assets",
        "@pub_deps//:hooks",
    ],
)

# The same hooks run from inside another rule's implementation.
in_rule_assets(
    name = "in_rule_assets",
    recorded_uses = ":app",
    deps = ["//glyphs"],
)

# The index each hook promises, named at analysis time.
[
    known_asset(
        name = name + "_index",
        asset_id = "package:glyphs/glyphs/index.json",
        assets = ":" + name,
    )
    for name in [
        "app_assets",
        "app_aot_assets",
        "app_kernel_assets",
        "file_assets",
        "in_rule_assets",
    ]
]

known_asset(
    name = "generated_assets_index",
    asset_id = "package:generated_hook/generated_hook/names.json",
    assets = ":generated_assets",
)

known_asset(
    name = "external_assets_index",
    asset_id = "package:ext_hook/ext_hook/names.json",
    assets = ":external_assets",
)

dart_test(
    name = "index_test",
    size = "small",
    args = [
        "$(rlocationpath :app_assets_index)",
        "heart,star",
        "$(rlocationpath :app_aot_assets_index)",
        "heart,star",
        "$(rlocationpath :app_kernel_assets_index)",
        "(none)",
        "$(rlocationpath :file_assets_index)",
        "moon",
        "$(rlocationpath :in_rule_assets_index)",
        "heart,star",
        "$(rlocationpath :generated_assets_index)",
        "alpha,beta",
        "$(rlocationpath :external_assets_index)",
        "external",
    ],
    data = [
        ":app_aot_assets_index",
        ":app_assets_index",
        ":app_kernel_assets_index",
        ":external_assets_index",
        ":file_assets_index",
        ":generated_assets_index",
        ":in_rule_assets_index",
    ],
    main = "index_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)

# Declared data assets. `sounds` declares what its build hook emits and has a
# link hook, which receives them and keeps the sounds the program uses, which
# depend on the program: it promises none, and what it keeps lands in its
# output directory. `banner` declares one and has no link hook, so it ships as
# it is.
dart_binary(
    name = "sounds_app",
    main = "sounds_app.dart",
    record_use = True,
    deps = [
        "//banner",
        "//sounds",
    ],
)

dart_program_assets(
    name = "sounds_app_assets",
    recorded_uses = ":sounds_app",
    deps = [
        "//banner",
        "//sounds",
    ],
)

# Not linked, a program ships every declared asset.
dart_program_assets(
    name = "sounds_app_unlinked_assets",
    deps = [
        "//banner",
        "//sounds",
    ],
)

dart_test(
    name = "linked_assets_test",
    size = "small",
    args = [
        "'$(rlocationpaths :sounds_app_assets)'",
        "package:banner/banner.txt=welcome",
        "package:sounds/chime.txt=ding",
    ],
    data = [":sounds_app_assets"],
    main = "assets_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)

# What `sounds`' hook keeps depends on the program: one using only the bell
# ships the bell, and not the chime.
dart_binary(
    name = "bell_app",
    main = "bell_app.dart",
    record_use = True,
    deps = ["//sounds"],
)

dart_program_assets(
    name = "bell_app_assets",
    recorded_uses = ":bell_app",
    deps = ["//sounds"],
)

dart_test(
    name = "bell_app_assets_test",
    size = "small",
    args = [
        "'$(rlocationpaths :bell_app_assets)'",
        "package:sounds/bell.txt=dong",
    ],
    data = [":bell_app_assets"],
    main = "assets_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)

dart_test(
    name = "unlinked_assets_test",
    size = "small",
    args = [
        "'$(rlocationpaths :sounds_app_unlinked_assets)'",
        "package:banner/banner.txt=welcome",
        "package:sounds/bell.txt=dong",
        "package:sounds/chime.txt=ding",
    ],
    data = [":sounds_app_unlinked_assets"],
    main = "assets_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)

# Code assets. `pick` declares two native libraries and has a link hook,
# which receives them and keeps those the program uses, under ids of its own;
# not linked, a program ships both under the ids the package declares.
dart_program_assets(
    name = "pick_add_assets",
    recorded_uses = "//pick:uses/add.json",
    deps = ["//pick"],
)

dart_program_assets(
    name = "pick_unlinked_assets",
    deps = ["//pick"],
)

dart_test(
    name = "pick_add_assets_test",
    size = "small",
    args = [
        "'$(rlocationpaths :pick_add_assets)'",
        "package:pick/kept/add",
    ],
    data = [":pick_add_assets"],
    main = "assets_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)

dart_test(
    name = "pick_unlinked_assets_test",
    size = "small",
    args = [
        "'$(rlocationpaths :pick_unlinked_assets)'",
        "package:pick/add",
        "package:pick/mul",
    ],
    data = [":pick_unlinked_assets"],
    main = "assets_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)

# Native code linked per program. `trim`'s library is linked into each linked
# program exporting just the operations the program uses, and whole into an
# unlinked one.
dart_program_assets(
    name = "trim_add_assets",
    recorded_uses = "//trim:uses/add.json",
    deps = ["//trim"],
)

dart_program_assets(
    name = "trim_unlinked_assets",
    deps = ["//trim"],
)

# A program using none of the operations ships a library exporting none.
dart_program_assets(
    name = "trim_none_assets",
    recorded_uses = "recorded_uses.json",
    deps = ["//trim"],
)

dart_test(
    name = "trim_none_assets_test",
    size = "small",
    args = [
        "'$(rlocationpaths :trim_none_assets)'",
        "package:trim/ops",
        "-trim_add",
        "-trim_mul",
        "-trim_sub",
    ],
    data = [":trim_none_assets"],
    main = "exports_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)

dart_test(
    name = "trim_add_assets_test",
    size = "small",
    args = [
        "'$(rlocationpaths :trim_add_assets)'",
        "package:trim/ops",
        "+trim_add",
        "-trim_mul",
        "-trim_sub",
    ],
    data = [":trim_add_assets"],
    main = "exports_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)

dart_test(
    name = "trim_unlinked_assets_test",
    size = "small",
    args = [
        "'$(rlocationpaths :trim_unlinked_assets)'",
        "package:trim/ops",
        "+trim_add",
        "+trim_mul",
        "+trim_sub",
    ],
    data = [":trim_unlinked_assets"],
    main = "exports_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)

# A binary and a test load the library `trim` links into every program as
# their program ships it, not linked: whole.
dart_test(
    name = "trim_native_test",
    size = "small",
    main = "trim_native_test.dart",
    deps = ["//trim"],
)

dart_binary(
    name = "trim_app",
    main = "trim_app.dart",
    deps = ["//trim"],
)

dart_test(
    name = "trim_app_test",
    size = "small",
    args = [
        "$(rlocationpath :trim_app)",
        "5",
    ],
    data = [":trim_app"],
    main = "run_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)

# The program's own package, `jingle`, declares data assets and a link hook,
# and no library of it is in `deps`: linked, its hook keeps the tune; not
# linked, the program ships both of its sounds.
_JINGLE_DEPS = [
    "//sounds",
    "@pub_deps//:data_assets",
    "@pub_deps//:hooks",
]

dart_program_assets(
    name = "jingle_assets",
    package = "//jingle:pubspec-metadata",
    recorded_uses = "//jingle:app",
    deps = _JINGLE_DEPS,
)

in_rule_assets(
    name = "jingle_in_rule_assets",
    package = "//jingle:pubspec-metadata",
    recorded_uses = "//jingle:app",
    deps = _JINGLE_DEPS,
)

dart_program_assets(
    name = "jingle_unlinked_assets",
    package = "//jingle:pubspec-metadata",
    deps = _JINGLE_DEPS,
)

[
    dart_test(
        name = name + "_test",
        size = "small",
        args = [
            "'$(rlocationpaths :%s)'" % name,
            "package:jingle/tune.txt=tune",
            "package:sounds/chime.txt=ding",
        ],
        data = [":" + name],
        main = "assets_test.dart",
        deps = ["@rules_dart//dart/runfiles"],
    )
    for name in [
        "jingle_assets",
        "jingle_in_rule_assets",
    ]
]

dart_test(
    name = "jingle_unlinked_assets_test",
    size = "small",
    args = [
        "'$(rlocationpaths :jingle_unlinked_assets)'",
        "package:jingle/hum.txt=hum",
        "package:jingle/tune.txt=tune",
        "package:sounds/bell.txt=dong",
        "package:sounds/chime.txt=ding",
    ],
    data = [":jingle_unlinked_assets"],
    main = "assets_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)

# Expected to fail: `glyphs`' hook refuses a Glyph built at run time. Tagged
# manual so `//...` stays green; CI's expected-failure job builds it and checks
# the hook's message reaches the user.
dart_binary(
    name = "dynamic_app",
    main = "dynamic_app.dart",
    record_use = True,
    tags = ["manual"],
    deps = ["//glyphs"],
)

dart_program_assets(
    name = "dynamic_app_assets",
    recorded_uses = ":dynamic_app",
    tags = ["manual"],
    deps = ["//glyphs"],
)

# Expected to fail: `faults`' hook does what the recorded uses of each JSON
# file ask, each against one check of what a hook emits. Tagged manual so
# `//...` stays green; CI's expected-failure job builds each and checks its
# message.
[
    dart_program_assets(
        name = "faults_" + fault,
        recorded_uses = "//faults:uses/%s.json" % fault,
        tags = ["manual"],
        deps = ["//faults"],
    )
    for fault in [
        "foreign",
        "twice",
        "escape",
        "unpromised",
        "route",
    ]
]

# Expected to fail: `trim`'s tool writes a symbol name with a space in it.
# Tagged manual; CI's expected-failure job builds it.
dart_program_assets(
    name = "trim_bad_assets",
    recorded_uses = "//trim:uses/bad.json",
    tags = ["manual"],
    deps = ["//trim"],
)

# Expected to fail: `pick`'s hook emits a library it built rather than one its
# package declares. Tagged manual; CI's expected-failure job builds it.
dart_program_assets(
    name = "pick_built_assets",
    recorded_uses = "//pick:uses/built.json",
    tags = ["manual"],
    deps = ["//pick"],
)

# Expected to fail: the hook imports a file of its package that no target
# declares. `no-sandbox` runs it where the file is on disk, so only the
# package's assembled directory keeps the hook from reading it. Tagged manual
# so `//...` stays green; CI's expected-failure job builds it.
dart_program_assets(
    name = "undeclared_assets",
    recorded_uses = "recorded_uses.json",
    tags = [
        "manual",
        "no-sandbox",
    ],
    deps = ["//undeclared"],
)

dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@very_good_analysis"],
)

dart_analysis_config(
    name = "analysis_config",
    options = [":options"],
)
