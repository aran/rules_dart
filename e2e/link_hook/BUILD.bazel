load("@rules_dart//dart:defs.bzl", "dart_analysis_config", "dart_analysis_options", "dart_binary", "dart_link_hook", "dart_test")
load(":in_rule.bzl", "in_rule_assets", "unlinked_assets")

exports_files(["pubspec.lock"])

_INDEX = ["package:glyphs/glyphs/index.json"]

# Each binary records the uses of `@RecordUse` classes; each `dart_link_hook`
# runs `glyphs`' hook/link.dart over them and declares the one data asset it
# emits.

# AOT modes: the compiler writes the recorded uses beside the executable.
dart_binary(
    name = "app",
    main = "app.dart",
    record_use = True,
    deps = ["//glyphs"],
)

dart_link_hook(
    name = "app_assets",
    data_assets = _INDEX,
    recorded_uses = ":app",
    deps = ["//glyphs"],
)

dart_binary(
    name = "app_aot",
    compile_mode = "aot-snapshot",
    main = "app.dart",
    record_use = True,
    deps = ["//glyphs"],
)

dart_link_hook(
    name = "app_aot_assets",
    data_assets = _INDEX,
    recorded_uses = ":app_aot",
    deps = ["//glyphs"],
)

# A kernel is not tree-shaken, so nothing is recorded: the hook sees no uses.
dart_binary(
    name = "app_kernel",
    compile_mode = "kernel",
    main = "app.dart",
    record_use = True,
    deps = ["//glyphs"],
)

dart_link_hook(
    name = "app_kernel_assets",
    data_assets = _INDEX,
    recorded_uses = ":app_kernel",
    deps = ["//glyphs"],
)

# Recorded uses from anywhere, as a plain JSON file.
dart_link_hook(
    name = "file_assets",
    data_assets = _INDEX,
    recorded_uses = "recorded_uses.json",
    deps = ["//glyphs"],
)

# A hook whose package has a part written by a generator: the package is split
# between the source tree and `bazel-out`, and the hook runs from one assembled
# directory holding both.
dart_link_hook(
    name = "generated_assets",
    data_assets = ["package:generated_hook/generated_hook/names.json"],
    recorded_uses = "recorded_uses.json",
    deps = ["//generated"],
)

# A hook of a package in an external repository, whose imports come from the
# rest of this closure.
dart_link_hook(
    name = "external_assets",
    data_assets = ["package:ext_hook/ext_hook/names.json"],
    recorded_uses = "recorded_uses.json",
    deps = [
        "@ext_hook",
        "@pub_deps//:data_assets",
        "@pub_deps//:hooks",
    ],
)

# The same hooks run from inside another rule's implementation.
in_rule_assets(
    name = "in_rule_assets",
    data_assets = _INDEX,
    recorded_uses = ":app",
    deps = ["//glyphs"],
)

dart_test(
    name = "index_test",
    size = "small",
    args = [
        "$(rlocationpath :app_assets)",
        "heart,star",
        "$(rlocationpath :app_aot_assets)",
        "heart,star",
        "$(rlocationpath :app_kernel_assets)",
        "(none)",
        "$(rlocationpath :file_assets)",
        "moon",
        "$(rlocationpath :in_rule_assets)",
        "heart,star",
        "$(rlocationpath :generated_assets)",
        "alpha,beta",
        "$(rlocationpath :external_assets)",
        "external",
    ],
    data = [
        ":app_aot_assets",
        ":app_assets",
        ":app_kernel_assets",
        ":external_assets",
        ":file_assets",
        ":generated_assets",
        ":in_rule_assets",
    ],
    main = "index_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)

# Declared data assets. `sounds` declares what its build hook emits and has a
# link hook, which receives them and keeps the sounds the program uses;
# `banner` declares one and has no link hook, so it ships as it is.
dart_binary(
    name = "sounds_app",
    main = "sounds_app.dart",
    record_use = True,
    deps = [
        "//banner",
        "//sounds",
    ],
)

dart_link_hook(
    name = "sounds_app_assets",
    data_assets = ["package:sounds/chime.txt"],
    recorded_uses = ":sounds_app",
    deps = [
        "//banner",
        "//sounds",
    ],
)

# Not linked, a program ships every declared asset.
unlinked_assets(
    name = "sounds_app_unlinked_assets",
    deps = [
        "//banner",
        "//sounds",
    ],
)

dart_test(
    name = "linked_assets_test",
    size = "small",
    args = [
        "'$(rlocationpaths :sounds_app_assets)'",
        "banner.txt=welcome",
        "chime.txt=ding",
    ],
    data = [":sounds_app_assets"],
    main = "assets_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)

dart_test(
    name = "unlinked_assets_test",
    size = "small",
    args = [
        "'$(rlocationpaths :sounds_app_unlinked_assets)'",
        "banner.txt=welcome",
        "bell.txt=dong",
        "chime.txt=ding",
    ],
    data = [":sounds_app_unlinked_assets"],
    main = "assets_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)

# The program's own package, `jingle`, declares data assets and a link hook,
# and no library of it is in `deps`: linked, its hook keeps the tune; not
# linked, the program ships both of its sounds.
_JINGLE_DEPS = [
    "//sounds",
    "@pub_deps//:data_assets",
    "@pub_deps//:hooks",
]

dart_link_hook(
    name = "jingle_assets",
    data_assets = [
        "package:jingle/tune.txt",
        "package:sounds/chime.txt",
    ],
    package = "//jingle:pubspec-metadata",
    recorded_uses = "//jingle:app",
    deps = _JINGLE_DEPS,
)

in_rule_assets(
    name = "jingle_in_rule_assets",
    data_assets = [
        "package:jingle/tune.txt",
        "package:sounds/chime.txt",
    ],
    package = "//jingle:pubspec-metadata",
    recorded_uses = "//jingle:app",
    deps = _JINGLE_DEPS,
)

unlinked_assets(
    name = "jingle_unlinked_assets",
    package = "//jingle:pubspec-metadata",
    deps = _JINGLE_DEPS,
)

[
    dart_test(
        name = name + "_test",
        size = "small",
        args = [
            "'$(rlocationpaths :%s)'" % name,
            "chime.txt=ding",
            "tune.txt=tune",
        ],
        data = [":" + name],
        main = "assets_test.dart",
        deps = ["@rules_dart//dart/runfiles"],
    )
    for name in [
        "jingle_assets",
        "jingle_in_rule_assets",
    ]
]

dart_test(
    name = "jingle_unlinked_assets_test",
    size = "small",
    args = [
        "'$(rlocationpaths :jingle_unlinked_assets)'",
        "bell.txt=dong",
        "chime.txt=ding",
        "hum.txt=hum",
        "tune.txt=tune",
    ],
    data = [":jingle_unlinked_assets"],
    main = "assets_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)

# Expected to fail: `glyphs`' hook refuses a Glyph built at run time. Tagged
# manual so `//...` stays green; CI's expected-failure job builds it and checks
# the hook's message reaches the user.
dart_binary(
    name = "dynamic_app",
    main = "dynamic_app.dart",
    record_use = True,
    tags = ["manual"],
    deps = ["//glyphs"],
)

dart_link_hook(
    name = "dynamic_app_assets",
    data_assets = _INDEX,
    recorded_uses = ":dynamic_app",
    tags = ["manual"],
    deps = ["//glyphs"],
)

# Expected to fail: the hook imports a file of its package that no target
# declares. `no-sandbox` runs it where the file is on disk, so only the
# package's assembled directory keeps the hook from reading it. Tagged manual
# so `//...` stays green; CI's expected-failure job builds it.
dart_link_hook(
    name = "undeclared_assets",
    data_assets = ["package:undeclared_hook/undeclared_hook/extra.json"],
    recorded_uses = "recorded_uses.json",
    tags = [
        "manual",
        "no-sandbox",
    ],
    deps = ["//undeclared"],
)

dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@very_good_analysis"],
)

dart_analysis_config(
    name = "analysis_config",
    options = [":options"],
)
