load("@rules_dart//dart:defs.bzl", "dart_library", "dart_package_metadata")

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "undeclared_hook",
    link_hook = "hook/link.dart",
    link_hook_assets = ["package:undeclared_hook/undeclared_hook/extra.json"],
)

# A package whose hook imports `lib/extra.dart`, which is in the package's
# directory but in no target's `srcs`. Bazel declared nothing for it, so the
# hook must not find it.
dart_library(
    name = "undeclared",
    srcs = ["lib/undeclared_hook.dart"],
    package = ":pubspec-metadata",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        "@pub_deps//:data_assets",
        "@pub_deps//:hooks",
    ],
)
