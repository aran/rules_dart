module(name = "pub_lock_resolve_invalid_e2e")

bazel_dep(name = "rules_dart", version = "0.0.0")
bazel_dep(name = "platforms", version = "1.1.0")

local_path_override(
    module_name = "rules_dart",
    path = "../../..",
)

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.7")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")

# THIS WORKSPACE MUST FAIL TO RESOLVE (CI's expected-failure job checks it):
# the lock's `path` package `models` is named nowhere, `utils` is named twice,
# `resolve` maps `http`, which the lock does not list, and
# `build_from_pubspec` names `path`, which the lock lists as hosted, `far`,
# which the lock names by an absolute path, and `outside`, whose directory is
# outside the workspace.
pub = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub")
pub.from_lock(
    name = "pub",
    build_from_pubspec = [
        "far",
        "outside",
        "path",
        "utils",
    ],
    ignored = {"utils": "only the editor reads it"},
    lock = "//:pubspec.lock",
    resolve = {"http": "//http"},
)
use_repo(pub, "pub")
