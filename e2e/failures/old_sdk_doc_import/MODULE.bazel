# The analyzer of Dart 3.13 ignores a doc import read from a summary, so it calls
# a reference through one out of scope. The analysis fails, and must say that
# the diagnostic is false. CI's expected-failure job builds `//doc`.
module(name = "old_sdk_doc_import_e2e")

bazel_dep(name = "rules_dart", version = "0.0.0")
local_path_override(
    module_name = "rules_dart",
    path = "../../..",
)

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.use_sdk(name = "old")
dart.release(
    name = "old",
    dart_version = "3.13.0",
    sdk_sha256 = {
        "linux-arm64": "20141a0653327939bb20c4b87b231226beba1128d8a9aedbb30cb5af1a2790d4",
        "linux-x64": "87902573facd8acacac7ee1fe73fa8d0668e06065016068e2ed6c5c99c6b1ee0",
        "macos-arm64": "1812d602aed0a9cf7281c93f514a1e1aecf60dc345c4337dba4ff28fa8d398ca",
        "macos-x64": "6f75f0d6bc10c00457fb5b8861b26eadc5d883cfd11aa26a8c4f6353af370f47",
        "windows-x64": "8480a527e621e9b06f1121cb4f56204e5c2b07851021cbe63965399de4d7f407",
    },
    source_sha256 = "89a06c61c4fd29dccae6ba48e86141dc94b867cb1c0ec021175dddc0720a0747",
)
