module(name = "no_pubspec_e2e")

bazel_dep(name = "rules_dart", version = "0.0.0")
local_path_override(
    module_name = "rules_dart",
    path = "../..",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.7")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")

# Pub packages without a pubspec: each is pinned here, where Bazel pins any
# other archive, rather than resolved from a pubspec into a lock.
pub = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub")
pub.package(
    name = "json_annotation",
    sha256 = "2a743920d81b7910627f68ee2c9ac1fc0bfee32b9fc3403587d7c6791ca12f80",
    version = "4.12.0",
    # What its archive's pubspec depends on, restated: `pub.package()` takes a
    # package's dependencies from `deps` only.
    deps = ["meta"],
)
pub.package(
    name = "meta",
    sha256 = "307249ce4ff29d58a18e97f6345f539382eb9c9c29ecda628900f31de0443dd9",
    version = "1.19.0",
)
use_repo(pub, "json_annotation", "meta")
