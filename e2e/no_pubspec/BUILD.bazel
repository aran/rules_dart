load("@rules_dart//dart:defs.bzl", "dart_analysis_config", "dart_analysis_options", "dart_test")

# A workspace with no `pubspec.yaml` anywhere: every fact a pubspec would state
# is stated on targets. Package names and language versions are on
# `dart_library` or a `dart_package_metadata`, dependencies are `deps`, pub
# packages are `pub.package()` pins, executables are `dart_binary` targets.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
)

dart_analysis_config(
    name = "analysis_config",
    options = [":options"],
)

# The premise of the workspace. It reads the source tree through the
# MODULE.bazel symlink, so it runs locally, where that leads to the tree, and
# is never cached: a new pubspec is not one of its inputs.
dart_test(
    name = "no_pubspec_test",
    size = "small",
    args = ["$(rlocationpath MODULE.bazel)"],
    data = ["MODULE.bazel"],
    main = "check/no_pubspec_test.dart",
    tags = [
        "external",
        "local",
        "no-remote",
    ],
    deps = ["@rules_dart//dart/runfiles"],
)
