load(
    "@rules_dart//dart:defs.bzl",
    "dart_codegen",
    "dart_library",
    "dart_test",
)
load(
    "@rules_dart//dart/ext/json_serializable:defs.bzl",
    "json_serializable_library",
)

# Comprehensive e2e for json_serializable. Demonstrates:
#
#   - Hand-wired primitives form (:primitive_user via dart_codegen +
#     combining), showing the plumbing the macro hides.
#   - Cross-file Resolver walking (:cross_user depends on :base, which
#     exposes the sibling type through DartInfo for auto-staging).
#   - Full annotation surface via `json_serializable_library` macro
#     (:advanced) — FieldRename.snake, @JsonKey(name:/toJson:/fromJson:),
#     @JsonConverter, @JsonEnum, genericArgumentFactories.

# --- Primitives-form demonstration (replaces the old single_shared_part). ---
dart_codegen(
    name = "_primitive_user_json_part",
    package_name = "json_serializable_fixture",
    src = "lib/primitive_user.dart",
    generator_bin = "@rules_dart//dart/ext/json_serializable:shim",
    language_version = "3.11",
    output_suffixes = [".json_serializable.g.part"],
    deps = ["@pub_deps//:json_annotation"],
)

dart_codegen(
    name = "_primitive_user_combined",
    package_name = "json_serializable_fixture",
    src = "lib/primitive_user.dart",
    generator_bin = "@rules_dart//dart/ext/_shared/combining_shim:bin",
    language_version = "3.11",
    output_suffixes = [".g.dart"],
    parts = [":_primitive_user_json_part"],
)

# --- Cross-file Resolver (:base is the sibling exposed through deps). ---
dart_library(
    name = "base",
    package_name = "json_serializable_fixture",
    srcs = ["lib/base.dart"],
    language_version = "3.11",
)

# NOTE: deliberately omits language_version — Gazelle only emits the attr
# when one is derivable (directive or pubspec), so the macro must tolerate
# its absence (the rule layer applies a safe default).
json_serializable_library(
    name = "cross_user_lib",
    package_name = "json_serializable_fixture",
    srcs = ["lib/cross_user.dart"],
    deps = [":base"],
)

# --- Advanced annotations via the macro. ---
# user.dart references role.dart and custom_id.dart; each file's generator
# sees its siblings through the macro.
json_serializable_library(
    name = "advanced",
    package_name = "json_serializable_fixture",
    srcs = [
        "lib/custom_id.dart",
        "lib/role.dart",
        "lib/user.dart",
        "lib/wrapper.dart",
    ],
    language_version = "3.11",
    deps = ["@pub_deps//:meta"],
)

# Aggregate library used by tests — pulls in every flavor.
dart_library(
    name = "json_serializable_fixture",
    package_name = "json_serializable_fixture",
    srcs = [
        "lib/primitive_user.dart",
        ":_primitive_user_combined",
    ],
    language_version = "3.11",
    visibility = ["//visibility:public"],
    deps = [
        ":advanced",
        ":base",
        ":cross_user_lib",
        "@pub_deps//:json_annotation",
    ],
)

dart_test(
    name = "primitive_user_test",
    size = "small",
    main = "test/primitive_user_test.dart",
    deps = [
        ":json_serializable_fixture",
        "@pub_deps//:test",
    ],
)

dart_test(
    name = "cross_file_test",
    size = "small",
    main = "test/cross_file_test.dart",
    deps = [
        ":json_serializable_fixture",
        "@pub_deps//:test",
    ],
)

dart_test(
    name = "user_test",
    size = "small",
    main = "test/user_test.dart",
    deps = [
        ":json_serializable_fixture",
        "@pub_deps//:test",
    ],
)

dart_test(
    name = "wrapper_test",
    size = "small",
    main = "test/wrapper_test.dart",
    deps = [
        ":json_serializable_fixture",
        "@pub_deps//:test",
    ],
)
