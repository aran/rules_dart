# Comprehensive e2e for the mockito builder:
#  - api.dart + api_test.dart — @GenerateMocks over a cross-file interface
#  - clock.dart + nice_mock_test.dart — @GenerateNiceMocks with both a
#    default MockSpec and MockSpec(as: #Name, onMissingStub: returnDefault)
#
# mockito codegen runs on the TEST file (the annotation lives there) and
# needs the mocked interface visible at analysis time: the package's
# library, which the test imports, goes in `deps`.

load(
    "@rules_dart//dart:defs.bzl",
    "dart_library",
    "dart_package_metadata",
    "dart_test",
)
load("@rules_dart//dart/ext/mockito:defs.bzl", "mockito_codegen")

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "mockito_fixture",
    language_version = "3.11",
)

dart_library(
    name = "mockito_fixture",
    srcs = [
        "lib/api.dart",
        "lib/clock.dart",
    ],
    package = ":pubspec-metadata",
    visibility = ["//visibility:public"],
)

mockito_codegen(
    name = "api_test_mocks",
    testonly = True,
    srcs = ["test/api_test.dart"],
    package = ":pubspec-metadata",
    deps = [":mockito_fixture"],
)

mockito_codegen(
    name = "nice_mock_test_mocks",
    testonly = True,
    srcs = ["test/nice_mock_test.dart"],
    package = ":pubspec-metadata",
    deps = [":mockito_fixture"],
)

dart_test(
    name = "api_test",
    size = "small",
    srcs = [":api_test_mocks"],
    main = "test/api_test.dart",
    deps = [
        ":mockito_fixture",
        "@pub_deps//:mockito",
        "@pub_deps//:test",
    ],
)

dart_test(
    name = "nice_mock_test",
    size = "small",
    srcs = [":nice_mock_test_mocks"],
    main = "test/nice_mock_test.dart",
    deps = [
        ":mockito_fixture",
        "@pub_deps//:mockito",
        "@pub_deps//:test",
    ],
)
