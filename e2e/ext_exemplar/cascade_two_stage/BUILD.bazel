# Cascade: freezed → json_serializable → combining. The second builder
# reads the first's generated `.freezed.dart` via the resolver, staged as a
# plain file (`asset_deps`): no library can hold `event.dart` before its
# `.g.dart` part exists.

load(
    "@rules_dart//dart:defs.bzl",
    "dart_codegen",
    "dart_library",
    "dart_package_metadata",
    "dart_test",
)

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "cascade_two_stage",
)

_ANN_DEPS = [
    "@pub_deps//:freezed_annotation",
    "@pub_deps//:json_annotation",
]

dart_codegen(
    name = "_event_freezed",
    src = "lib/event.dart",
    generator = "@rules_dart//dart/ext/freezed:shim",
    output_suffixes = [".freezed.dart"],
    package = ":pubspec-metadata",
    deps = _ANN_DEPS,
)

dart_codegen(
    name = "_event_json_part",
    src = "lib/event.dart",
    asset_deps = [":_event_freezed"],
    generator = "@rules_dart//dart/ext/json_serializable:shim",
    output_suffixes = [".json_serializable.g.part"],
    package = ":pubspec-metadata",
    deps = _ANN_DEPS,
)

dart_codegen(
    name = "_event_combined",
    src = "lib/event.dart",
    generator = "@rules_dart//dart/ext/combining_shim:bin",
    output_suffixes = [".g.dart"],
    package = ":pubspec-metadata",
    parts = [":_event_json_part"],
)

dart_library(
    name = "cascade_two_stage",
    srcs = [
        "lib/event.dart",
        ":_event_combined",
        ":_event_freezed",
    ],
    package = ":pubspec-metadata",
    visibility = ["//visibility:public"],
    # `freezed_annotation` re-exports `json_annotation`.
    deps = ["@pub_deps//:freezed_annotation"],
)

dart_test(
    name = "event_test",
    size = "small",
    main = "test/event_test.dart",
    deps = [
        ":cascade_two_stage",
        "@pub_deps//:test",
    ],
)
