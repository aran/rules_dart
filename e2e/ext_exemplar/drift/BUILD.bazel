load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("@rules_dart//dart:defs.bzl", "dart_test")
load("@rules_dart//dart/ext/drift:defs.bzl", "drift_library")

# Comprehensive e2e for drift:
#  - .drift file include (todos + `AS Todo` data class + `allTodos` query)
#  - Dart-only tables (Users, Posts) with FK + TypeConverter + default
#  - @DriftAccessor DAO (PostsDao)
#  - Multi-table join in a .drift named query (postsByUser)
#
# drift_library handles the full 4-stage pipeline (prep + discover +
# analyzer + driftBuilder) plus combining per source.

drift_library(
    name = "drift_fixture",
    package_name = "drift_fixture",
    srcs = [
        "lib/database.dart",
        "lib/posts_dao.dart",
    ],
    drift_srcs = ["lib/database.drift"],
    language_version = "3.11",
    visibility = ["//visibility:public"],
)

# Hermetic libsqlite3 for the database_test: a Bazel-built shared library
# from the official SQLite C amalgamation (via the BCR sqlite3 module).
# The test DynamicLibrary.open()s it in setUpAll so package:sqlite3's
# process-lookup fallback finds the symbols (macOS happens to ship a
# usable libsqlite3; Linux/Windows runners do not have one on the Bazel
# sandbox's library search path).
cc_shared_library(
    name = "libsqlite3",
    shared_lib_name = select({
        "@platforms//os:macos": "libsqlite3.dylib",
        "@platforms//os:windows": "sqlite3.dll",
        "//conditions:default": "libsqlite3.so",
    }),
    deps = ["@sqlite3"],
)

dart_test(
    name = "database_test",
    data = [":libsqlite3"],
    main = "test/database_test.dart",
    deps = [
        ":drift_fixture",
        "@pub_deps//:drift",
        "@pub_deps//:test",
        "@rules_dart//dart/runfiles",
    ],
)
