module(name = "ext_exemplar_e2e")

bazel_dep(name = "rules_dart", version = "0.0.0")
local_path_override(
    module_name = "rules_dart",
    path = "../..",
)

# Gazelle plugin support so users can `bazel run //:gazelle` to regenerate
# BUILD files from annotated sources.
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "rules_go", version = "0.64.2")

# SQLite native lib for the drift exemplar's database_test: drift's
# NativeDatabase calls into package:sqlite3 which dlopen's libsqlite3 at
# runtime. The Bazel sandbox has no system libsqlite3 on Linux/Windows, so
# we build sqlite3 from its C amalgamation (via the BCR sqlite3 module),
# wrap it in cc_shared_library for a loadable .so/.dylib/.dll, and bind
# it into the test via package:sqlite3's open override. rules_cc is needed
# for the cc_shared_library load.
bazel_dep(name = "sqlite3", version = "3.53.4")
bazel_dep(name = "rules_cc", version = "0.2.26")

# On macOS, rules_cc leaves C++ to apple_support's toolchain. 2.9.0 builds that
# toolchain's helper tools for macOS 11, the oldest Xcode 27's libc++ accepts
# without a warning.
bazel_dep(name = "apple_support", version = "2.10.1")
bazel_dep(name = "platforms", version = "1.1.0")

bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0", dev_dependency = True)

cc_toolchains = use_extension(
    "@hermetic_cc_toolchain//toolchain:ext.bzl",
    "toolchains",
    dev_dependency = True,
)
use_repo(cc_toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.28",
    "@zig_sdk//toolchain:linux_arm64_gnu.2.28",
    dev_dependency = True,
)

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.5")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")

pub = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub")
pub.from_lock(
    name = "pub_deps",
    lock = "//:pubspec.lock",
    # This lock shares packages with rules_dart's own tool lock, which can be
    # newer for some of them; there is one version per package, so take its.
    on_version_conflict = "upgrade",
)

# Lint ruleset for the analyze aspect. Declared as its own spoke rather than
# added to pubspec.yaml: it is never imported by any source here, and putting
# it in the lock would make it a runtime dep of every `pub_deps` consumer.
pub.package(
    name = "very_good_analysis",
    sha256 = "0bd5eb8d6be76aa0d71e70cbdae6cac8f784f761170568e3c2214a6948c7f6d3",
    version = "11.0.0",
)
use_repo(pub, "pub_deps", "very_good_analysis")
