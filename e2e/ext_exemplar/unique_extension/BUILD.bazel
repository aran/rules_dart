# Non-SharedPart builder emitting a unique output extension; no combining.

load("@rules_dart//dart:defs.bzl", "dart_codegen", "dart_library", "dart_test")

dart_codegen(
    name = "_event_freezed_gen",
    package_name = "unique_extension",
    src = "lib/event.dart",
    generator_bin = "@rules_dart//dart/ext/freezed:shim",
    language_version = "3.11",
    output_suffixes = [".freezed.dart"],
    deps = ["@pub_deps//:freezed_annotation"],
)

dart_library(
    name = "unique_extension",
    srcs = [
        "lib/event.dart",
        ":_event_freezed_gen",
    ],
    visibility = ["//visibility:public"],
    deps = ["@pub_deps//:freezed_annotation"],
)

dart_test(
    name = "event_test",
    size = "small",
    main = "test/event_test.dart",
    deps = [
        ":unique_extension",
        "@pub_deps//:test",
    ],
)
