load("@rules_dart//dart:defs.bzl", "dart_analysis_options", "dart_analyze_test", "dart_binary")

exports_files([
    "lock_a.lock",
    "lock_b.lock",
])

# lock_b has path 1.9.0 with on_version_conflict = "upgrade", so it
# accepts lock_a's higher version (1.9.1). Both hubs should work.
dart_binary(
    name = "app",
    main = "main.dart",
    deps = [
        "@deps_a//:path",
        "@deps_b//:collection",
    ],
)

# The ruleset is a dep of the options file, not of `app`: a lint ruleset is not
# a dependency of the code it lints, and listing it in `app`'s deps would carry
# it into the `DartInfo` of everything downstream.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@very_good_analysis"],
)

dart_analyze_test(
    name = "analyze_app",
    size = "small",
    options = ":options",
    target = ":app",
)
