module(name = "pub_lock_upgrade_e2e")

bazel_dep(name = "rules_dart", version = "0.0.0")
bazel_dep(name = "platforms", version = "1.1.0")

local_path_override(
    module_name = "rules_dart",
    path = "../..",
)

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.7")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")

pub = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub")
pub.from_lock(
    name = "deps_a",
    lock = "//:lock_a.lock",
)
pub.from_lock(
    name = "deps_b",
    lock = "//:lock_b.lock",
    on_version_conflict = "upgrade",
)

# Newer than rules_dart's own tool lock for a shared package (get_it), with the
# default `on_version_conflict`: rules_dart's lock must be the one that yields.
pub.from_lock(
    name = "deps_newer",
    lock = "//:lock_newer.lock",
)

# The lint ruleset is declared explicitly rather than through either lock, so
# it stays outside the conflict resolution this fixture exercises.
pub.package(
    name = "very_good_analysis",
    sha256 = "0bd5eb8d6be76aa0d71e70cbdae6cac8f784f761170568e3c2214a6948c7f6d3",
    version = "11.0.0",
)
use_repo(pub, "deps_a", "deps_b", "deps_newer", "very_good_analysis")
