load("@rules_dart//dart:defs.bzl", "dart_analyze_test", "dart_format_test", "dart_library")

dart_library(
    name = "mylib",
    srcs = glob(["lib/**/*.dart"]),
    visibility = ["//visibility:public"],
)

dart_analyze_test(
    name = "analyze_test",
    size = "small",
    target = ":mylib",
)

# The same library under `package:very_good_analysis`, via the options target in
# the root package. Proves a `dart_analysis_options` is reusable across
# packages: the ruleset it carries resolves against whichever target is being
# analyzed, not against the package that declared it.
dart_analyze_test(
    name = "analyze_vga",
    size = "small",
    options = "//:vga",
    target = ":mylib",
)

dart_format_test(
    name = "format_test",
    size = "small",
    srcs = glob(["lib/**/*.dart"]),
)
