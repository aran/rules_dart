load("@rules_dart//dart:defs.bzl", "dart_analyze_test", "dart_format_test", "dart_library")

dart_library(
    name = "good_lib",
    srcs = glob(["lib/**/*.dart"]),
    deps = [
        "//mylib",
        "@very_good_analysis",
    ],
)

dart_analyze_test(
    name = "analyze",
    size = "small",
    lib = ":good_lib",
)

# Same library analyzed with stricter custom options.
dart_analyze_test(
    name = "analyze_strict",
    size = "small",
    lib = ":good_lib",
    options = "analysis_options.yaml",
)

dart_format_test(
    name = "format_test",
    size = "small",
    srcs = glob(["lib/**/*.dart"]),
)

# The same library under `package:very_good_analysis`. Covers two things the
# rule set has to get right for any published ruleset: a pub spoke has to carry
# the non-Dart files it ships in `lib/` (the ruleset is a yaml), and the
# synthesized pubspec has to be valid enough that lints blame the code rather
# than the staging.
dart_analyze_test(
    name = "analyze_vga",
    size = "small",
    lib = ":good_lib",
    options = "vga_options.yaml",
)
