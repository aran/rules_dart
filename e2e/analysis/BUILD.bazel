load("@rules_dart//dart:defs.bzl", "dart_analysis_options", "dart_analyze_test", "dart_format_test", "dart_library")

dart_library(
    name = "good_lib",
    srcs = glob(["lib/**/*.dart"]),
    deps = ["//mylib"],
)

dart_analyze_test(
    name = "analyze",
    size = "small",
    target = ":good_lib",
)

# Same library analyzed with stricter custom options.
dart_analyze_test(
    name = "analyze_strict",
    size = "small",
    options = "analysis_options.yaml",
    target = ":good_lib",
)

dart_format_test(
    name = "format_test",
    size = "small",
    srcs = glob(["lib/**/*.dart"]),
)

# The same library under `package:very_good_analysis`. Covers two things the
# rule set has to get right for any published ruleset: a pub spoke has to carry
# the non-Dart files it ships in `lib/` (the ruleset is a yaml), and the
# synthesized pubspec has to be valid enough that lints blame the code rather
# than the staging.
dart_analyze_test(
    name = "analyze_vga",
    size = "small",
    options = ":vga",
    target = ":good_lib",
)

# The ruleset is a pub package whose yaml the options file includes by
# `package:` URI. Naming it here rather than in `good_lib`'s deps is the point:
# a lint ruleset is not a dependency of the code it lints, and listing it there
# would carry it into the `DartInfo` of every binary and test downstream.
dart_analysis_options(
    name = "vga",
    src = "vga_options.yaml",
    # Shared with every package that lints so the workspace has one canonical
    # ruleset target rather than a duplicate declaration in each of them.
    visibility = [
        "//exec_pkg:__pkg__",
        "//mylib:__pkg__",
    ],
    deps = ["@very_good_analysis"],
)

# `options` honoured directly: the source is formatted for a 100-column page,
# so it is stable under these options and would be rewritten at the stock 80.
# A green here means the formatter: section reached the check.
dart_format_test(
    name = "format_options",
    size = "small",
    srcs = ["wide/lib/wide.dart"],
    options = "wide/wide_options.yaml",
)

# The same source and the same width, reached through an `include:` by
# `package:` URI instead. Pins the whole chain: the options target's `deps`
# become package_config entries in the staged project, which is what lets the
# formatter resolve the URI and apply the width it finds.
dart_format_test(
    name = "format_pkg_include",
    size = "small",
    srcs = ["wide/lib/wide.dart"],
    options = ":pkg_include_options",
)

dart_analysis_options(
    name = "pkg_include_options",
    src = "pkg_include_options.yaml",
    deps = ["//fmt_ruleset"],
)
