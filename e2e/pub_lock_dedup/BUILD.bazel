load("@rules_dart//dart:defs.bzl", "dart_analysis_config", "dart_analysis_options", "dart_test")

# Packages that several locks list are built once: `//two_hubs` reads two locks
# in this module, `//cross_module` locks of other modules, one of them with a
# hub of the same name as this module's.

# The ruleset hangs off the options target, never off a binary's deps, so a
# lint-only package stays out of the binaries' `DartInfo` and out of the dedup
# this workspace exercises.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@very_good_analysis"],
)

dart_analysis_config(
    name = "analysis_config",
    options = [":options"],
)

# Both apps run, and print what each of their packages must produce.
dart_test(
    name = "apps_test",
    size = "small",
    args = [
        "$(rlocationpath //cross_module:app)",
        "$(rlocationpath //two_hubs:app)",
    ],
    data = [
        "//cross_module:app",
        "//two_hubs:app",
    ],
    main = "test/apps_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)
