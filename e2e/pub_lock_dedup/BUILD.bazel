load("@rules_dart//dart:defs.bzl", "dart_analysis_options", "dart_analyze_test", "dart_binary")

exports_files([
    "lock_a.lock",
    "lock_b.lock",
])

# Uses deps from both hubs to verify deduplication works.
# Both lock files have identical versions, so no conflict.
dart_binary(
    name = "app",
    main = "main.dart",
    deps = [
        "@deps_a//:path",
        "@deps_b//:collection",
    ],
)

# The ruleset hangs off the options target, never off `app`'s deps, so a
# lint-only package stays out of the binary's `DartInfo` and out of the
# two-hub dedup this module exercises.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@very_good_analysis"],
)

dart_analyze_test(
    name = "analyze_app",
    size = "small",
    options = ":options",
    target = ":app",
)
