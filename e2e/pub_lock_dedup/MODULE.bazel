module(name = "pub_lock_dedup_e2e")

bazel_dep(name = "rules_dart", version = "0.0.0")
bazel_dep(name = "platforms", version = "1.1.0")

local_path_override(
    module_name = "rules_dart",
    path = "../..",
)

# `//cross_module`'s dependency modules, each with a pub hub of its own.
bazel_dep(name = "module_b", version = "0.0.0")
local_path_override(
    module_name = "module_b",
    path = "cross_module/module_b",
)

# `module_c` names its pub hub `deps_a`, the same name this module uses, over
# a different lock. See its MODULE.bazel.
bazel_dep(name = "module_c", version = "0.0.0")
local_path_override(
    module_name = "module_c",
    path = "cross_module/module_c",
)

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.7")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")

pub = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub")

# `//two_hubs`: two hubs of this module over locks of the same packages, at
# the same versions.
pub.from_lock(
    name = "two_hubs_a",
    lock = "//two_hubs:lock_a.lock",
)
pub.from_lock(
    name = "two_hubs_b",
    lock = "//two_hubs:lock_b.lock",
)

# `//cross_module`: a hub whose name `module_c` uses too.
pub.from_lock(
    name = "deps_a",
    lock = "//cross_module:lock_a.lock",
)

# A standalone spoke on the same extension, named explicitly rather than
# through a lock. It appears in no lock, so it cannot shadow a lock entry and
# leaves the dedup this module exercises untouched.
pub.package(
    name = "very_good_analysis",
    sha256 = "0bd5eb8d6be76aa0d71e70cbdae6cac8f784f761170568e3c2214a6948c7f6d3",
    version = "11.0.0",
)
use_repo(pub, "deps_a", "two_hubs_a", "two_hubs_b", "very_good_analysis")
