load("@rules_dart//dart:defs.bzl", "dart_library")

# Aggregate `dart_library` with no `srcs` of its own — exists only to
# re-export `//utils`. `dart/private/dart_library.bzl` blesses this pattern
# ("srcs may be empty: a dart_library with only deps is a valid aggregate
# façade that re-exports its dependencies").
#
# The package config of a `dart_binary` that depends on this has no entry for
# it: no consumer needs a `rootUri` when there are no sources to resolve under
# it. The aspect analyzes this sourceless library under
# `bazel test`, the same shape `dart analyze` reads through the package config.
dart_library(
    name = "facade",
    srcs = [],
    visibility = ["//visibility:public"],
    deps = ["//library_deps/utils"],
)
