# The client's GIT_* variables reach repository rules. These would relocate or
# reconfigure git, or are values git refuses outright; a git package (//git)
# must fetch the same bytes with them set. No other repository here runs git.
common --repo_env=GIT_DIR=/nonexistent/git-dir
common --repo_env=GIT_WORK_TREE=/nonexistent/work-tree
common --repo_env=GIT_INDEX_FILE=/nonexistent/index
common --repo_env=GIT_OBJECT_DIRECTORY=/nonexistent/objects
common "--repo_env=GIT_CONFIG_PARAMETERS='core.autocrlf'='true'"
common --repo_env=GIT_ATTR_SOURCE=

try-import %workspace%/.bazelrc.user
