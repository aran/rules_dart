load("@rules_dart//dart:defs.bzl", "dart_analysis_config", "dart_analysis_options", "dart_test")

exports_files(["pubspec.lock"])

dart_analysis_config(
    name = "analysis_config",
    options = [":options"],
)

# The ruleset is named here rather than in `example_test`'s deps: a lint ruleset
# is not a dependency of the code it lints, and listing it there would carry it
# into the `DartInfo` of every downstream consumer. Its `include:` resolves by
# `package:` URI against a project whose package_config covers only the pub hub.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@very_good_analysis"],
)

# The `main` is under `test/` rather than beside `lib/`, and its only import
# comes from a pub hub, so the aspect analyzing it shows the staged pub packages
# and synthesized pubspec are enough for an entrypoint too.
dart_test(
    name = "example_test",
    size = "small",
    main = "test/example_test.dart",
    deps = ["@pub_deps//:test"],
)
