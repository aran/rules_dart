load("@rules_dart//dart:defs.bzl", "dart_binary")

# `bazel run //coverage/check -- <report>`, after `bazel coverage
# --combined_report=lcov //coverage/...`.
dart_binary(
    name = "check",
    data = [
        "//coverage:lib/shapes.dart",
        "//coverage:test/plain_test.dart",
        "//coverage:test/runner_test.dart",
        "//coverage:test/support.dart",
        "//coverage/excluded:lib/excluded.dart",
        "//coverage/generated:write_generated",
        "//coverage/units:lib/units.dart",
    ],
    main = "check_report.dart",
    deps = ["@rules_dart//dart/runfiles"],
)
