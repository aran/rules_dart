module(name = "pub_lock_resolve_e2e")

bazel_dep(name = "rules_dart", version = "0.0.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

local_path_override(
    module_name = "rules_dart",
    path = "../..",
)

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.7")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")

pub = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub")

# The lock lists `shared_models` as a `path` package, which must be mapped, and
# `petitparser` as a hosted one, mapped here to a fork that `xml` must then
# get. Both are packages no other module in the build locks: a mapping replaces
# the package for every module, rules_dart's own tools included.
pub.from_lock(
    name = "pub",
    lock = "//:pubspec.lock",
    resolve = {
        "petitparser": "//third_party/petitparser",
        "shared_models": "//shared_models",
    },
)

# A mapping to a target that builds a different package, which analysis
# refuses (`//:wrong_package_refused`).
pub.from_lock(
    name = "bad",
    lock = "//bad:pubspec.lock",
    resolve = {"characters": "//not_characters"},
)
use_repo(pub, "bad", "pub")
