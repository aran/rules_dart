module(name = "pub_lock_git_e2e")

bazel_dep(name = "rules_dart", version = "0.0.0")
local_path_override(
    module_name = "rules_dart",
    path = "../..",
)

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.7")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")

# Git repositories made on the spot, beside the lock `dart pub get` writes for
# them: no network, and every commit id is the same on every machine.
git_fixture = use_repo_rule("//:git_fixture.bzl", "git_fixture")

git_fixture(name = "git_fixture")

pub = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub")
pub.from_lock(
    name = "deps",
    lock = "@git_fixture//:pubspec.lock",
)
use_repo(pub, "deps")
