load(
    "@rules_dart//dart:defs.bzl",
    "dart_analysis_config",
    "dart_analysis_options",
    "dart_js_binary",
    "dart_library",
    "dart_package_metadata",
    "dart_test",
    "dart_wasm_binary",
)

dart_package_metadata(
    name = "pubspec",
    package_name = "web_app",
)

dart_analysis_config(
    name = "analysis_config",
    options = [":options"],
)

# Root package (empty package_root): its lib/ sources must be staged for the web
# compile like any other dep package.
dart_library(
    name = "rootlib",
    srcs = ["lib/root_greet.dart"],
    package = ":pubspec",
    visibility = ["//visibility:public"],
)

# The web binaries carry the root-level `main.dart`/`config.dart`, which no
# `dart_library` owns; the aspect analyzing the binaries is what reaches them.
dart_js_binary(
    name = "app",
    srcs = ["config.dart"],
    # A define containing a space must survive intact (no shell splitting).
    defines = ["banner=hello world"],
    main = "main.dart",
    deps = [
        ":rootlib",
        "//greet",
        "@pub_deps//:characters",
    ],
)

dart_wasm_binary(
    name = "app_wasm",
    srcs = ["config.dart"],
    defines = ["banner=hello world"],
    main = "main.dart",
    deps = [
        ":rootlib",
        "//greet",
        "@pub_deps//:characters",
    ],
)

dart_test(
    name = "js_output_test",
    size = "small",
    data = [":app"],
    main = "test/js_output_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)

# The loader picked out by output group, as a genrule's `$(execpath)` would.
filegroup(
    name = "app_wasm_mjs",
    srcs = [":app_wasm"],
    output_group = "mjs",
)

dart_test(
    name = "wasm_output_test",
    size = "small",
    args = ["$(rlocationpath :app_wasm_mjs)"],
    data = [
        ":app_wasm",
        ":app_wasm_mjs",
    ],
    main = "test/wasm_output_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)

# The lint ruleset is a pub package the options file includes by `package:`
# URI. It belongs here rather than in any library's `deps`: naming it there
# would carry a lint-only package into the `DartInfo` of both web binaries.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@very_good_analysis"],
)
