load(
    "@rules_dart//dart:defs.bzl",
    "dart_analysis_config",
    "dart_binary",
    "dart_format_test",
    "dart_library",
)

# Every target in this workspace is expected to FAIL to build under
# `bazel test`, which applies the `dart_analyze` aspect (see `.bazelrc`). The
# expected-failure CI job builds each one and greps for its diagnostic, so each
# target fails with a diagnostic no other target shares.

dart_analysis_config(
    name = "analysis_config",
    options = [
        "//nested:loud_options",
        "//nested:options",
        "//unresolved_ruleset:options",
        "//vga:options",
    ],
)

# bad.dart carries an unused_local_variable diagnostic: the analyze action's
# error path (diagnostics must fail the build, not be swallowed by the runner),
# named at its workspace path. No options file governs it, so the SDK defaults
# apply.
dart_library(
    name = "bad_lib",
    srcs = ["lib/bad.dart"],
)

# The same guard for an entrypoint. A `dart_binary`'s `main` is under no `lib/`,
# so it is staged for analysis from `DartAnalyzableInfo` rather than from any
# package's sources — and a diagnostic in it must fail the build exactly as one
# in a library does. Without this, staging that quietly dropped the entrypoint
# would leave the analyzer reporting "No issues found" on a file it never read.
dart_binary(
    name = "bad_bin",
    main = "bad_main.dart",
)

# The format check's three red paths. A formatting violation must fail the
# build, and — the reason the other two exist — a *broken options file* must
# fail it too. `dart format` treats an unresolvable `include:` as a warning,
# exits 0, and silently formats at stock defaults, so without the runner's
# escalation a misconfigured ruleset and a correctly formatted codebase would
# look identical. That is the same silent-wrong-verdict the rule was rewritten
# to eliminate, so it gets the same red-path proof the analyzer's include has.
dart_format_test(
    name = "format_bad",
    srcs = ["fmt/misformatted.dart"],
)

dart_format_test(
    name = "format_unresolved_ruleset",
    srcs = ["lib/clean.dart"],
    options = "unresolved_format_options.yaml",
)

dart_format_test(
    name = "format_missing_include",
    srcs = ["lib/clean.dart"],
    options = "missing_include_options.yaml",
)
