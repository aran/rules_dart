load("@rules_dart//dart:defs.bzl", "dart_analysis_options", "dart_analyze_test", "dart_test")

# One options target for the whole workspace, including the two subpackages.
# The ruleset is named here rather than in any library's `deps` because a lint
# ruleset is not a dependency of the code it lints — listing it there would
# carry it into the `DartInfo` of every test below.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    visibility = ["//visibility:public"],
    deps = ["@very_good_analysis"],
)

dart_test(
    name = "mathlib_test",
    size = "small",
    main = "mathlib_test.dart",
    deps = ["//mathlib"],
)

# `dart_analyze_test` takes the executables directly: each test's `main` lives
# outside any package's `lib/`, so analyzing the libraries alone would leave
# every entrypoint in this workspace unanalyzed.
dart_analyze_test(
    name = "analyze_mathlib_test",
    size = "small",
    options = ":options",
    target = ":mathlib_test",
)

dart_test(
    name = "simple_test",
    size = "small",
    main = "test/simple_test.dart",
)

dart_analyze_test(
    name = "analyze_simple_test",
    size = "small",
    options = ":options",
    target = ":simple_test",
)

dart_test(
    name = "utils_test",
    size = "small",
    main = "test/utils_test.dart",
    deps = ["//utils"],
)

dart_analyze_test(
    name = "analyze_utils_test",
    size = "small",
    options = ":options",
    target = ":utils_test",
)

# Demonstrates the srcs attribute — test_helpers.dart is a local
# source file used by the test but not in a dart_library.
dart_test(
    name = "helpers_test",
    size = "small",
    srcs = ["test_helpers.dart"],
    main = "test/helpers_test.dart",
)

# `srcs` files are analyzed too, so this covers test_helpers.dart — which
# belongs to no package and is reachable only through this test.
dart_analyze_test(
    name = "analyze_helpers_test",
    size = "small",
    options = ":options",
    target = ":helpers_test",
)

# Asserts fire at runtime in every compilation mode — the runner always
# enables them on the VM. CI also runs this package under `-c dbg`.
dart_test(
    name = "asserts_test",
    size = "small",
    main = "test/asserts_test.dart",
)

dart_analyze_test(
    name = "analyze_asserts_test",
    size = "small",
    options = ":options",
    target = ":asserts_test",
)

# Demonstrates `defines`. The value is resolved when the test's kernel is
# compiled during the build, which is why it has to be declared here rather
# than passed to the VM at run time.
#
# `E2E_WINNER` is also set by the `extra_dart_defines` flag in this workspace's
# .bazelrc, so the test observes which of the two wins.
dart_test(
    name = "defines_test",
    size = "small",
    defines = [
        "E2E_WINNER=attr",
        "GREETING=hello from bazel",
    ],
    main = "test/defines_test.dart",
)

dart_analyze_test(
    name = "analyze_defines_test",
    size = "small",
    options = ":options",
    target = ":defines_test",
)
