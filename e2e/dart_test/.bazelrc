# Exercises the `--@rules_dart//dart:extra_dart_defines` command-line channel
# the way a real config group would: one define this build sets only from the
# flag, and one that collides with a target's own `defines` so the precedence
# is observable. See `//:defines_test`.
build --@rules_dart//dart:extra_dart_defines=E2E_FLAG=from_flag
build --@rules_dart//dart:extra_dart_defines=E2E_WINNER=flag

# Builds with path mapping, as a downstream that shares results across
# configurations does: every action that supports it sees `bazel-out/cfg/...`
# for each output directory and runs sandboxed, persistent workers included.
# Windows has no sandbox, so there Bazel would fail a path-mapped action.
common --enable_platform_specific_config
common:linux --experimental_output_paths=strip
common:macos --experimental_output_paths=strip

# Analyze and format-check every Dart target a test run names, under
# //:analysis_config.
test --aspects=@rules_dart//dart:analyze.bzl%dart_analyze
test --output_groups=+dart_analyze
test --output_groups=+dart_format
common --@rules_dart//dart:analysis_config=//:analysis_config

# `//package_test/coverage/check` checks that a generated source and a test's
# own files are reported, which Bazel instruments only when asked.
coverage --experimental_collect_code_coverage_for_generated_files
coverage --instrument_test_targets

try-import %workspace%/.bazelrc.user
