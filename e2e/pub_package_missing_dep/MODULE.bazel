module(name = "pub_package_unsupplied_dep_e2e")

bazel_dep(name = "rules_dart", version = "0.0.0")
local_path_override(
    module_name = "rules_dart",
    path = "../..",
)

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.7")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")

# `provider`'s pubspec depends on `flutter`, which nothing here supplies: no
# `pub.package()` and no lock. The fetch must name both, not leave the compile
# to find `package:flutter` missing.
pub = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub")
pub.package(
    name = "provider",
    sha256 = "4abbd070a04e9ddc287673bf5a030c7ca8b685ff70218720abab8b092f53dd84",
    version = "6.1.5",
)
use_repo(pub, "provider")
