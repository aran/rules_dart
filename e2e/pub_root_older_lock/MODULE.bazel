module(name = "pub_root_older_lock_e2e")

bazel_dep(name = "rules_dart", version = "0.0.0")
bazel_dep(name = "platforms", version = "1.1.0")

local_path_override(
    module_name = "rules_dart",
    path = "../..",
)

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.7")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")

# The root's lock pins `tuple` 2.0.1, which dep_mod's 2.0.2 raises; the root
# makes a raised request of its own an error.
pub = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub")
pub.settings(check_direct_dependencies = "error")

bazel_dep(name = "dep_mod", version = "0.0.0")
local_path_override(
    module_name = "dep_mod",
    path = "dep_mod",
)

pub.from_lock(
    name = "rootlock",
    lock = "//:pubspec.lock",
)
use_repo(pub, "rootlock")
