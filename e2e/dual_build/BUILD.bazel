# Not hermetic: `dart pub get` needs the network and a writable file system, so
# the test asks for the network (`requires-network`) and gets a pub cache of its
# own. It takes about 15 seconds, so it runs with the rest of the workspace.
#
# Fixture files are prefixed `fixture_` rather than nested in `fixture/` so
# the fake BUILD.bazel the test writes into the tempdir doesn't create a
# subpackage in THIS workspace.

load("@rules_dart//dart:defs.bzl", "dart_test")

dart_test(
    name = "run_build_runner_test",
    size = "small",
    timeout = "moderate",
    args = ["$(rlocationpath @rules_dart//dart)"],
    data = [
        "fixture_lib/user.dart",
        "fixture_pubspec.yaml",
        "@rules_dart//dart",
    ],
    main = "run_build_runner_test.dart",
    tags = ["requires-network"],
    deps = ["@rules_dart//dart/runfiles"],
)
