module(name = "pub_package_padded_e2e")

bazel_dep(name = "rules_dart", version = "0.0.0")
local_path_override(
    module_name = "rules_dart",
    path = "../..",
)

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.7")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")

# pub.dev serves nested 1.0.0 with bytes after the end of its gzip stream.
# Whichever way a package is declared, pub.dev's archives must fetch. Its
# pubspec depends on `flutter`, which the lock lists as an SDK package and
# `resolve` maps to a stand-in, so the dependency is supplied.
pub = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub")
pub.from_lock(
    name = "sdk",
    lock = "//:pubspec.lock",
    resolve = {"flutter": "//flutter"},
)
pub.package(
    name = "nested",
    sha256 = "03bac4c528c64c95c722ec99280375a6f2fc708eec17c7b3f07253b626cd2a20",
    version = "1.0.0",
)
use_repo(pub, "nested", "sdk")
