load("//:checks.bzl", "pub_graph_check")

exports_files(["pubspec.lock"])

# Property: a dependency a hosted package declares, and the lock lists, is never
# silently dropped from that package's dependencies. Here `petitparser` is an
# `sdk` package in the lock, which `pub.from_lock()` does not fetch and no
# `resolve` maps, so this check MUST FAIL TO BUILD, naming `xml`'s dependency
# on `petitparser` and how to supply it (CI's expected-failure job checks it).
# `manual` keeps it out of `//...`, which the rest of the workspace builds.
# Losing the edge quietly would break `package:petitparser` imports in `xml` far
# from the cause.
#
# The lock also lists `from_elsewhere` from a source pub does not know. pub reads
# such a lock, so the hub loads it too; only depending on it fails.

pub_graph_check(
    name = "hosted_package_keeps_unsupplied_dependency",
    direct_deps = [
        "collection",
        "petitparser",
    ],
    tags = ["manual"],
    target = "@ovr//:xml",
)
