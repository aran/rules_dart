module(name = "pub_lock_digest_conflict_e2e")

bazel_dep(name = "rules_dart", version = "0.0.0")
local_path_override(
    module_name = "rules_dart",
    path = "../..",
)

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.7")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")

# Two locks pin path 1.9.1 but disagree on its digest. At most one of them
# describes the archive that is fetched, so the build must refuse rather than
# quietly trust whichever lock is listed first.
pub = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub")
pub.from_lock(
    name = "deps_a",
    lock = "//:lock_a.lock",
)
pub.from_lock(
    name = "deps_b",
    lock = "//:lock_b.lock",
)
use_repo(pub, "deps_a", "deps_b")
