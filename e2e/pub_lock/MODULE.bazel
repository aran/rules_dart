module(name = "pub_lock_e2e")

bazel_dep(name = "rules_dart", version = "0.0.0")
local_path_override(
    module_name = "rules_dart",
    path = "../..",
)

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.5")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")

# Dev-only: a module whose pub packages serve only its own builds and tests
# keeps them out of its consumers' resolution.
pub = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub", dev_dependency = True)
pub.from_lock(
    name = "pub_deps",
    lock = "//:pubspec.lock",
)

# `path` is declared explicitly although pubspec.lock also lists it, and `file`
# (locked too) depends on it. The explicit declaration stands in for `path`
# everywhere: in `@pub_deps` and as `file`'s dependency.
pub.package(
    name = "path",
    sha256 = "75cca69d1490965be98c73ceaea117e8a04dd21217b37b292c9ddbec0d955bc5",
    version = "1.9.1",
)

# The lint ruleset is declared with pub.package rather than added to
# pubspec.lock: the lock is this workspace's fixture input, and a lint-only
# package is not a dependency of the code it lints.
pub.package(
    name = "very_good_analysis",
    sha256 = "0bd5eb8d6be76aa0d71e70cbdae6cac8f784f761170568e3c2214a6948c7f6d3",
    version = "11.0.0",
)
use_repo(pub, "path", "pub_deps", "very_good_analysis")
