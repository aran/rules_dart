load("@rules_dart//dart:defs.bzl", "dart_analysis_options", "dart_analyze_test", "dart_binary")
load(":registry_contract.bzl", "check_registry_contract")

exports_files(["pubspec.lock"])

# Asserts rules_dart's curated-registry resolver is loadable and usable from
# another module, the way rules_flutter consumes it.
check_registry_contract()

dart_binary(
    name = "app",
    main = "main.dart",
    deps = [
        "@pub_deps//:collection",
        "@pub_deps//:path",
    ],
)

# The ruleset is named here rather than in `app`'s deps: a lint ruleset is not a
# dependency of the code it lints, and listing it there would carry it into the
# `DartInfo` of every downstream consumer.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@very_good_analysis"],
)

dart_analyze_test(
    name = "analyze_app",
    size = "small",
    options = ":options",
    target = ":app",
)
