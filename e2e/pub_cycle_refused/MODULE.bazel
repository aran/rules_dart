module(name = "pub_cycle_refused_e2e")

bazel_dep(name = "rules_dart", version = "0.0.0")
local_path_override(
    module_name = "rules_dart",
    path = "../..",
)

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.7")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")

# Packages that depend on each other build as one library only where the root
# declares the cycle, exactly. Each case fails when its library is planned.
pub = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub")
pub.from_lock(
    name = "deps",
    build_from_pubspec = [
        "left",
        "old_a",
        "old_b",
        "right",
        "theirs",
        "tri_a",
        "tri_b",
        "tri_c",
    ],
    lock = "//:pubspec.lock",
    resolve = {"mine": "//mine"},
)

# `left` and `right` depend on each other, and nothing declares it.

# `mine`, which a target of this workspace builds, and `theirs`, built from
# its pubspec, depend on each other: no declaration can build that.

# `old_a` depends on `old_b`, but not the other way round: a stale declaration.
pub.cycle(packages = [
    "old_a",
    "old_b",
])

# `tri_a`, `tri_b` and `tri_c` are one cycle, of which this declares only part.
pub.cycle(packages = [
    "tri_a",
    "tri_b",
])
use_repo(pub, "deps")
