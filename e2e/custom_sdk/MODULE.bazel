# The same SDK, older than Dart's change to `aot-snapshot`, with no target
# runtime: an `aot-snapshot` compiles without one, an `exe` could not.
dart.custom_sdk(
    name = "no_target_runtime",
    cross_tools = {
        "gen_snapshot_linux_arm64_linux_x64": "@cross_gen_snapshot_linux-arm64//file:gen_snapshot",
        "gen_snapshot_macos_arm64_linux_x64": "@cross_gen_snapshot_macos-arm64//file:gen_snapshot",
        "gen_snapshot_macos_x64_linux_x64": "@cross_gen_snapshot_macos-x64//file:gen_snapshot",
        "gen_snapshot_windows_x64_linux_x64.exe": "@cross_gen_snapshot_windows-x64//file:gen_snapshot",
    },
    sdk = {
        "linux-arm64": "@supplied_linux-arm64//:version",
        "linux-x64": "@supplied_linux-x64//:version",
        "macos-arm64": "@supplied_macos-arm64//:version",
        "macos-x64": "@supplied_macos-x64//:version",
        "windows-x64": "@supplied_windows-x64//:version",
    },
    source = "@supplied_source//:DEPS",
)

# An SDK built in a checkout. A real one's path comes from `DART_CHECKOUT`; this
# stand-in is laid out by a repository, from the two above. Its build directory
# holds `gen_snapshot`, as `create_sdk` leaves it; the target's runtime is not
# something that build makes, so it is named.
dart.checkout(
    name = "from_checkout",
    checkout = "@standin_checkout//:DEPS",
    cross_tools = {"dartaotruntime_linux_x64": "@cross_dartaotruntime//file:dartaotruntime"},
)

# The same stand-in reached the way a real checkout is, through `DART_CHECKOUT`.
# Nothing sets it in a plain build, so CI's `checkout-from-env` job runs the
# `from_env_*` tests, giving it the stand-in's path.
dart.checkout(
    name = "from_env",
    cross_tools = {"dartaotruntime_linux_x64": "@cross_dartaotruntime//file:dartaotruntime"},
)

standin_checkout = use_repo_rule("//:standin_checkout.bzl", "standin_checkout")

standin_checkout(
    name = "standin_checkout",
    gen_snapshots = {
        "linux-arm64": "@cross_gen_snapshot_linux-arm64//file:gen_snapshot",
        "macos-arm64": "@cross_gen_snapshot_macos-arm64//file:gen_snapshot",
