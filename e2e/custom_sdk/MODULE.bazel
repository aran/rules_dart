# Each way of supplying a Dart SDK other than a release rules_dart pins, all of
# them Dart 3.14.0 where rules_dart pins a newer one. `dart.use_sdk` chooses the
# one a plain build uses; BUILD.bazel runs the same tests under the others.
# `minimum` is the oldest SDK rules_dart builds with; `minimum/` tests it.
module(name = "custom_sdk_e2e")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_dart", version = "0.0.0")
bazel_dep(name = "rules_platform", version = "0.1.0")

local_path_override(
    module_name = "rules_dart",
    path = "../..",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")

# The SDK this workspace builds with, stated here and nowhere else.
dart.use_sdk(name = "released")

# A name that reads like one of rules_dart's own repositories. Declared first,
# so that its repository for this host's archive is named after it.
dart.release(
    name = "pubspec_reader",
    dart_version = "3.14.0",
    sdk_sha256 = {"linux-arm64": "2bb9a19418ced8d9f5cc9e7faa2dcbbc7dc93882b287b8cd8db859efa191c888"},
)

