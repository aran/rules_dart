load("@rules_dart//dart:defs.bzl", "dart_analysis_test", "dart_binary", "dart_library", "dart_package_metadata", "dart_test")
load("@rules_platform//platform_data:defs.bzl", "platform_data")
load(":with_sdk.bzl", "with_sdk_test")

# A dependent compiled against this library's outline, so the outline stripper
# of the SDK in use runs, and analysis against its summary, so its summary
# analyzer does.
dart_package_metadata(
    name = "metadata",
    package_name = "greeting",
    language_version = "3.14",
)

dart_library(
    name = "greeting",
    srcs = ["lib/greeting.dart"],
    package = ":metadata",
)

dart_binary(
    name = "greet",
    srcs = ["bin/greet.dart"],
    compile_mode = "exe",
    main = "bin/greet.dart",
    deps = [":greeting"],
)

# An `aot-snapshot`, whose cross compile takes no target runtime on the newest
# SDKs.
dart_binary(
    name = "greet_aot",
    srcs = ["bin/greet.dart"],
    compile_mode = "aot-snapshot",
    main = "bin/greet.dart",
    deps = [":greeting"],
)

# What the SDK in use is, and that a program compiled by it runs.
dart_test(
    name = "sdk_test",
    size = "small",
    data = [
        ":greet",
        "@rules_dart//dart",
    ],
    env = {
        "DART": "$(rlocationpath @rules_dart//dart)",
        "GREET": "$(rlocationpath :greet)",
    },
    main = "sdk_test.dart",
    deps = [
        ":greeting",
        "@rules_dart//dart/runfiles",
    ],
)

dart_analysis_test(
    name = "analysis_test",
    targets = [":greeting"],
)

platform(
    name = "linux_x64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "on_linux_x64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

# Cross-compiling to Linux x86-64 runs on every host but Linux x86-64, where
# that build is the native one: there the test is skipped, and proves nothing.
_CROSS_COMPILING_HOSTS = select({
    ":on_linux_x64": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

platform_data(
    name = "greet_linux_x64",
    platform = ":linux_x64",
    target = ":greet",
    target_compatible_with = _CROSS_COMPILING_HOSTS,
)

# The program compiled for Linux x86-64 by the SDK in use is such an executable.
dart_test(
    name = "cross_test",
    size = "small",
    data = [":greet_linux_x64"],
    env = {"PROGRAM": "$(rlocationpath :greet_linux_x64)"},
    main = "cross_test.dart",
    target_compatible_with = _CROSS_COMPILING_HOSTS,
    deps = ["@rules_dart//dart/runfiles"],
)

platform_data(
    name = "greet_aot_linux_x64",
    platform = ":linux_x64",
    target = ":greet_aot",
    target_compatible_with = _CROSS_COMPILING_HOSTS,
)

# The snapshot compiled for Linux x86-64 is an ELF file for that machine too.
dart_test(
    name = "aot_cross_test",
    size = "small",
    data = [":greet_aot_linux_x64"],
    env = {"PROGRAM": "$(rlocationpath :greet_aot_linux_x64)"},
    main = "cross_test.dart",
    target_compatible_with = _CROSS_COMPILING_HOSTS,
    deps = ["@rules_dart//dart/runfiles"],
)

_TESTS = [
    "sdk_test",
    "analysis_test",
    "cross_test",
    "aot_cross_test",
]

[
    [
        with_sdk_test(
            name = "%s_%s" % (sdk, test),
            size = "small",
            sdk = sdk,
            test = ":" + test,
        )
        for test in _TESTS
    ]
    for sdk in [
        "from_repositories",
        "from_checkout",
    ]
]

# No SDK here has a Windows on Arm build. As the first execution platform it is
# passed over for one the SDK serves, for builds and cross compiles alike. It
# offers only Dart's toolchains, as nothing here can really run on it.
platform(
    name = "windows_arm64",
    allowed_toolchain_types = [
        "@rules_dart//dart:exec_tools_toolchain_type",
        "@rules_dart//dart:toolchain_type",
    ],
    check_toolchain_types = True,
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:windows",
    ],
)

[
    [
        with_sdk_test(
            name = "%s_%s_past_unserved_platform" % (sdk, test),
            size = "small",
            first_exec_platform = ":windows_arm64",
            sdk = sdk,
            test = ":" + test,
        )
        for test in _TESTS
    ]
    for sdk in [
        "released",
        "from_repositories",
        "from_checkout",
    ]
]

# Only what its checksums allow: no target runtime.
with_sdk_test(
    name = "prerelease_aot_cross_test",
    size = "small",
    sdk = "prerelease",
    test = ":aot_cross_test",
)

# An SDK of the other kinds needs no target runtime for this, at any version.
with_sdk_test(
    name = "no_target_runtime_aot_cross_test",
    size = "small",
    sdk = "no_target_runtime",
    test = ":aot_cross_test",
)

# Needs `--repo_env=DART_CHECKOUT`: see MODULE.bazel.
[
    with_sdk_test(
        name = "from_env_" + test,
        size = "small",
        sdk = "from_env",
        tags = ["manual"],
        test = ":" + test,
    )
    for test in _TESTS
]
