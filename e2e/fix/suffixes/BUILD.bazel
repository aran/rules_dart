load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@bazel_skylib//rules:run_binary.bzl", "run_binary")
load("@rules_dart//dart:defs.bzl", "dart_fix", "dart_library")

# Pins the heuristic `dart_fix` cannot rely on. `dart fix` skips files called
# `*.g.dart` and no other name, so a `.freezed.dart` part is rewritten like any
# other source. Everything here is hand-written and therefore eligible, which
# leaves the file name as the only variable.
#
# The violations are load-bearing, so do not `bazel run //suffixes:fix` — it
# would rewrite the fixture and take the assertion with it.
dart_library(
    name = "lib",
    package_name = "fix_suffixes",
    srcs = [
        "lib/thing.dart",
        "lib/thing.freezed.dart",
        "lib/thing.g.dart",
    ],
)

dart_fix(
    name = "fix",
    options = "//:options",
    target = ":lib",
)

filegroup(
    name = "manifest",
    srcs = [":fix"],
    output_group = "dart_fix_manifest",
)

filegroup(
    name = "fixes",
    srcs = [":fix"],
    output_group = "dart_fix_fixes",
)

diff_test(
    name = "manifest_test",
    size = "small",
    file1 = ":manifest",
    file2 = "golden/fix_manifest.json",
)

# The `--content` list is the whole assertion and it is exhaustive: an extra
# file in the tree fails the build. That is what says a generated file was never
# written back — a check that only looked for the files it expected would pass
# just as happily with a stray `.freezed.dart` beside them.
#
# Not a `diff_test` against the tree: `diff_test` runs a bare `diff` with no
# `-r`, which on two directories prints "Common subdirectories" and exits 0.
run_binary(
    name = "thing_fixed",
    srcs = [":fixes"],
    outs = ["thing_fixed.dart"],
    args = [
        "--fixes",
        "$(execpath :fixes)",
        "--out",
        "$(execpath thing_fixed.dart)",
        "--content",
        "suffixes/lib/thing.freezed.dart",
        "--path",
        "suffixes/lib/thing.freezed.dart",
    ],
    tool = "//tools:check_fixes",
)

diff_test(
    name = "thing_fixed_test",
    size = "small",
    file1 = ":thing_fixed.dart",
    file2 = "golden/thing.freezed.dart",
)
