load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@bazel_skylib//rules:run_binary.bzl", "run_binary")
load("@rules_dart//dart:defs.bzl", "dart_analyze_test", "dart_codegen", "dart_fix", "dart_library")

# The green end of the red/green pair. //dirty holds the same library with two
# violations in it; this one is what `bazel run //dirty:fix` must produce, and
# `:analyze` is the proof that what it produces passes the analyzer.
exports_files(["lib/model.dart"])

dart_codegen(
    name = "model_g",
    package_name = "fix_clean",
    src = "lib/model.dart",
    generator = "//tools:part_gen.dart",
    output_suffixes = [".g.dart"],
)

dart_codegen(
    name = "model_freezed",
    package_name = "fix_clean",
    src = "lib/model.dart",
    generator = "//tools:part_gen.dart",
    output_suffixes = [".freezed.dart"],
)

dart_library(
    name = "lib",
    package_name = "fix_clean",
    srcs = [
        "lib/model.dart",
        ":model_freezed",
        ":model_g",
    ],
)

dart_analyze_test(
    name = "analyze",
    size = "small",
    options = "//:options",
    target = ":lib",
)

dart_fix(
    name = "fix",
    options = "//:options",
    target = ":lib",
)

filegroup(
    name = "manifest",
    srcs = [":fix"],
    output_group = "dart_fix_manifest",
)

filegroup(
    name = "fixes",
    srcs = [":fix"],
    output_group = "dart_fix_fixes",
)

# Nothing left to fix, which is the other half of "red before, green after":
# the sources that analyze clean are exactly the sources `dart fix` leaves
# alone. An empty `dropped` says the generated parts were never proposed
# either — the rule's exclusions kept `dart fix` off them rather than the
# eligibility check discarding fixes after the fact.
diff_test(
    name = "manifest_test",
    size = "small",
    file1 = ":manifest",
    file2 = "golden/fix_manifest.json",
)

# The `--content` list is the whole assertion and it is exhaustive: an extra
# file in the tree fails the build. That is what says a generated file was never
# written back — a check that only looked for the files it expected would pass
# just as happily with a stray `.freezed.dart` beside them. Here the list is
# empty, so the assertion is "the tree holds nothing".
#
# Not a `diff_test` against the tree: `diff_test` runs a bare `diff` with no
# `-r`, which on two directories prints "Common subdirectories" and exits 0.
run_binary(
    name = "no_fixes",
    srcs = [":fixes"],
    outs = ["no_fixes.stamp"],
    args = [
        "--fixes",
        "$(execpath :fixes)",
        "--out",
        "$(execpath no_fixes.stamp)",
    ],
    tool = "//tools:check_fixes",
)

build_test(
    name = "no_fixes_test",
    size = "small",
    targets = [":no_fixes"],
)
