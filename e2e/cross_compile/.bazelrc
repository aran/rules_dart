# Analyze and format-check every Dart target a test run names, under
# //:analysis_config.
test --aspects=@rules_dart//dart:analyze.bzl%dart_analyze
test --output_groups=+dart_analyze
test --output_groups=+dart_format
common --@rules_dart//dart:analysis_config=//:analysis_config

# `dart compile --target-os` downloads its cross binaries unless they are
# already in its cache, so a sandbox without network is what proves the cross
# toolchains supply them.
build --sandbox_default_allow_network=false

try-import %workspace%/.bazelrc.user
