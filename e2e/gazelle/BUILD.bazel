load("@gazelle//:def.bzl", "gazelle", "gazelle_binary")
load("@rules_dart//dart:defs.bzl", "dart_test")

# Gazelle writes the BUILD files of `codegen/` and `split/`, which this
# workspace builds and tests; CI fails when `bazel run //:gazelle -- -mode=diff`
# would change one. `gazelle_test` runs it over copies of the samples below,
# which are its inputs and have no BUILD files of their own.
# gazelle:exclude bin
# gazelle:exclude lib
# gazelle:exclude test
# gazelle:exclude gazelle_test.dart
gazelle_binary(
    name = "gazelle_bin",
    languages = [
        "@rules_dart_gazelle_plugin//dart",
    ],
)

gazelle(
    name = "gazelle",
    gazelle = ":gazelle_bin",
)

_SAMPLES = [
    "bin/deferred_import.dart",
    "bin/hello.dart",
    "bin/show_import.dart",
    "lib/greeter.dart",
    "lib/io_impl.dart",
    "lib/platform_client.dart",
    "lib/stub.dart",
    "lib/web_impl.dart",
    "test/greeter_test.dart",
]

dart_test(
    name = "gazelle_test",
    size = "small",
    args = ["$(rlocationpath :gazelle_bin)"] +
           ["$(rlocationpath %s)" % f for f in _SAMPLES],
    data = _SAMPLES + [":gazelle_bin"],
    main = "gazelle_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)
