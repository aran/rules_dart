module(name = "gazelle_e2e")

bazel_dep(name = "rules_dart", version = "0.0.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "rules_dart_gazelle_plugin", version = "0.0.0")
local_path_override(
    module_name = "rules_dart_gazelle_plugin",
    path = "../../gazelle",
)

# Building the Go binaries here goes through the C++ toolchain, which on macOS
# is apple_support's. 2.9.0 builds that toolchain's helper tools for macOS 11,
# the oldest Xcode 27's libc++ accepts without a warning.
bazel_dep(name = "apple_support", version = "2.10.1")

local_path_override(
    module_name = "rules_dart",
    path = "../..",
)

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.7")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")

# The runtime packages of `codegen/`, whose BUILD files Gazelle writes.
pub = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub")
pub.from_lock(
    name = "pub_deps",
    lock = "//codegen:pubspec.lock",
)
use_repo(pub, "pub_deps")
