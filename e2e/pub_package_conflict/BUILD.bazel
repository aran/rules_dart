load(":checks.bzl", "pub_graph_check")

exports_files(["pubspec.lock"])

# Property: two modules that declare different versions of one package, with the
# root silent, are never resolved by silently picking one. THIS WORKSPACE MUST
# FAIL TO BUILD, with an error naming both modules and versions and telling the
# root to pin the package (CI's expected-failure job checks it). If it builds,
# mod_b's 1.9.0 and mod_c's 1.9.1 were reconciled without a word.
pub_graph_check(
    name = "conflicting_declarations_are_not_silently_resolved",
    target = "@pkgconf//:path",
)
