module(name = "pub_member_kind_e2e")

# A rule set of its own building pub packages the way `pub.from_lock()` does,
# over rules_dart's public pub surface only: its own member kind, carrying data
# rules_dart knows nothing about, its own library rule and repositories, and a
# dependency cycle (alpha <-> beta) mixing its members with rules_dart's.
bazel_dep(name = "rules_dart", version = "0.0.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")

local_path_override(
    module_name = "rules_dart",
    path = "../..",
)

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.7")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")

fancy = use_extension("//ext:extension.bzl", "fancy")
fancy.package(
    name = "alpha",
    greeting = "hello from alpha",
    pubspec = "//pkgs/alpha:pubspec.yaml",
)

# rules_dart's own member kind, in the same cycle as alpha.
fancy.package(
    name = "beta",
    pubspec = "//pkgs/beta:pubspec.yaml",
)
fancy.package(
    name = "gamma",
    greeting = "hello from gamma",
    pubspec = "//pkgs/gamma:pubspec.yaml",
)
use_repo(fancy, "fancy__alpha", "fancy__beta", "fancy__gamma")
