load("@rules_dart//dart:defs.bzl", "dart_binary", "dart_codegen", "dart_library", "dart_test")

# A Bazel-generated `part` file feeding a runnable program and a test.

dart_codegen(
    name = "message_part",
    package_name = "part_pkg_fixture",
    src = "lib/message.dart",
    generator = "//tools:part_gen.dart",
    language_version = "3.11",
    output_suffixes = [".g.dart"],
)

dart_library(
    name = "part_pkg_fixture",
    package_name = "part_pkg_fixture",
    srcs = [
        "lib/message.dart",
        ":message_part",
    ],
    language_version = "3.11",
    visibility = ["//visibility:public"],
)

dart_binary(
    name = "app",
    main = "bin/main.dart",
    deps = [":part_pkg_fixture"],
)

dart_test(
    name = "lib_test",
    main = "test/lib_test.dart",
    deps = [
        ":part_pkg_fixture",
        "@pub_deps//:test",
    ],
)

dart_test(
    name = "app_run_test",
    data = [":app"],
    main = "test/run_test.dart",
    deps = [
        "@pub_deps//:test",
        "@rules_dart//dart/runfiles",
    ],
)
