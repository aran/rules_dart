load("@rules_dart//dart:defs.bzl", "dart_codegen", "dart_library", "dart_package_metadata", "dart_source_set", "dart_test")

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "source_set_fixture",
    language_version = "3.11",
)

# A package assembled explicitly via dart_source_set and consumed via srcs_dir
# (the pre-assembled single-directory path through the consumer's co-location).

dart_codegen(
    name = "message_part",
    src = "lib/message.dart",
    generator = "//tools:part_gen.dart",
    output_suffixes = [".g.dart"],
    package = ":pubspec-metadata",
)

dart_source_set(
    name = "srcs",
    srcs = [
        "lib/message.dart",
        ":message_part",
    ],
)

dart_library(
    name = "source_set_fixture",
    package = ":pubspec-metadata",
    srcs_dir = ":srcs",
    visibility = ["//visibility:public"],
)

dart_test(
    name = "lib_test",
    size = "small",
    main = "test/lib_test.dart",
    deps = [
        ":source_set_fixture",
        "@pub_deps//:test",
    ],
)
