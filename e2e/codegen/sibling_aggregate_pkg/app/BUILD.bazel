load("@rules_dart//dart:defs.bzl", "dart_analyze_test", "dart_library", "dart_package")

# Dart package root. The codegen targets consuming this library live in the
# SIBLING Bazel package `../gen/` — generated shards' short_paths sit under
# `sibling_aggregate_pkg/gen/`, entirely outside this package's lib_root
# (`sibling_aggregate_pkg/app`).

exports_files(
    ["lib/item.dart"],
    visibility = ["//sibling_aggregate_pkg/gen:__pkg__"],
)

# The package's identity, stated once for the rules in BOTH Bazel packages. The
# `dart_codegen` and `dart_aggregate_codegen` in `../gen/` reference this rather
# than repeating the name and language version, which is the case no macro can
# cover: a macro cannot emit targets into two BUILD files.
dart_package(
    name = "pkg",
    package_name = "sibling_aggregate_fixture",
    language_version = "3.11",
    visibility = ["//sibling_aggregate_pkg/gen:__pkg__"],
)

dart_library(
    name = "item_lib",
    srcs = ["lib/item.dart"],
    package = ":pkg",
    visibility = ["//sibling_aggregate_pkg/gen:__pkg__"],
)

# In this package rather than `../gen/`: `item_lib` is not visible outside it.
dart_analyze_test(
    name = "analyze_item_lib",
    size = "small",
    options = "//:options",
    target = ":item_lib",
)
