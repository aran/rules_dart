load("@rules_dart//dart:defs.bzl", "dart_analyze_test", "dart_codegen", "dart_library", "dart_package_metadata", "dart_test")

# A dart_library that re-exports a Bazel-generated standalone library.

dart_package_metadata(
    name = "pkg",
    package_name = "reexport_fixture",
    language_version = "3.11",
)

dart_codegen(
    name = "api_gen",
    src = "lib/api.dart",
    generator = "//tools:lib_gen.dart",
    output_suffixes = [".g.dart"],
    package = ":pkg",
)

dart_library(
    name = "reexport_fixture",
    srcs = [
        "lib/api.dart",
        ":api_gen",
    ],
    package = ":pkg",
    visibility = ["//visibility:public"],
)

dart_test(
    name = "api_test",
    size = "small",
    main = "test/api_test.dart",
    deps = [
        ":reexport_fixture",
        "@pub_deps//:test",
    ],
)

dart_analyze_test(
    name = "analyze_lib",
    size = "small",
    options = "//:options",
    target = ":reexport_fixture",
)

dart_analyze_test(
    name = "analyze_api_test",
    size = "small",
    options = "//:options",
    target = ":api_test",
)
