load(
    "@rules_dart//dart:defs.bzl",
    "dart_analysis_config",
    "dart_analysis_options",
    "dart_binary",
)

exports_files(["lock_a.lock"])

# Root module A: depends on module_b's dart_library AND its own pub deps.
# This validates cross-module pub.from_lock deduplication.
dart_binary(
    name = "app",
    main = "main.dart",
    deps = [
        "@deps_a//:collection",
        "@module_b//:greeter",
        "@module_c//:logger",
    ],
)

dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@very_good_analysis"],
)

# `@module_b//:greeter` reaches this module as an external target, so the aspect
# checks only `main.dart` here; module_b's own sources are not analyzed.
dart_analysis_config(
    name = "analysis_config",
    options = [":options"],
)
