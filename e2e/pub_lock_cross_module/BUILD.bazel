load(
    "@rules_dart//dart:defs.bzl",
    "dart_analysis_options",
    "dart_analyze_test",
    "dart_binary",
)

exports_files(["lock_a.lock"])

# Root module A: depends on module_b's dart_library AND its own pub deps.
# This validates cross-module pub.from_lock deduplication.
dart_binary(
    name = "app",
    main = "main.dart",
    deps = [
        "@deps_a//:collection",
        "@module_b//:greeter",
    ],
)

dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@very_good_analysis"],
)

# Covers main.dart only. `@module_b//:greeter` reaches this module as an
# external repo, so its sources stage into the non-analyzed `extpkgs` region —
# resolvable for `package:module_b/greeter.dart`, never itself reported. Linting
# it would mean an analyze test inside module_b, which nothing runs: the root
# `.bazelignore` excludes module_b from `//...`, and module_b has no
# `local_path_override` for rules_dart to build standalone.
dart_analyze_test(
    name = "analyze_app",
    size = "small",
    options = ":options",
    target = ":app",
)
