module(name = "external_module_e2e")

# A module that builds its own rules on rules_dart's exported helpers. It depends
# on neither bazel_lib nor any repo by the name rules_dart uses internally, so
# whatever rules_dart exports has to mean the same thing here as it does there.
bazel_dep(name = "rules_dart", version = "0.0.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")

local_path_override(
    module_name = "rules_dart",
    path = "../..",
)

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.7")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")
