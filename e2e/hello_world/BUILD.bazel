load("@rules_dart//dart:defs.bzl", "dart_analysis_options", "dart_analyze_test", "dart_binary")

dart_binary(
    name = "hello",
    main = "hello.dart",
)

# The headline case for `DartAnalyzableInfo`: `hello.dart` is under no `lib/`,
# so no `dart_library` will take it and nothing could lint it until
# `dart_analyze_test` learned to accept an executable. The binary has no deps at
# all, which makes it the degenerate shape too — the staged project's
# `package_config.json` names no package, and the entrypoint is still analyzed.
dart_analyze_test(
    name = "analyze_hello",
    size = "small",
    target = ":hello",
)

# Alternative compile modes — same source, different output formats.

dart_binary(
    name = "hello_aot",
    compile_mode = "aot-snapshot",
    main = "hello.dart",
)

dart_binary(
    name = "hello_kernel",
    compile_mode = "kernel",
    main = "hello.dart",
)

dart_binary(
    name = "hello_jit",
    compile_mode = "jit-snapshot",
    main = "hello.dart",
)

# The same entrypoint under a published lint ruleset. This is a second target
# rather than an `options` attribute on `analyze_hello`: the staged
# `package_config.json` names the target's own closure plus the options deps, and
# `:hello` has no deps, so an options target here is precisely what would stop
# that config from being empty — which is the thing `analyze_hello` exists to
# prove. The two shapes cannot be the same target.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@very_good_analysis"],
)

dart_analyze_test(
    name = "analyze_hello_vga",
    size = "small",
    options = ":options",
    target = ":hello",
)

# Analysis reads the entrypoint, so all four compile modes see identical
# diagnostics. Covering each anyway pins that `DartAnalyzableInfo` survives every
# `compile_mode`, not just the default.
dart_analyze_test(
    name = "analyze_hello_aot",
    size = "small",
    options = ":options",
    target = ":hello_aot",
)

dart_analyze_test(
    name = "analyze_hello_kernel",
    size = "small",
    options = ":options",
    target = ":hello_kernel",
)

dart_analyze_test(
    name = "analyze_hello_jit",
    size = "small",
    options = ":options",
    target = ":hello_jit",
)
