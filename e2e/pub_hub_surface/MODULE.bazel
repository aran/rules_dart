module(name = "pub_hub_surface_e2e")

bazel_dep(name = "rules_dart", version = "0.0.0")
bazel_dep(name = "platforms", version = "1.1.0")

local_path_override(
    module_name = "rules_dart",
    path = "../..",
)

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.7")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")

pub = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub")
pub.from_lock(
    name = "surface",
    lock = "//:pubspec.lock",
)

# `collection` is in the lock AND declared here, at a newer version: the
# declaration's request is the highest, so its repository is the package, and
# the hub must still expose `@surface//:collection`.
pub.package(
    name = "collection",
    sha256 = "2f5709ae4d3d59dd8f7cd309b4e023046b57d8a6c82130785d2b0e5868084e76",
    version = "1.19.1",
)
use_repo(pub, "collection", "surface")
