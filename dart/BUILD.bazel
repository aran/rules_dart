# The `dart_analysis_config` whose options the `dart_analyze` aspect uses, for
# its checks and for what `@rules_dart//dart/format` and `@rules_dart//dart/fix`
# write. The default lists none: every file gets the SDK's defaults.
label_flag(
    name = "analysis_config",
    build_setting_default = "//dart/private:empty_analysis_config",
    # No build tool reads it: `scope = "target"` keeps it from reconfiguring them.
    scope = "target",
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "analyze",
    srcs = ["analyze.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//dart/private:dart_analyze_aspect"],
)

