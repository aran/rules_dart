load("@bazel_lib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("//dart/private:build_settings.bzl", "dart_defines_flag")
load("//dart/private:dart_sdk_binary.bzl", "dart_sdk_binary")
load("//dart/private:resolved_toolchain.bzl", "resolved_toolchain")
load("//tool:starlark_docs.bzl", "starlark_docs_test")

# The public .bzl files' `bzl_library` targets also extract their API docs
# (`starlark_doc_extract`), which the release attaches and `:docs_test`
# checks. Test packages below keep skylib's, which extracts none.
# gazelle:map_kind bzl_library bzl_library @bazel_lib//:bzl_library.bzl

# Dart environment declarations folded into every Dart compile, after any
# target-level `defines`. Repeatable — one define per occurrence:
#   bazel build //app --@rules_dart//dart:extra_dart_defines=FOO=bar
# They describe the app: `scope = "target"` keeps them out of the exec
# configuration, so build tools are compiled without them, and a new value
# does not rebuild the tools.
dart_defines_flag(
    name = "extra_dart_defines",
    build_setting_default = [],
    scope = "target",
    visibility = ["//visibility:public"],
)

# Whether every Dart kernel compile for the VM runs the front end's
# creation-location transform (`--track-creation-locations`, also known as
# `--track-widget-creation`): a class that is tracked (Flutter's `Widget`, or
# any annotated `@pragma('track-creation-locations')`) takes a hidden location
# argument in its constructors, and each call site passes where it is. The
# setting has to be the same for every library of a program and its entrypoint,
# and one flag is what guarantees that. Off (the default), no argument is passed.
# `scope = "target"` keeps build tools, which compile in the exec configuration,
# out of it. Not for `dart2js` or `dart2wasm`.
#   bazel test //... --@rules_dart//dart:track_creation_locations
bool_flag(
    name = "track_creation_locations",
    build_setting_default = False,
    scope = "target",
    visibility = ["//visibility:public"],
)

# Whether a `dart_binary` in the `exe` or `aot-snapshot` mode leaves its
# debugging information out of the executable and writes it to
# `<name>.symbols`, in the `debug_info` output group, as
# `dart compile --save-debugging-info` and `flutter build --split-debug-info`
# do. Its stack traces then print as addresses, which the symbols file
# translates back (`package:native_stack_traces`, `flutter symbolize`). A
# `kernel` has no debugging information to split. `scope = "target"` keeps the
# build's own tools out of it.
#   bazel build //app --@rules_dart//dart:split_debug_info --output_groups=+debug_info
bool_flag(
    name = "split_debug_info",
    build_setting_default = False,
    scope = "target",
    visibility = ["//visibility:public"],
)

# Whether `dart_test` compiles each library once into kernel modules and links
# the ones a test reaches (the default), or compiles every test's whole program
# from source. Turned off build-wide only, as an escape hatch:
#   bazel test //... --@rules_dart//dart:modular_kernel=false
# Import checks do not depend on it: a library checks its own imports either way.
bool_flag(
    name = "modular_kernel",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

# Whether, under `modular_kernel`, a test's program is a kernel list (the
# default): a text file naming the kernels the test reaches, which the VM reads
# as one program, so the test stores no copy of them. Off, every test's program
# is one joined `.dill`. rules_flutter reads it for its widget tests too:
#   bazel test //... --@rules_dart//dart:kernel_list=false
bool_flag(
    name = "kernel_list",
    build_setting_default = True,
    # No build tool reads it: `scope = "target"` keeps it from reconfiguring them.
    scope = "target",
    visibility = ["//visibility:public"],
)

# Whether a `dart_test` under `package:test` starts the runner from an app-JIT
# snapshot cached per machine, which the first test to find none trains. The
# snapshot is never a Bazel input or output: training is not byte-reproducible,
# and the cache can change only how fast the runner starts. Off by default: a
# remote executor may have no writable shared directory, or a fresh one for
# each action. Off, the runner starts from its kernel and no cache is touched.
# For local test runs:
#   common --@rules_dart//dart:runner_snapshot
bool_flag(
    name = "runner_snapshot",
    build_setting_default = False,
    # No build tool reads it: `scope = "target"` keeps it from reconfiguring them.
    scope = "target",
    visibility = ["//visibility:public"],
)

# Whether, under `modular_kernel`, a library's dependents compile against its
# modules' outlines (their kernel without function bodies) rather than the full
# kernel. On (the default), an edit inside a function body recompiles only the
# library's own modules: its dependents' compiles read the same outline, and
# Bazel reuses them. A library declaring a mixin, or written before Dart 3.0,
# keeps its source positions in its outline, so an edit there that moves code
# recompiles its dependents too. Off, they compile against full kernels:
#   bazel test //... --@rules_dart//dart:outline_kernel=false
# The outlines are made with the `pkg/kernel` of the SDK that compiled the
# modules: the outline toolchain (`:outline_toolchain_type`) of the Dart SDK.
bool_flag(
    name = "outline_kernel",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

# On when `outline_kernel` is: a kernel SDK selects its outline tool on it,
# so that with the flag off the tool, and the SDK source it is built from, are
# not fetched.
config_setting(
    name = "is_outline_kernel",
    flag_values = {":outline_kernel": "true"},
    visibility = ["//visibility:public"],
)

# On (the default), analysis runs in persistent workers: the summary
# analyzer's (summary and analyze actions, under `analysis_summaries`) and the
# analysis server's (`dart fix`, and analysis with summaries off), each server
# kept for the requests of a build. Off, every action starts a fresh process:
#   bazel test //... --@rules_dart//dart:analysis_worker=false
bool_flag(
    name = "analysis_worker",
    build_setting_default = True,
    # No build tool reads it: `scope = "target"` keeps it from reconfiguring them.
    scope = "target",
    visibility = ["//visibility:public"],
)

# On (the default), the `dart_analyze` aspect analyzes each target against
# analyzer summaries of its dependencies rather than their source, so an edit
# that changes no declaration (a function body) re-analyzes only its own
# target. Every dependency library gets a summary action of its own. The
# summaries are read by an analyzer rules_dart builds on the SDK's own
# `pkg/analyzer` and `pkg/linter`, unmodified (the analyzer toolchain,
# `:analyzer_toolchain_type`), because no SDK tool reads them. The README's
# "Analysis against summaries" says what it cannot do. Off, every target is
# analyzed with its dependencies' source, by the SDK's own `dart analyze`:
#   bazel test //... --@rules_dart//dart:analysis_summaries=false
# It keeps Bazel's default scope, as `outline_kernel` does: the summary
# analyzer is resolved in the exec configuration of the analysis actions, and
# with the flag off its SDK source must not be fetched there either.
bool_flag(
    name = "analysis_summaries",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

# On when `analysis_summaries` is: the analyzer toolchain selects its tool on
# it, so that with the flag off the tool, and the SDK source it is built from,
# are not fetched.
config_setting(
    name = "is_analysis_summaries",
    flag_values = {":analysis_summaries": "true"},
    visibility = ["//visibility:public"],
)

# This is the target rule authors should put in their "toolchains"
# attribute in order to get a runtime for the correct platform.
# See https://docs.bazel.build/versions/main/toolchains.html#writing-rules-that-use-toolchains
toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

# Build-time tools (the codegen rules) resolve their Dart SDK through this type
# instead of `:toolchain_type`. Codegen runs on the exec/host machine and emits
# platform-agnostic Dart source, so its toolchains are registered with
# `exec_compatible_with` pinned and `target_compatible_with` omitted — i.e.
# selection is independent of the build's target platform. This lets codegen
# resolve under any target platform (iOS, Android, …), including ones rules_dart
# registers no compile toolchain for.
toolchain_type(
    name = "exec_tools_toolchain_type",
    visibility = ["//visibility:public"],
)

# The outline stripper of a Dart SDK, for `outline_kernel`: a
# `dart_outline_toolchain`, built on that SDK's own `pkg/kernel`. The `dart`
# extension registers one with each Dart toolchain.
toolchain_type(
    name = "outline_toolchain_type",
    visibility = ["//visibility:public"],
)

# The summary analyzer of a Dart SDK, for `analysis_summaries`: a
# `dart_analyzer_toolchain`, built on that SDK's own `pkg/analyzer` and
# `pkg/linter`. The `dart` extension registers one with each Dart toolchain.
toolchain_type(
    name = "analyzer_toolchain_type",
    visibility = ["//visibility:public"],
)

resolved_toolchain(
    name = "resolved_toolchain",
    # Marked manual so that `bazel test //...` passes
    # even if no toolchain is registered.
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# Run the Dart SDK binary:
#   bazel run @rules_dart//dart -- --version
#   bazel run @rules_dart//dart -- analyze lib
dart_sdk_binary(
    name = "dart",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# Converts line coverage a Dart VM reported, as `package:coverage` writes it, to
# the LCOV tracefile Bazel's coverage runner merges, naming files by their
# workspace path. For a test rule that collects coverage from a VM of its own;
# its command line is stable. See "Coverage" in the README, and
# `test_coverage` in `utils.bzl`.
alias(
    name = "coverage_converter",
    actual = "//dart/private/tools:coverage_converter",
    visibility = ["//visibility:public"],
)

