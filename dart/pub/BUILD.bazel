load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//dart/pub/private:pub_runner.bzl", "pub_runner")

# Runs pub from the pinned Dart SDK, at the root of the workspace it is run in:
#   bazel run @rules_dart//dart/pub -- get
#   bazel run @rules_dart//dart/pub -- upgrade --directory=app path
# Built with no Dart tool of rules_dart's own, so it runs while the `pub`
# extension refuses a lock: the state in which its errors say to run it.
pub_runner(
    name = "pub",
    srcs = ["//dart/runfiles:lib/runfiles.dart"],
    main = "//dart/pub/private:pub_runner.dart",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "yaml_parser",
    srcs = ["yaml_parser.bzl"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "pubspec",
    srcs = ["pubspec.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//dart/pub/private/pubspec_reader:reader"],
)

bzl_library(
    name = "pub_lock_package",
    srcs = ["pub_lock_package.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        ":pub_graph",
        ":pubspec",
        "//dart/pub/private:build_content",
        "//dart/pub/private:pub_archive",
        "//dart/pub/private:pub_git",
    ],
)

bzl_library(
    name = "pub_lock_library",
    srcs = ["pub_lock_library.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        ":pub_graph",
        "//dart/pub/private:build_content",
    ],
)

bzl_library(
    name = "pub_graph",
    srcs = ["pub_graph.bzl"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "pub_library",
    srcs = ["pub_library.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//dart:providers",
        "//dart/private:dart_info",
        "//dart/private:dart_library",
        "//dart/private:runtime",
    ],
)

bzl_library(
    name = "pub_lock_hub",
    srcs = ["pub_lock_hub.bzl"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "extensions",
    srcs = ["extensions.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        ":pub_lock_hub",
        ":pub_lock_library",
        ":pub_lock_package",
        ":yaml_parser",
        "//dart/pub/private:pub_archive",
        "//dart/pub/private:pub_git",
        "//dart/pub/private:pub_repository",
        "//dart/pub/private:version",
    ],
)

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
)
