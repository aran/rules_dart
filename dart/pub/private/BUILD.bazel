load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

bzl_library(
    name = "build_content",
    srcs = ["build_content.bzl"],
    visibility = ["//dart/pub:__subpackages__"],
)

bzl_library(
    name = "pub_archive",
    srcs = ["pub_archive.bzl"],
    visibility = ["//dart/pub:__subpackages__"],
)

bzl_library(
    name = "pub_repository",
    srcs = ["pub_repository.bzl"],
    visibility = ["//dart/pub:__subpackages__"],
    deps = [
        ":build_content",
        ":pub_archive",
        "//dart/pub:pubspec",
    ],
)

bzl_library(
    name = "version",
    srcs = ["version.bzl"],
    visibility = ["//dart/pub:__subpackages__"],
)

bzl_library(
    name = "pub_git",
    srcs = ["pub_git.bzl"],
    visibility = ["//dart/pub:__subpackages__"],
    deps = [":pub_archive"],
)
