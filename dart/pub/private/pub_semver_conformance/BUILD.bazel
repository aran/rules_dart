load("@bazel_lib//:bzl_library.bzl", "bzl_library")
load("//dart:defs.bzl", "dart_test")
load(":cases.bzl", "version_results")

version_results(name = "results")

dart_test(
    name = "conformance_test",
    size = "small",
    args = ["$(rlocationpath :results)"],
    data = [":results"],
    main = "conformance_test.dart",
    deps = [
        "//dart/runfiles",
        "@ext_pub_deps//:pub_semver",
        "@ext_pub_deps//:test",
    ],
)

bzl_library(
    name = "cases",
    srcs = ["cases.bzl"],
    visibility = ["//dart/pub:__subpackages__"],
    deps = ["//dart/pub/private:version"],
)
