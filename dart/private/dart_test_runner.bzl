"""The `package:test` runner that `dart_test` runs a test through.

`dart_test` compiles a test at build time and runs it under `package:test`'s own
runner, because that runner is what implements the protocols Bazel asks a test
framework to honour: `--test_filter`, sharding, and a per-case result report.
Run directly, a test file gets none of them, and `package:test` applies a
hard-coded 30-second timeout per case besides — a second authority over time
that Bazel's `size`/`timeout` already owns.

The runner and the test must come from the same `package:test`: they talk over
a protocol private to that package's version, so a runner pinned by rules_dart
would drift from the version a user's lockfile resolves. The runner is therefore
built from the user's own `package:test`, once per version, inside the spoke
repository that provides it: the spoke's public `test` target is a
`dart_test_package` that forwards the library unchanged and carries the runner
beside it, and `dart_test` finds the runner on whichever direct dependency is
`package:test`.
"""

load("//dart:providers.bzl", "DartInfo")
load("//dart/private:common.bzl", "PATH_MAPPING")
load("//dart/private:dart_binary.bzl", "dart_binary")
load("//dart/private:dart_module.bzl", "KERNEL_TOOL_ATTR")
load("//dart/private:exec_groups.bzl", "PORTABLE", "PORTABLE_EXEC_GROUPS")

visibility("//dart/...")

DartTestRunnerInfo = provider(
    doc = "The `package:test` runner built from a `package:test` library.",
    fields = {
        "runner": "File: the runner, compiled to a kernel (`.dill`).",
        "digest": "File: the runner's SHA-256 in hex, which names its cached snapshot.",
    },
)

# The runner's entrypoint is `package:test`'s own `bin/test.dart`, which does
# nothing but re-export this library. `bin/` is not part of a pub spoke, which
# stages `lib/` only, so the one line is written here instead.
_RUNNER_MAIN = """\
// Generated by rules_dart: the `package:test` runner, as `dart test` runs it.
export 'package:test/src/executable.dart';
"""

def _dart_test_runner_main_impl(ctx):
    out = ctx.actions.declare_file(ctx.label.name + ".dart")
    ctx.actions.write(output = out, content = _RUNNER_MAIN)
    return [DefaultInfo(files = depset([out]))]

dart_test_runner_main = rule(
    implementation = _dart_test_runner_main_impl,
    doc = "Writes the entrypoint the `package:test` runner is compiled from.",
)

def _dart_test_package_impl(ctx):
    library = ctx.attr.library
    runner = [f for f in ctx.attr.runner[DefaultInfo].files.to_list() if f.extension == "dill"]
    if len(runner) != 1:
        fail("%s: `runner` must produce exactly one `.dill`, got %s" % (ctx.label, runner))

    # Hashed once here, for every test the runner runs: what names the snapshot
    # `dart_test` caches of it, so that another runner never starts from it.
    digest = ctx.actions.declare_file(ctx.label.name + ".runner.sha256")
    args = ctx.actions.args()
    args.add("--input", runner[0])
    args.add("--output", digest)
    ctx.actions.run(
        executable = ctx.executable._kernel_tool,
        arguments = ["digest", args],
        inputs = runner,
        outputs = [digest],
        mnemonic = "DartRunnerDigest",
        exec_group = PORTABLE,
        progress_message = "Hashing the package:test runner %{label}",
        execution_requirements = PATH_MAPPING,
    )
    return [
        library[DefaultInfo],
        library[DartInfo],
        DartTestRunnerInfo(runner = runner[0], digest = digest),
    ]

dart_test_package = rule(
    implementation = _dart_test_package_impl,
    attrs = KERNEL_TOOL_ATTR | {
        "library": attr.label(
            doc = "The `package:test` `dart_library`.",
            mandatory = True,
            providers = [DartInfo],
        ),
        "runner": attr.label(
            doc = "A kernel-mode `dart_binary` built from `library`.",
            mandatory = True,
        ),
    },
    exec_groups = PORTABLE_EXEC_GROUPS,
    doc = "`package:test` as a dependency, carrying the runner built from it.",
)

def pub_test_runner(name, library, visibility = None):
    """Declares `package:test` as a dependency that carries its own runner.

    A pub library repository that provides `package:test` calls this once, so
    `dart_test` runs every test through a runner built from that same
    `package:test`. It declares `<name>_runner_main` (the entrypoint),
    `<name>_runner` (the runner, a kernel) and `<name>`, the target tests
    depend on: `library` forwarded unchanged, with the runner beside it.

    Args:
        name: The target tests depend on, conventionally `test`.
        library: The `package:test` library target.
        visibility: The visibility of `name`.
    """
    dart_test_runner_main(name = name + "_runner_main")
    dart_binary(
        name = name + "_runner",
        compile_mode = "kernel",
        main = ":" + name + "_runner_main",
        deps = [library],
    )
    dart_test_package(
        name = name,
        library = library,
        runner = ":" + name + "_runner",
        visibility = visibility,
    )
