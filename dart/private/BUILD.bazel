    name = "empty_analysis_config",
    visibility = ["//visibility:public"],
)

# An executable's environment, carried to its dependencies' kernel modules by
# the transition of `executable_defines_config`. Not a flag:
# `--@rules_dart//dart:extra_dart_defines` is the command-line way in.
# `scope = "target"` keeps it out of the exec configuration, as that flag.
string_list_setting(
    name = "module_defines",
    build_setting_default = [],
    scope = "target",
    visibility = ["//visibility:public"],
)

# Whether a `dart_library` checks its own imports. Not a flag: only
# `without_import_check` turns it off, for the libraries `kernel_tool`, which
# runs the check, is built from.
bool_setting(
    name = "import_check",
    build_setting_default = True,
)

config_setting(
    name = "without_import_check",
    flag_values = {":import_check": "False"},
)

# A target with no executable, which `library_import_check` reads as nothing to
# check with.
filegroup(name = "no_import_checker")

alias(
    name = "import_checker",
    actual = select({
        ":without_import_check": ":no_import_checker",
        "//conditions:default": "//dart/private/tools:kernel_tool",
    }),
    visibility = ["//visibility:public"],
)

# The summary analyzer of the resolved Dart SDK, and that SDK's summary, for
# `--@rules_dart//dart:analysis_summaries`.
summary_analyzer(
    name = "summary_analyzer",
    enabled = select({
        "//dart:is_analysis_summaries": True,
        "//conditions:default": False,
    }),
    visibility = ["//visibility:public"],
)

vm_kernel_sdk(
    name = "vm_kernel_sdk",
    outlines = select({
        "//dart:is_outline_kernel": True,
        "//conditions:default": False,
    }),
    visibility = ["//visibility:public"],
)

# What executables compile their whole program with. It resolves no outline
# toolchain, whose stripper is itself a `dart_binary`.
vm_program_kernel_sdk(
    name = "vm_program_kernel_sdk",
    visibility = ["//visibility:public"],
)

# `--platforms` as it was before the nearest web transition, JSON-encoded; ""
# outside one. The web transitions set it and `runtime_reset` restores
# `--platforms` from it and clears it (runtime.bzl). `scope = "target"`
# keeps it out of the exec configuration.
string_setting(
    name = "platforms_before_web",
    build_setting_default = "",
    scope = "target",
    visibility = ["//visibility:public"],
)

# Which runtime a configuration's target platform carries; the web
# binaries read it through their transition.
target_runtime(
    name = "target_runtime",
    visibility = ["//visibility:public"],
)

