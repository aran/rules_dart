load(":dart_analyzer_summary.bzl", "analyzer_sdk_summary")

# The SDK's own library summary, read by every analyzer-summary action. Built
# once per SDK, and only when an action needs it: `manual`, so a wildcard build
# never builds it, and the aspects reach it by label. See dart_analyzer_summary.bzl.
analyzer_sdk_summary(
    name = "analyzer_sdk_summary",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# The aspects' analyzer attributes point at these aliases, not at the tool and
# the summary themselves. With the flag off, an attribute that named the tool
# would still configure it, and so load `@ext_pub_deps`' analyzer closure into
# every build. Each alias resolves to the real label only under the flag, and to
# a file or binary the aspects never run otherwise. Both are `manual`, so a
# wildcard build never builds the target an alias picks.
config_setting(
    name = "analyzer_summaries_on",
    flag_values = {"//dart:analyzer_summaries": "true"},
)

alias(
    name = "analyzer_summary_tool",
    actual = select({
        ":analyzer_summaries_on": "//dart/private/tools:analyzer_summary",
        "//conditions:default": "//dart/private/tools:noop",
    }),
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

alias(
    name = "analyzer_sdk_summary_input",
    actual = select({
        ":analyzer_summaries_on": ":analyzer_sdk_summary",
        "//conditions:default": "//dart/private/tools:noop.dart",
    }),
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

