load("//dart:defs.bzl", "dart_binary", "dart_test")
load("//dart/private:dart_binary.bzl", "dart_bootstrap_binary", "dart_tool_binary")

# Every macOS `exe` and `aot-snapshot`, `kernel_tool` included, compiles
# through it.
dart_bootstrap_binary(
    name = "compile_runner",
    compile_mode = "kernel",
    main = "compile_runner.dart",
    visibility = ["//visibility:public"],
    deps = ["@ext_pub_deps//:crypto"],
)

dart_binary(
    name = "noop",
    compile_mode = "exe",
    main = "noop.dart",
    visibility = ["//dart:__subpackages__"],
)

dart_binary(
    name = "analyze_runner",
    srcs = [
        "analysis_server.dart",
        "analyzer.dart",
        "dart_cli.dart",
        "server_analyzer.dart",
    ],
    compile_mode = "exe",
    main = "analyze_runner.dart",
    visibility = ["//dart:__subpackages__"],
)

dart_binary(
    name = "fix_runner",
    srcs = [
        "analysis_server.dart",
        "analyzer.dart",
        "dart_cli.dart",
        "server_analyzer.dart",
    ],
    compile_mode = "exe",
    main = "fix_runner.dart",
    visibility = ["//dart:__subpackages__"],
)

dart_binary(
    name = "fix_applier",
    compile_mode = "exe",
    main = "fix_applier.dart",
    visibility = ["//dart:__subpackages__"],
)

dart_binary(
    name = "test_runner",
    compile_mode = "exe",
    main = "test_runner.dart",
    visibility = ["//dart:__subpackages__"],
    deps = ["//dart/runfiles"],
)

# What `test_runner_test` runs through the launcher in place of a real test.
dart_binary(
    name = "test_runner_fixture",
    compile_mode = "kernel",
    main = "test_runner_fixture.dart",
)

dart_test(
    name = "test_runner_test",
    size = "small",
    args = [
        "$(rlocationpath :test_runner)",
        "$(rlocationpath :test_runner_fixture)",
    ],
    data = [
        ":test_runner",
        ":test_runner_fixture",
    ],
    main = "test_runner_test.dart",
    deps = [
        "//dart/runfiles",
        "@ext_pub_deps//:test",
    ],
)

dart_binary(
    name = "format_runner",
    compile_mode = "exe",
    main = "format_runner.dart",
    visibility = ["//dart:__subpackages__"],
)

dart_binary(
    name = "format_writer",
    compile_mode = "exe",
    main = "format_writer.dart",
    visibility = ["//dart:__subpackages__"],
    deps = ["//dart/runfiles"],
)

dart_binary(
    name = "link_hook_runner",
    compile_mode = "exe",
    main = "link_hook_runner.dart",
    # Public: rules calling `dart_link_hook_actions` declare it as an attribute.
    visibility = ["//visibility:public"],
    deps = [
        "@ext_pub_deps//:args",
        "@ext_pub_deps//:data_assets",
        "@ext_pub_deps//:hooks",
    ],
)

_KERNEL_TOOL_SRCS = [
    "kernel_tool/args.dart",
    "kernel_tool/check_command.dart",
    "kernel_tool/commands.dart",
    "kernel_tool/compile.dart",
    "kernel_tool/directives.dart",
    "kernel_tool/entry_command.dart",
    "kernel_tool/link_command.dart",
    "kernel_tool/manifest.dart",
    "kernel_tool/module_command.dart",
    "kernel_tool/module_graph.dart",
    "kernel_tool/policy.dart",
    "kernel_tool/sources.dart",
    "kernel_tool/uris.dart",
    "kernel_tool/worker_command.dart",
]

_KERNEL_TOOL_DEPS = [
    "@ext_pub_deps//:analyzer",
    "@ext_pub_deps//:bazel_worker",
    "@ext_pub_deps//:crypto",
]

# Built without the import check, which it runs for everything else.
dart_tool_binary(
    name = "kernel_tool",
    srcs = _KERNEL_TOOL_SRCS,
    compile_mode = "exe",
    main = "kernel_tool.dart",
    # Public: rule sets with their own platform link through it
    # (`KERNEL_TOOL_ATTR` in `//dart:utils.bzl`).
    visibility = ["//visibility:public"],
    deps = _KERNEL_TOOL_DEPS,
)

dart_test(
    name = "kernel_tool_test",
    size = "small",
    srcs = _KERNEL_TOOL_SRCS,
    main = "kernel_tool_test.dart",
    deps = _KERNEL_TOOL_DEPS + ["@ext_pub_deps//:test"],
)
