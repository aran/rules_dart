load("//dart:defs.bzl", "dart_binary", "dart_test")
load("//dart/private:dart_binary.bzl", "dart_bootstrap_binary", "dart_tool_binary")

# Every macOS `exe` and `aot-snapshot`, `kernel_tool` included, compiles
# through it.
dart_bootstrap_binary(
    name = "compile_runner",
    compile_mode = "kernel",
    main = "compile_runner.dart",
    visibility = ["//visibility:public"],
    deps = ["@ext_pub_deps//:crypto"],
)

# The executable of a `dart_binary` in a mode the VM runs, and of
# `@rules_dart//dart`. Built by a rule without a launcher of its own.
dart_tool_binary(
    name = "launcher",
    srcs = ["launcher_config.dart"],
    compile_mode = "exe",
    main = "launcher.dart",
    visibility = ["//visibility:public"],
    deps = ["//dart/runfiles"],
)

dart_binary(
    name = "noop",
    compile_mode = "exe",
    main = "noop.dart",
    visibility = ["//dart:__subpackages__"],
)

_ANALYZER_SRCS = [
    "analysis_server.dart",
    "analyzer.dart",
    "dart_cli.dart",
    "server_analyzer.dart",
]

# Run from source by the SDK's own `dart`, which is what hosts the analysis
# server: the runners are AOT-compiled and cannot load its JIT snapshot.
exports_files(
    ["analysis_host.dart"],
    visibility = ["//dart:__subpackages__"],
)

dart_binary(
    name = "analyze_runner",
    srcs = _ANALYZER_SRCS,
    compile_mode = "exe",
    main = "analyze_runner.dart",
    visibility = ["//dart:__subpackages__"],
    deps = ["@ext_pub_deps//:bazel_worker"],
)

dart_binary(
    name = "fix_runner",
    srcs = _ANALYZER_SRCS,
    compile_mode = "exe",
    main = "fix_runner.dart",
    visibility = ["//dart:__subpackages__"],
    deps = ["@ext_pub_deps//:bazel_worker"],
)

dart_binary(
    name = "fix_applier",
    compile_mode = "exe",
    main = "fix_applier.dart",
    visibility = ["//dart:__subpackages__"],
)

dart_binary(
    name = "test_runner",
    srcs = [
        "launcher_config.dart",
        "runner_snapshot.dart",
    ],
    compile_mode = "exe",
    main = "test_runner.dart",
    visibility = ["//dart:__subpackages__"],
    deps = [
        "//dart/kernel_list",
        "//dart/runfiles",
        "@ext_pub_deps//:ffi",
    ],
)

dart_test(
    name = "runner_snapshot_test",
    size = "small",
    srcs = ["runner_snapshot.dart"],
    main = "runner_snapshot_test.dart",
    deps = [
        "@ext_pub_deps//:ffi",
        "@ext_pub_deps//:test",
    ],
)

# What `test_runner_test` runs through its launcher in place of a real test.
# Run on its own, with no arguments, it passes.
dart_test(
    name = "test_runner_fixture",
    size = "small",
    main = "test_runner_fixture.dart",
)

# What `test_runner_test` runs through its launcher under `package:test`'s
# runner. Run on its own, it passes.
dart_test(
    name = "test_runner_runner_fixture",
    size = "small",
    main = "test_runner_runner_fixture.dart",
    deps = ["@ext_pub_deps//:test"],
)

# What `test_runner_test` runs through its launcher to select cases by tag.
# Run on its own, it passes.
dart_test(
    name = "test_runner_tags_fixture",
    size = "small",
    exclude_tags = ["slow"],
    include_tags = ["unit || integration"],
    main = "test_runner_tags_fixture.dart",
    deps = ["@ext_pub_deps//:test"],
)

# The same suite with `include_tags` that select none of its cases, which
# fails: `test_runner_test` runs it to see that.
dart_test(
    name = "test_runner_unmatched_tags_fixture",
    size = "small",
    include_tags = ["absent"],
    main = "test_runner_tags_fixture.dart",
    tags = ["manual"],
    deps = ["@ext_pub_deps//:test"],
)

dart_test(
    name = "test_runner_test",
    size = "small",
    args = [
        "$(rlocationpath :test_runner_fixture)",
        "$(rlocationpath :test_runner_runner_fixture)",
        "$(rlocationpath //dart/tests/shared_library_asset_fixture:shared_library_asset_test)",
        "$(rlocationpath :test_runner_tags_fixture)",
        "$(rlocationpath :test_runner_unmatched_tags_fixture)",
    ],
    data = [
        ":test_runner_fixture",
        ":test_runner_runner_fixture",
        ":test_runner_tags_fixture",
        ":test_runner_unmatched_tags_fixture",
        "//dart/tests/shared_library_asset_fixture:shared_library_asset_test",
    ],
    main = "test_runner_test.dart",
    deps = [
        "//dart/runfiles",
        "@ext_pub_deps//:test",
    ],
)

dart_binary(
    name = "format_runner",
    compile_mode = "exe",
    main = "format_runner.dart",
    visibility = ["//dart:__subpackages__"],
)

dart_binary(
    name = "format_writer",
    srcs = ["launcher_config.dart"],
    compile_mode = "exe",
    main = "format_writer.dart",
    visibility = ["//dart:__subpackages__"],
    deps = ["//dart/runfiles"],
)

dart_binary(
    name = "link_hook_runner",
    compile_mode = "exe",
    main = "link_hook_runner.dart",
    # Public: rules calling `dart_link_hook_actions` declare it as an attribute.
    visibility = ["//visibility:public"],
    deps = [
        "@ext_pub_deps//:args",
        "@ext_pub_deps//:data_assets",
        "@ext_pub_deps//:hooks",
    ],
)

_KERNEL_TOOL_SRCS = [
    "kernel_tool/args.dart",
    "kernel_tool/check_command.dart",
    "kernel_tool/commands.dart",
    "kernel_tool/compile.dart",
    "kernel_tool/declared_view.dart",
    "kernel_tool/digest_command.dart",
    "kernel_tool/directives.dart",
    "kernel_tool/entry_command.dart",
    "kernel_tool/frontend_command.dart",
    "kernel_tool/link_command.dart",
    "kernel_tool/manifest.dart",
    "kernel_tool/module_command.dart",
    "kernel_tool/module_graph.dart",
    "kernel_tool/policy.dart",
    "kernel_tool/sources.dart",
    "kernel_tool/uris.dart",
    "kernel_tool/worker_command.dart",
]

_KERNEL_TOOL_DEPS = [
    "@ext_pub_deps//:analyzer",
    "@ext_pub_deps//:bazel_worker",
    "@ext_pub_deps//:crypto",
]

# Built without the import check, which it runs for everything else.
dart_tool_binary(
    name = "kernel_tool",
    srcs = _KERNEL_TOOL_SRCS,
    compile_mode = "exe",
    main = "kernel_tool.dart",
    # Public: rule sets with their own platform link through it
    # (`KERNEL_TOOL_ATTR` in `//dart:utils.bzl`).
    visibility = ["//visibility:public"],
    deps = _KERNEL_TOOL_DEPS,
)

dart_test(
    name = "kernel_tool_test",
    size = "small",
    srcs = _KERNEL_TOOL_SRCS,
    main = "kernel_tool_test.dart",
    deps = _KERNEL_TOOL_DEPS + ["@ext_pub_deps//:test"],
)

# `kernel_tool frontend` over the SDK's real front end: silent on success, the
# compiler's message on failure.
dart_test(
    name = "frontend_command_test",
    size = "small",
    args = [
        "$(rlocationpath :kernel_tool)",
        "$(rlocationpath //dart/tests/sdk_files:copy_kernel)",
    ],
    data = [
        ":kernel_tool",
        "//dart/tests/sdk_files:copy_kernel",
    ],
    main = "frontend_command_test.dart",
    deps = [
        "//dart/runfiles",
        "@ext_pub_deps//:test",
    ],
)

# `kernel_tool module` as a persistent worker over the SDK's real
# `kernel_worker`: a request reads only the inputs it declares.
dart_test(
    name = "module_worker_test",
    size = "small",
    args = [
        "$(rlocationpath :kernel_tool)",
        "$(rlocationpath //dart/tests/sdk_files:copy_kernel)",
    ],
    data = [
        ":kernel_tool",
        "//dart/tests/sdk_files:copy_kernel",
    ],
    main = "module_worker_test.dart",
    deps = [
        "//dart/runfiles",
        "@ext_pub_deps//:bazel_worker",
        "@ext_pub_deps//:test",
    ],
)

dart_test(
    name = "import_policy_test",
    size = "small",
    srcs = _KERNEL_TOOL_SRCS,
    main = "import_policy_test.dart",
    deps = _KERNEL_TOOL_DEPS + ["@ext_pub_deps//:test"],
)

dart_test(
    name = "server_analyzer_test",
    size = "medium",
    srcs = _ANALYZER_SRCS,
    args = [
        "$(rlocationpath :analysis_host.dart)",
        "$(rlocationpath //dart/tests/sdk_files:copy_analyze)",
    ],
    data = [
        ":analysis_host.dart",
        "//dart/tests/sdk_files:copy_analyze",
    ],
    main = "server_analyzer_test.dart",
    deps = [
        "//dart/runfiles",
        "@ext_pub_deps//:bazel_worker",
        "@ext_pub_deps//:test",
    ],
)

# The server's end with its worker is checked by process: Windows has no
# parent-death check yet, so a killed worker leaves its server there.
dart_test(
    name = "analysis_worker_test",
    size = "medium",
    args = [
        "$(rlocationpath :analyze_runner)",
        "$(rlocationpath :analysis_host.dart)",
        "$(rlocationpath //dart/tests/sdk_files:copy_analyze)",
    ],
    data = [
        ":analysis_host.dart",
        ":analyze_runner",
        "//dart/tests/sdk_files:copy_analyze",
    ],
    main = "analysis_worker_test.dart",
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "//dart/runfiles",
        "@ext_pub_deps//:bazel_worker",
        "@ext_pub_deps//:test",
    ],
)

# The worker's correctness guard, minutes long: in the `deep` tier, which
# `bazel test --config=deep` runs.
dart_test(
    name = "analysis_restage_test",
    size = "large",
    args = [
        "$(rlocationpath :analyze_runner)",
        "$(rlocationpath :analysis_host.dart)",
        "$(rlocationpath //dart/tests/sdk_files:copy_analyze)",
    ],
    data = [
        ":analysis_host.dart",
        ":analyze_runner",
        "//dart/tests/sdk_files:copy_analyze",
    ],
    main = "analysis_restage_test.dart",
    tags = ["deep"],
    deps = [
        "//dart/runfiles",
        "@ext_pub_deps//:bazel_worker",
        "@ext_pub_deps//:test",
    ],
)

# Strips a target's kernel modules to the outlines dependents compile against
# (`--@rules_dart//dart:outline_kernel`). Each `dart_kernel_source` repository
# builds it on its own SDK's `pkg/kernel`, which must match the SDK whose
# modules it reads; so may a rule set or a user with an SDK of their own.
exports_files(
    ["kernel_outline.dart"],
    visibility = ["//visibility:public"],
)

dart_test(
    name = "kernel_outline_test",
    size = "small",
    args = ["$(rlocationpath @dart_kernel_source//:outline_tool)"],
    data = ["@dart_kernel_source//:outline_tool"],
    main = "kernel_outline_test.dart",
    deps = [
        "//dart/runfiles",
        "@ext_pub_deps//:test",
    ],
)
