load("//dart:defs.bzl", "dart_binary", "dart_test")

dart_binary(
    name = "noop",
    compile_mode = "exe",
    main = "noop.dart",
    visibility = ["//dart:__subpackages__"],
)

dart_binary(
    name = "analyze_runner",
    compile_mode = "exe",
    main = "analyze_runner.dart",
    visibility = ["//dart:__subpackages__"],
)

dart_binary(
    name = "fix_runner",
    compile_mode = "exe",
    main = "fix_runner.dart",
    visibility = ["//dart:__subpackages__"],
)

dart_binary(
    name = "fix_applier",
    compile_mode = "exe",
    main = "fix_applier.dart",
    visibility = ["//dart:__subpackages__"],
)

dart_binary(
    name = "test_runner",
    compile_mode = "exe",
    main = "test_runner.dart",
    visibility = ["//dart:__subpackages__"],
    deps = ["//dart/runfiles"],
)

# What `test_runner_test` runs through the launcher in place of a real test.
dart_binary(
    name = "test_runner_fixture",
    compile_mode = "kernel",
    main = "test_runner_fixture.dart",
)

dart_test(
    name = "test_runner_test",
    size = "small",
    args = [
        "$(rlocationpath :test_runner)",
        "$(rlocationpath :test_runner_fixture)",
    ],
    data = [
        ":test_runner",
        ":test_runner_fixture",
    ],
    main = "test_runner_test.dart",
    deps = [
        "//dart/runfiles",
        "@ext_pub_deps//:test",
    ],
)

dart_binary(
    name = "format_runner",
    compile_mode = "exe",
    main = "format_runner.dart",
    visibility = ["//dart:__subpackages__"],
)

dart_binary(
    name = "format_writer",
    compile_mode = "exe",
    main = "format_writer.dart",
    visibility = ["//dart:__subpackages__"],
    deps = ["//dart/runfiles"],
)
