"""Repositories over a Dart SDK that is a directory already on disk.

`dart.custom_sdk` names an SDK inside another repository, and `dart.checkout` a
dart-lang/sdk checkout with an SDK built in it. Either way these repositories
hold links and generated BUILD files, never the SDK's bytes, so they load
ordinary Starlark and are not shared through the repository contents cache.

The directory decides the SDK's version: its `version` file.

None of these repositories fails to fetch. An SDK this machine cannot use, for
want of a checkout, a host's files or a recent enough version, is a repository
whose targets fail the build using them, saying what is wrong: `bazel fetch
--all` and `bazel vendor` fetch every repository, whatever the machine. What
decided that is watched, so the next build sees it put right.

The rules come in pairs on one implementation. Those of `dart.checkout` are
`local`: what they hold is this machine's checkout, which `bazel vendor` must
not freeze into a directory other machines use, so it leaves them out.
"""

load(":toolchain_selection.bzl", "parse_version_or_none", "sdk_too_old_error")
load(":toolchains_repo.bzl", "PLATFORMS", "SDK_ERROR_LOAD", "build_root_cross_tools", "cross_tool_files", "host_platform", "sdk_error_target", "sdk_tool_toolchains", "unsupported_host_message")

visibility("//dart/...")

# Stands for the SDK's version in a BUILD file made before it is known.
VERSION_PLACEHOLDER = "@DART_SDK_VERSION@"

# Stands for the attributes saying which cross tools a repository found.
CROSS_TOOLS_PLACEHOLDER = "    # @DART_CROSS_TOOLS@"

# What a repository holding an SDK must not take over from the SDK's directory,
# which may be the root of another repository.
_NOT_LINKED = ["BUILD", "BUILD.bazel", "MODULE.bazel", "REPO.bazel", "WORKSPACE", "WORKSPACE.bazel"]

# The toolchains of the tools built from an SDK's source, and what their targets need.
_SDK_TOOL_TARGETS = ["outline", "analyzer"]

_SDK_TOOLS_LOAD = 'load("@rules_dart//dart:toolchain.bzl", "dart_analyzer_toolchain", "dart_outline_toolchain")\n' + SDK_ERROR_LOAD

# The directories `tools/build.py` builds in: `out` on Linux and Windows,
# `xcodebuild` on macOS, as `tools/utils.py` has it.
_BUILD_ROOTS = ["out", "xcodebuild"]

def _unavailable(rctx, targets, message):
    """Makes this repository's `targets` fail the build using them with `message`."""
    rctx.file("BUILD.bazel", "# Generated by dart/private/local_sdk.bzl\n" + SDK_ERROR_LOAD + "".join([
        sdk_error_target(target, message)
        for target in targets
    ]))

def _env_checkout(rctx, sdk, env):
    """The checkout `env` names and how to call it, or None and what is wrong."""
    path = rctx.getenv(env)
    if not path:
        return None, None, """\
Dart SDK "{sdk}" is a checkout, and {env} is not set. Point it at your \
dart-lang/sdk checkout, in .bazelrc.user:
  common --repo_env={env}=/path/to/dart-sdk/sdk""".format(sdk = sdk, env = env)
    return rctx.path(path), "{}={}".format(env, path), None

def source_checkout_problem(rctx, packages = ("kernel",)):
    """The root of the source of the SDK a repository rule serves, or what is wrong with it.

    Args:
        rctx: The context of a rule with attributes `sdk_name`, `path_env` and
            `source`, a label of a file at that root, and perhaps `path`, the
            root itself.
        packages: The packages under `pkg/` that must be there.

    Returns:
        The root's path and None, or None and a message for the user.
    """
    attr = rctx.attr
    if attr.source:
        root = rctx.path(attr.source).dirname
        named = str(attr.source)
    elif getattr(attr, "path", ""):
        root = rctx.path(attr.path)
        named = attr.path
    else:
        root, named, problem = _env_checkout(rctx, attr.sdk_name, attr.path_env)
        if problem:
            return None, problem
    for package in packages:
        for required in ["pubspec.yaml", "lib"]:
            path = root.get_child("pkg", package, required)

            # Watched before it is checked, so creating it refetches.
            rctx.watch(path)
            if not path.exists:
                return None, """\
Dart SDK "{sdk}": {named} is not the root of the Dart SDK's source: \
{root} has no pkg/{package}/{required}.""".format(sdk = attr.sdk_name, named = named, root = root, package = package, required = required)
    return root, None

def _checkout_builds(rctx, root):
    """The SDKs built in a checkout: the build directory's name and the SDK's path, for each.

    Watched, what is absent included, so that the next build sees an SDK built
    since.
    """
    builds = {}
    for build_root in _BUILD_ROOTS:
        directory = root.get_child(build_root)
        rctx.watch(directory)
        if not directory.exists:
            continue
        for build in directory.readdir():
            sdk = build.get_child("dart-sdk")
            version = sdk.get_child("version")
            rctx.watch(version)
            if version.exists:
                builds[build.basename] = sdk
    return builds

def _checkout_sdk(rctx, platform):
    """The directory of the SDK built in a checkout for `platform`, or None and what is wrong."""
    attr = rctx.attr
    sdk = attr.sdk_name
    host = host_platform(rctx.os)
    if not host:
        return None, unsupported_host_message(rctx.os)
    if platform != host:
        return None, """\
Dart SDK "{sdk}" is a checkout, which holds SDKs for the machine they were \
built on, {host}; this build needs one for {platform}.""".format(sdk = sdk, host = host, platform = platform)
    root, problem = source_checkout_problem(rctx)
    if problem:
        return None, problem
    builds = _checkout_builds(rctx, root)
    arch = PLATFORMS[platform].dart_arch.upper()
    chosen = rctx.getenv(attr.build_env)
    if chosen:
        if chosen not in builds:
            return None, """\
Dart SDK "{sdk}": {env}={chosen} is no SDK built in {root}. Those built are: {builds}.""".format(
                sdk = sdk,
                env = attr.build_env,
                chosen = chosen,
                root = root,
                builds = ", ".join(sorted(builds.keys())) or "none",
            )
        return builds[chosen], None
    fitting = sorted([b for b in builds if b in ["Debug" + arch, "Release" + arch, "Product" + arch]])
    if not fitting:
        return None, """\
Dart SDK "{sdk}": {root} holds no SDK built for this machine. Build one there:
  tools/build.py --mode=release --arch={arch} create_sdk""".format(sdk = sdk, root = root, arch = arch.lower())
    if len(fitting) > 1:
        return None, """\
Dart SDK "{sdk}": {root} holds several SDKs for this machine: {builds}. Choose one, in .bazelrc.user:
  common --repo_env={env}={first}""".format(
            sdk = sdk,
            root = root,
            builds = ", ".join(fitting),
            env = attr.build_env,
            first = fitting[0],
        )
    return builds[fitting[0]], None

def _read_version(rctx, directory):
    """The version the SDK at `directory` states, or None and what is wrong."""
    version_file = directory.get_child("version")
    rctx.watch(version_file)
    if not version_file.exists:
        return None, """\
Dart SDK "{sdk}": {directory} has no `version` file. It must be laid out as the \
SDK archive is, with `version`, `bin/` and `lib/` side by side.""".format(sdk = rctx.attr.sdk_name, directory = directory)
    version = rctx.read(version_file).strip()
    if parse_version_or_none(version) == None:
        return None, """\
Dart SDK "{sdk}": {file} says `{version}`, which is no Dart SDK version.""".format(
            sdk = rctx.attr.sdk_name,
            file = version_file,
            version = version,
        )
    return version, None

def _checked_sdk(rctx):
    """The directory of the SDK a repository serves and its version, or what is wrong.

    Returns:
        `struct(directory, version, problem)`, `problem` being None or a message.
    """
    attr = rctx.attr

    def failed(problem):
        return struct(directory = None, version = None, problem = problem)

    if attr.version_file:
        directory = rctx.path(attr.version_file).dirname
    else:
        directory, problem = _checkout_sdk(rctx, attr.platform)
        if problem:
            return failed(problem)
    dart = "dart.exe" if attr.platform.startswith("windows") else "dart"
    for required in ["bin/" + dart, "lib"]:
        path = directory.get_child(required)
        rctx.watch(path)
        if not path.exists:
            return failed("""\
Dart SDK "{sdk}": {directory} is not a {platform} Dart SDK: it has no {required}. \
It must be laid out as the SDK archive is, with `version`, `bin/` and `lib/` side by side.""".format(
                sdk = attr.sdk_name,
                directory = directory,
                platform = attr.platform,
                required = required,
            ))

    version, problem = _read_version(rctx, directory)
    if problem:
        return failed(problem)
    too_old = sdk_too_old_error(attr.sdk_name, version, attr.requests)
    if too_old:
        return failed(too_old)

    # A rebuild changes files through links; adding or removing one changes
    # what the BUILD file's globs find.
    rctx.watch_tree(directory.get_child("bin"))
    rctx.watch_tree(directory.get_child("lib"))
    return struct(directory = directory, version = version, problem = None)

def _dart_local_sdk_impl(rctx):
    # A checkout's tools are in a repository of their own: see
    # `dart_checkout_sdk_tools`.
    tools = getattr(rctx.attr, "tools", "")
    sdk = _checked_sdk(rctx)
    if sdk.problem:
        _unavailable(rctx, ["dart_toolchain"] + (_SDK_TOOL_TARGETS if tools else []), sdk.problem)
        return
    for entry in sdk.directory.readdir():
        if entry.basename not in _NOT_LINKED:
            rctx.symlink(entry, entry.basename)
    build = rctx.attr.build_file_template.replace(VERSION_PLACEHOLDER, sdk.version)
    if tools:
        build = _SDK_TOOLS_LOAD + build + sdk_tool_toolchains(sdk.version, json.decode(tools))
    rctx.file("BUILD.bazel", build)

def _cross_tool(rctx, directory, basename, build_name):
    """A cross tool's path: the one `cross_tools` names, or a checkout's own build of it."""
    attr = rctx.attr
    if basename in attr.cross_tools:
        return rctx.path(attr.cross_tools[basename])
    if not attr.version_file:
        built = directory.dirname.get_child(build_name)
        rctx.watch(built)
        if built.exists:
            return built
    return None

def _copy_executable(rctx, source, output):
    """Writes a real file with `source`'s bytes.

    A link would resolve to the SDK's own directory. `read` and `file` both pass
    bytes through unchanged, one character each, when `legacy_utf8` is off, and
    need no downloader, which `--repository_disable_download` or a restrictive
    configuration may stop even for a `file:` URL.
    """
    rctx.file(output, rctx.read(source, watch = "no"), executable = True, legacy_utf8 = False)

def _dart_local_cross_sdk_impl(rctx):
    attr = rctx.attr
    target = "dart_toolchain_cross_" + attr.target_platform
    sdk = _checked_sdk(rctx)
    if sdk.problem:
        _unavailable(rctx, [target], sdk.problem)
        return
    directory = sdk.directory
    names = cross_tool_files(attr.platform, attr.target_platform)
    build_names = build_root_cross_tools(attr.platform, attr.target_platform)
    tools = {}
    missing = {}
    for tool, name, build_name in [
        ("gen_snapshot", names.gen_snapshot, build_names.gen_snapshot),
        ("dartaotruntime", names.dartaotruntime, build_names.dartaotruntime),
    ]:
        path = _cross_tool(rctx, directory, name, build_name)
        if path:
            tools[build_name] = path
        else:
            missing[tool] = """\
Dart SDK "{sdk}" cannot cross-compile from {platform} to {target}: nothing gives `{name}`. \
Name it: dart.{tag}(name = "{sdk}", cross_tools = {{"{name}": "<label>"}}).""".format(
                sdk = attr.sdk_name,
                platform = attr.platform,
                target = attr.target_platform,
                name = name,
                tag = "custom_sdk" if attr.version_file else "checkout",
            )

    # `dart compile` looks for a target's tools first beside an SDK that is a
    # local build, the directory of its running executable holding
    # `build.ninja`. Anywhere else it asks the Dart archive, which for a build
    # of the main channel means the network whatever is cached. So this
    # repository is such a directory: its executables are real files, since a
    # link would resolve to the SDK's own directory.
    copied = ["dart", "dart.exe", "dartaotruntime", "dartaotruntime.exe"]
    for entry in directory.readdir():
        if entry.basename in _NOT_LINKED:
            continue
        if entry.basename != "bin":
            rctx.symlink(entry, entry.basename)
            continue
        for tool in entry.readdir():
            output = "bin/" + tool.basename
            if tool.basename in copied:
                _copy_executable(rctx, tool.realpath, output)
            else:
                rctx.symlink(tool, output)
    for build_name, path in tools.items():
        rctx.symlink(path, build_name)
    rctx.file("build.ninja", "# Marks this directory as a build root for `dart compile`.\n")
    written = ["build.ninja"]
    if "dartaotruntime" in missing:
        # Before 3.15.0-81.0.dev `dart compile aot-snapshot` wants this file to
        # exist, and reads nothing of it; a main-channel build's version does
        # not say whether it is that old. An `exe`, which would read it, stops
        # at `missing_cross_tools`.
        rctx.file(build_names.dartaotruntime, "Not a Dart runtime: see `build_root_tools` of `dart_toolchain`.\n", executable = False)
        written.append(build_names.dartaotruntime)
    cross_tools = "    build_root_tools = %s," % json.encode(written + sorted(tools.keys()))
    if missing:
        cross_tools += "\n    missing_cross_tools = %s," % json.encode(missing)
    rctx.file("BUILD.bazel", attr.build_file_template.replace(VERSION_PLACEHOLDER, sdk.version).replace(CROSS_TOOLS_PLACEHOLDER, cross_tools))

_SDK_NAME_ATTR = {
    "sdk_name": attr.string(doc = "The SDK's name.", mandatory = True),
}

_VERSION_FILE_ATTRS = dict(_SDK_NAME_ATTR, **{
    "version_file": attr.label(doc = "The `version` file at the root of the SDK.", mandatory = True),
})

_CHECKOUT_ATTRS = dict(_SDK_NAME_ATTR, **{
    "build_env": attr.string(doc = "The environment variable naming the checkout's build directory, when it holds several for this machine."),
    "path_env": attr.string(doc = "The environment variable holding the checkout's path, when `source` is not given."),
    "source": attr.label(doc = "The `DEPS` file at the root of the checkout."),
    "version_file": attr.label(doc = "Unset: a checkout's SDK is found in it."),
})

_SDK_ATTRS = {
    "build_file_template": attr.string(doc = "The `BUILD.bazel`, with `VERSION_PLACEHOLDER` for the version.", mandatory = True),
    "platform": attr.string(doc = "The `PLATFORMS` key of the machine the SDK runs on.", mandatory = True),
    "requests": attr.string_dict(doc = "The version each dependency requests at least, by module."),
}

_CROSS_SDK_ATTRS = dict(_SDK_ATTRS, **{
    "build_file_template": attr.string(doc = "The `BUILD.bazel`, with `VERSION_PLACEHOLDER` for the version and `CROSS_TOOLS_PLACEHOLDER` for the tools found.", mandatory = True),
    "cross_tools": attr.string_keyed_label_dict(doc = "Each cross tool by its name in the Dart archive."),
    "target_platform": attr.string(doc = "The `TARGET_PLATFORMS` key of the target.", mandatory = True),
})

_TOOLS_ATTR = {
    "tools": attr.string(doc = "The parts holding the SDK's `kernel` and `analyzer` tools, as JSON: see `toolchains_build_content`.", mandatory = True),
}

_SDK_DOC = "One platform's Dart SDK, linked from {}. If it cannot be used here, its `:dart_toolchain` fails the build using it."

_CROSS_SDK_DOC = "A Dart SDK {} laid out to cross-compile for one target. A cross tool nothing gives fails only a build needing it."

dart_local_sdk = repository_rule(
    _dart_local_sdk_impl,
    doc = _SDK_DOC.format("the directory of its `version_file`") + " Its `:outline` and `:analyzer` are the toolchains of the SDK's tools on this platform, of this platform's version.",
    attrs = dict(_VERSION_FILE_ATTRS, **dict(_SDK_ATTRS, **_TOOLS_ATTR)),
)

dart_checkout_sdk = repository_rule(
    _dart_local_sdk_impl,
    doc = _SDK_DOC.format("what is built in a checkout"),
    attrs = dict(_CHECKOUT_ATTRS, **_SDK_ATTRS),
    local = True,
)

dart_local_cross_sdk = repository_rule(
    _dart_local_cross_sdk_impl,
    doc = _CROSS_SDK_DOC.format("from other repositories"),
    attrs = dict(_VERSION_FILE_ATTRS, **_CROSS_SDK_ATTRS),
)

dart_checkout_cross_sdk = repository_rule(
    _dart_local_cross_sdk_impl,
    doc = _CROSS_SDK_DOC.format("built in a checkout"),
    attrs = dict(_CHECKOUT_ATTRS, **_CROSS_SDK_ATTRS),
    local = True,
)

def _dart_checkout_sdk_tools_impl(rctx):
    directory, problem = _checkout_sdk(rctx, host_platform(rctx.os))
    version = None
    if not problem:
        version, problem = _read_version(rctx, directory)
    if problem:
        _unavailable(rctx, _SDK_TOOL_TARGETS, problem)
        return
    rctx.file("BUILD.bazel", "# Generated by dart/private/local_sdk.bzl\n" + _SDK_TOOLS_LOAD + sdk_tool_toolchains(version, json.decode(rctx.attr.tools)))

dart_checkout_sdk_tools = repository_rule(
    _dart_checkout_sdk_tools_impl,
    doc = "The outline and analyzer toolchains of the SDK built in a checkout for this machine.",
    attrs = dict(_CHECKOUT_ATTRS, **_TOOLS_ATTR),
    local = True,
)
