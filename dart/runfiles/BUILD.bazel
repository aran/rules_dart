load("//dart:defs.bzl", "dart_binary", "dart_library", "dart_test")

dart_library(
    name = "runfiles",
    srcs = ["lib/runfiles.dart"],
    visibility = ["//visibility:public"],
)

# Run by runfiles_test from a runfiles layout it builds itself, so
# Runfiles.create() probes from the executable path rather than from the
# RUNFILES_DIR that `bazel test` sets.
dart_binary(
    name = "create_probe",
    main = "test/create_probe.dart",
    deps = [":runfiles"],
)

# Run by runfiles_test under hand-built RUNFILES_DIR / RUNFILES_MANIFEST_FILE
# environments; prints what rlocation returns for each argument.
dart_binary(
    name = "lookup_probe",
    main = "test/lookup_probe.dart",
    visibility = ["//dart/runfiles/test:__subpackages__"],
    deps = [":runfiles"],
)

dart_test(
    name = "runfiles_test",
    size = "small",
    data = [
        ":create_probe",
        ":lookup_probe",
    ],
    main = "test/runfiles_test.dart",
    deps = [
        ":runfiles",
        "@ext_pub_deps//:test",
    ],
)
