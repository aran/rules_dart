load("//dart:defs.bzl", "dart_analyze_test", "dart_binary", "dart_test")

# Combining shim — concatenates SharedPartBuilder .g.part shards into one
# .g.dart per source. Used after one or more SharedPartBuilder shims for
# the same source. Pure stdlib + args + path; no analyzer.
dart_binary(
    name = "bin",
    srcs = ["bin/main.dart"],
    code_assets_from_deps = False,
    main = "bin/main.dart",
    visibility = ["//visibility:public"],
    deps = [
        "@ext_pub_deps//:args",
        "@ext_pub_deps//:bazel_worker",
        "@ext_pub_deps//:path",
    ],
)

dart_test(
    name = "combining_test",
    size = "small",
    srcs = ["bin/main.dart"],
    main = "test/combining_test.dart",
    deps = [
        "@ext_pub_deps//:args",
        "@ext_pub_deps//:bazel_worker",
        "@ext_pub_deps//:path",
        "@ext_pub_deps//:test",
    ],
)

# A shim is an ordinary `dart_binary`, so it is an ordinary `dart_analyze_test`
# operand: the executable rules hand out `DartAnalyzableInfo`, and that is the
# whole of what analyzing a code generator takes. Worth having on generators
# specifically because a type error in one surfaces downstream as whatever the
# generated output does wrong, rather than as an error in the generator.

dart_analyze_test(
    name = "analyze_bin",
    size = "small",
    target = ":bin",
)
