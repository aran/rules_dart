# dart/ext: code-gen builders that replace build_runner.
#
# Each subdirectory hosts the shim binary + convenience macro for one
# pub.dev builder (json_serializable, freezed, …). See docs/ext.md.

load("@bazel_lib//:bzl_library.bzl", "bzl_library")
load("//dart:defs.bzl", "dart_package_metadata", "dart_test")
load("//tool:starlark_docs.bzl", "starlark_docs_test")
load(":defs.bzl", "builder_shim_library")

exports_files(
    [
        "lib/builder_shim.dart",
        "lib/src/declared_file_system.dart",
        "lib/worker_entry.dart",
        "pubspec.lock",
    ],
    visibility = ["//visibility:public"],
)

# The public API for writing a builder's shim and macro, which rules_dart's own
# builders use and other rule sets use for theirs. See docs/ext.md.
bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//dart:defs"],
)

# The curated-registry resolver is supported API for other rule sets:
# rules_flutter generates its own pub spokes and so cannot reach the registry
# through `pub_lock_package`. Only its functions are supported; `_ENTRIES`
# stays private (see registry.bzl).
bzl_library(
    name = "registry",
    srcs = ["registry.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//dart/pub:defs"],
)

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "rules_dart_ext",
    language_version = "3.12",
    visibility = ["//visibility:public"],
)

# The shim runner every per-builder shim binary in dart/ext/<*>/ links. Other
# rule sets build it against their own pub hub (`builder_shim_library`).
builder_shim_library(
    name = "builder_shim",
    pub_hub = "@ext_pub_deps",
    visibility = [
        "//dart/ext:__subpackages__",
        "//dart/tests:__subpackages__",
    ],
)

dart_test(
    name = "builder_shim_test",
    size = "medium",
    main = "test/builder_shim_test.dart",
    deps = [
        ":builder_shim",
        "@ext_pub_deps//:analyzer",
        "@ext_pub_deps//:bazel_worker",
        "@ext_pub_deps//:build",
        "@ext_pub_deps//:package_config",
        "@ext_pub_deps//:path",
        "@ext_pub_deps//:test",
    ],
)

# Every public symbol of this package's .bzl files is documented.
starlark_docs_test(name = "docs_test")
