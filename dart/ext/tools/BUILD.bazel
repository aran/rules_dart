# Dual-build collision checker. Migration scaffolding for users adopting
# rules_dart while build_runner is still producing committed files.

load("//dart:defs.bzl", "dart_analyze_test", "dart_binary", "dart_library", "dart_test")

dart_library(
    name = "check_dual_build_collisions_lib",
    package_name = "rules_dart_check_dual_build_collisions",
    srcs = ["lib/check_dual_build_collisions.dart"],
    language_version = "3.11",
    visibility = ["//visibility:public"],
    deps = [
        "//dart/runfiles",
    ],
)

dart_binary(
    name = "check_dual_build_collisions",
    srcs = ["bin/main.dart"],
    code_assets_from_deps = False,
    data = ["//gazelle/dart:baseline_generated_extensions.txt"],
    main = "bin/main.dart",
    visibility = ["//visibility:public"],
    deps = [":check_dual_build_collisions_lib"],
)

dart_test(
    name = "check_dual_build_collisions_test",
    size = "small",
    data = ["//gazelle/dart:baseline_generated_extensions.txt"],
    main = "check_dual_build_collisions_test.dart",
    deps = [
        ":check_dual_build_collisions_lib",
        "@ext_pub_deps//:test",
    ],
)

# The checker is an ordinary `dart_binary`, so it is an ordinary
# `dart_analyze_test` operand: the executable rules hand out
# `DartAnalyzableInfo`, and that is the whole of what analyzing one takes. It
# generates nothing itself — it is the dual-build migration checker — but a
# build-time tool is exactly where a type error is cheapest to catch and
# hardest to notice.

dart_analyze_test(
    name = "analyze_check_dual_build_collisions",
    size = "small",
    target = ":check_dual_build_collisions",
)
