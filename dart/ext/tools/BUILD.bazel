# Dual-build collision checker. Migration scaffolding for users adopting
# rules_dart while build_runner is still producing committed files.

load("//dart:defs.bzl", "dart_binary", "dart_library", "dart_test")

# The generated-file extensions the checker flags. The Gazelle plugin filters
# the same list, from a copy of its own; rules_dart_dev's
# generated_extensions_agree_test keeps the two the same.
exports_files(
    ["baseline_generated_extensions.txt"],
    visibility = ["//visibility:public"],
)

dart_library(
    name = "check_dual_build_collisions_lib",
    package_name = "rules_dart_check_dual_build_collisions",
    srcs = ["lib/check_dual_build_collisions.dart"],
    language_version = "3.11",
    visibility = ["//visibility:public"],
    deps = [
        "//dart/runfiles",
    ],
)

dart_binary(
    name = "check_dual_build_collisions",
    srcs = ["bin/main.dart"],
    args = ["$(rlocationpath :baseline_generated_extensions.txt)"],
    code_assets_from_deps = False,
    data = [":baseline_generated_extensions.txt"],
    main = "bin/main.dart",
    visibility = ["//visibility:public"],
    deps = [":check_dual_build_collisions_lib"],
)

dart_test(
    name = "check_dual_build_collisions_test",
    size = "small",
    args = ["$(rlocationpath :baseline_generated_extensions.txt)"],
    data = [":baseline_generated_extensions.txt"],
    main = "check_dual_build_collisions_test.dart",
    deps = [
        ":check_dual_build_collisions_lib",
        "@ext_pub_deps//:path",
        "@ext_pub_deps//:test",
    ],
)
