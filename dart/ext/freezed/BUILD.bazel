load("//dart:defs.bzl", "dart_analyze_test", "dart_binary")

# Shim binary for the freezed Builder. PartBuilder; produces .freezed.dart
# directly (no .g.part / combining step needed for this builder).
dart_binary(
    name = "shim",
    srcs = ["shim.dart"],
    code_assets_from_deps = False,
    main = "shim.dart",
    visibility = ["//visibility:public"],
    deps = [
        "//dart/ext:builder_shim",
        "@ext_pub_deps//:freezed",
    ],
)

# A shim is an ordinary `dart_binary`, so it is an ordinary `dart_analyze_test`
# operand: the executable rules hand out `DartAnalyzableInfo`, and that is the
# whole of what analyzing a code generator takes. Worth having on generators
# specifically because a type error in one surfaces downstream as whatever the
# generated output does wrong, rather than as an error in the generator.

dart_analyze_test(
    name = "analyze_shim",
    size = "small",
    target = ":shim",
)
