load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("//dart:defs.bzl", "dart_code_asset")

# rules_dart-provided code asset for `package:webcrypto` 0.6.1. Its
# hook/build.dart runs CMake over the package's C glue and its vendored
# BoringSSL; this builds the same sources from the same pub archive
# (`@webcrypto_pub_archive`, see webcrypto.BUILD) and binds the library to
# webcrypto's own asset id.

cc_shared_library(
    name = "libwebcrypto",
    # The two entry points Dart calls are marked __declspec(dllexport) in
    # src/webcrypto.h, so a Windows DLL exports them without
    # `windows_export_all_symbols`, and BoringSSL stays unexported.
    shared_lib_name = select({
        "@platforms//os:ios": "libwebcrypto.dylib",
        "@platforms//os:macos": "libwebcrypto.dylib",
        "@platforms//os:tvos": "libwebcrypto.dylib",
        "@platforms//os:visionos": "libwebcrypto.dylib",
        "@platforms//os:watchos": "libwebcrypto.dylib",
        "@platforms//os:windows": "webcrypto.dll",
        "//conditions:default": "libwebcrypto.so",
    }),
    visibility = ["//visibility:private"],
    deps = ["@webcrypto_pub_archive//:webcrypto"],
)

dart_code_asset(
    name = "code_asset",
    # lib/src/boringssl/lookup/lookup.dart binds its `@Native` functions to
    # this id; the hook registers its library under the same name.
    asset_id = "package:webcrypto/webcrypto.dart",
    file = ":libwebcrypto",
    visibility = ["//visibility:public"],
)
