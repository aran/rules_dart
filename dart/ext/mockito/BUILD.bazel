load("@bazel_lib//:bzl_library.bzl", "bzl_library")
load("//dart:defs.bzl", "dart_binary")
load("//tool:starlark_docs.bzl", "starlark_docs_test")

# Shim binary for the mockito Builder. Plain Builder; produces .mocks.dart
# directly. Note the entrypoint imports from `package:mockito/src/builder.dart`,
# matching the path mockito's own build.yaml uses.
dart_binary(
    name = "shim",
    srcs = ["shim.dart"],
    code_assets_from_packages = False,
    main = "shim.dart",
    visibility = ["//visibility:public"],
    deps = [
        "//dart/ext:builder_shim",
        "@ext_pub_deps//:mockito",
    ],
)

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = ["@rules_dart//dart/ext:defs"],
)

# Every public symbol of this package's .bzl files is documented.
starlark_docs_test(name = "docs_test")
