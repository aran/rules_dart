load("//dart:defs.bzl", "dart_analyze_test", "dart_binary")

# Two-stage pipeline (matches injectable_generator's build.yaml):
#   shim_metadata → .injectable.json (per-class metadata, LibraryBuilder)
#   shim_config   → .config.dart     (assembled DI graph, LibraryBuilder
#                                     reading every metadata shard via
#                                     findAssets glob)
# The injectable_library macro composes both stages.

dart_binary(
    name = "shim_metadata",
    srcs = ["shim_metadata.dart"],
    code_assets_from_deps = False,
    main = "shim_metadata.dart",
    visibility = ["//visibility:public"],
    deps = [
        "//dart/ext:builder_shim",
        "@ext_pub_deps//:injectable_generator",
    ],
)

dart_binary(
    name = "shim_config",
    srcs = ["shim_config.dart"],
    code_assets_from_deps = False,
    main = "shim_config.dart",
    visibility = ["//visibility:public"],
    deps = [
        "//dart/ext:builder_shim",
        "@ext_pub_deps//:injectable_generator",
    ],
)

# A shim is an ordinary `dart_binary`, so it is an ordinary `dart_analyze_test`
# operand: the executable rules hand out `DartAnalyzableInfo`, and that is the
# whole of what analyzing a code generator takes. Worth having on generators
# specifically because a type error in one surfaces downstream as whatever the
# generated output does wrong, rather than as an error in the generator.

dart_analyze_test(
    name = "analyze_shim_metadata",
    size = "small",
    target = ":shim_metadata",
)

dart_analyze_test(
    name = "analyze_shim_config",
    size = "small",
    target = ":shim_config",
)
