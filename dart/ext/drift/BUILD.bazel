load("@bazel_lib//:bzl_library.bzl", "bzl_library")
load("//dart:defs.bzl", "dart_binary")
load("//tool:starlark_docs.bzl", "starlark_docs_test")

# drift_dev's modern path is a 4-stage pipeline:
#   prep → discover → analyzer → driftBuilder (SharedPart) → combining
# Each stage gets its own dart_binary shim; users compose them via
# dart_sqlcodegen / dart_codegen targets (or via the drift_codegen macro
# in defs.bzl, which wires the chain).

dart_binary(
    name = "shim_prep",
    srcs = ["shim_prep.dart"],
    code_assets_from_packages = False,
    main = "shim_prep.dart",
    visibility = ["//visibility:public"],
    deps = [
        "//dart/ext:builder_shim",
        "@ext_pub_deps//:drift_dev",
    ],
)

dart_binary(
    name = "shim_discover",
    srcs = ["shim_discover.dart"],
    code_assets_from_packages = False,
    main = "shim_discover.dart",
    visibility = ["//visibility:public"],
    deps = [
        "//dart/ext:builder_shim",
        "@ext_pub_deps//:drift_dev",
    ],
)

dart_binary(
    name = "shim_analyzer",
    srcs = ["shim_analyzer.dart"],
    code_assets_from_packages = False,
    main = "shim_analyzer.dart",
    visibility = ["//visibility:public"],
    deps = [
        "//dart/ext:builder_shim",
        "@ext_pub_deps//:drift_dev",
    ],
)

dart_binary(
    name = "shim_drift",
    srcs = ["shim_drift.dart"],
    code_assets_from_packages = False,
    main = "shim_drift.dart",
    visibility = ["//visibility:public"],
    deps = [
        "//dart/ext:builder_shim",
        "@ext_pub_deps//:drift_dev",
    ],
)

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "@rules_dart//dart:defs",
        "@rules_dart//dart/ext:defs",
    ],
)

# Every public symbol of this package's .bzl files is documented.
starlark_docs_test(name = "docs_test")
