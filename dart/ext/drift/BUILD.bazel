load("//dart:defs.bzl", "dart_analyze_test", "dart_binary")

# drift_dev's modern path is a 4-stage pipeline:
#   prep → discover → analyzer → driftBuilder (SharedPart) → combining
# Each stage gets its own dart_binary shim; users compose them via
# dart_sqlcodegen / dart_codegen targets (or via the drift_library macro
# in defs.bzl, which wires the chain).

dart_binary(
    name = "shim_prep",
    srcs = ["shim_prep.dart"],
    code_assets_from_deps = False,
    main = "shim_prep.dart",
    visibility = ["//visibility:public"],
    deps = [
        "//dart/ext:builder_shim",
        "@ext_pub_deps//:drift_dev",
    ],
)

dart_binary(
    name = "shim_discover",
    srcs = ["shim_discover.dart"],
    code_assets_from_deps = False,
    main = "shim_discover.dart",
    visibility = ["//visibility:public"],
    deps = [
        "//dart/ext:builder_shim",
        "@ext_pub_deps//:drift_dev",
    ],
)

dart_binary(
    name = "shim_analyzer",
    srcs = ["shim_analyzer.dart"],
    code_assets_from_deps = False,
    main = "shim_analyzer.dart",
    visibility = ["//visibility:public"],
    deps = [
        "//dart/ext:builder_shim",
        "@ext_pub_deps//:drift_dev",
    ],
)

dart_binary(
    name = "shim_drift",
    srcs = ["shim_drift.dart"],
    code_assets_from_deps = False,
    main = "shim_drift.dart",
    visibility = ["//visibility:public"],
    deps = [
        "//dart/ext:builder_shim",
        "@ext_pub_deps//:drift_dev",
    ],
)

# A shim is an ordinary `dart_binary`, so it is an ordinary `dart_analyze_test`
# operand: the executable rules hand out `DartAnalyzableInfo`, and that is the
# whole of what analyzing a code generator takes. Worth having on generators
# specifically because a type error in one surfaces downstream as whatever the
# generated output does wrong, rather than as an error in the generator.

dart_analyze_test(
    name = "analyze_shim_prep",
    size = "small",
    target = ":shim_prep",
)

dart_analyze_test(
    name = "analyze_shim_discover",
    size = "small",
    target = ":shim_discover",
)

dart_analyze_test(
    name = "analyze_shim_analyzer",
    size = "small",
    target = ":shim_analyzer",
)

dart_analyze_test(
    name = "analyze_shim_drift",
    size = "small",
    target = ":shim_drift",
)
