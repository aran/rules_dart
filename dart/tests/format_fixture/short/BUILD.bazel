load("//dart:defs.bzl", "dart_binary", "dart_library", "dart_package_metadata")

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "short",
    language_version = "3.6",
)

# Declares 3.6, whose short style no later version produces, so `short.dart`
# is formatted correctly only if that version reaches the formatter.
dart_library(
    name = "short",
    srcs = ["lib/short.dart"],
    package = ":pubspec-metadata",
    visibility = ["//dart/tests/format_fixture:__pkg__"],
)

# An executable states no package of its own, so its entrypoint takes the
# version of the package whose root contains it, as Dart does: 3.6 here.
dart_binary(
    name = "short_main",
    main = "bin/short_main.dart",
    visibility = ["//dart/tests/format_fixture:__pkg__"],
    deps = [":short"],
)
