"""One `dart_package` declaration, and the ways rules can contradict it.

`dart_codegen` and the `dart_library` collecting its output each state the
package they belong to, in BUILD files that may not even be the same one. These
fixtures pin both halves of the answer: pointing both at one `dart_package`
makes the duplication impossible, and where the inline attributes are still
used, a contradiction stops the build instead of being resolved silently.

Nothing here executes. Every assertion is an `analysistest`, so `gen.dart` is
never run and the generator's outputs are never produced.
"""

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//dart:defs.bzl", "dart_codegen", "dart_library", "dart_package")
load(
    "//dart/tests:package_identity_test.bzl",
    "codegen_package_name_conflict_test",
    "identity_probe",
    "language_version_conflict_test",
    "package_and_inline_conflict_test",
)

dart_package(
    name = "pkg",
    package_name = "ident_fixture",
    language_version = "3.11",
)

# The shape this rule exists for: two rules building one package, neither
# repeating what the other says.

dart_codegen(
    name = "model_g",
    src = "lib/model.dart",
    generator = "gen.dart",
    output_suffixes = [".g.dart"],
    package = ":pkg",
    tags = ["manual"],
)

dart_library(
    name = "ident_fixture",
    srcs = [
        "lib/model.dart",
        ":model_g",
    ],
    package = ":pkg",
    tags = ["manual"],
)

# The declaration reaches `DartInfo`: a library that names no `language_version`
# of its own still compiles as 3.11, because `:pkg` said so.
identity_probe(
    name = "identity_probe_target",
    expected_language_version = "3.11",
    expected_package_name = "ident_fixture",
    target = ":ident_fixture",
)

build_test(
    name = "identity_probe_test",
    size = "small",
    targets = [":identity_probe_target"],
)

# --- contradictions the build must refuse -----------------------------------

# Says the generated file belongs to one package while the library collecting
# it says another. `dart_codegen`'s documentation has always required these to
# match; before this check, nothing did.
dart_codegen(
    name = "misnamed_g",
    package_name = "some_other_package",
    src = "lib/misnamed.dart",
    generator = "gen.dart",
    language_version = "3.11",
    output_suffixes = [".g.dart"],
    tags = ["manual"],
)

dart_library(
    name = "misnamed_lib",
    package_name = "ident_fixture",
    srcs = [
        "lib/misnamed.dart",
        ":misnamed_g",
    ],
    tags = ["manual"],
)

codegen_package_name_conflict_test(
    name = "codegen_package_name_conflict_test",
    size = "small",
    target_under_test = ":misnamed_lib",
)

# The generator states no `language_version` and so ran under the built-in
# default, while the library compiles the same package as 3.11. Silent before:
# the generator read the package's sources under semantics the package does not
# use.
dart_codegen(
    name = "defaulted_g",
    package_name = "ident_fixture",
    src = "lib/defaulted.dart",
    generator = "gen.dart",
    output_suffixes = [".g.dart"],
    tags = ["manual"],
)

dart_library(
    name = "defaulted_lib",
    package_name = "ident_fixture",
    srcs = [
        "lib/defaulted.dart",
        ":defaulted_g",
    ],
    language_version = "3.11",
    tags = ["manual"],
)

language_version_conflict_test(
    name = "language_version_conflict_test",
    size = "small",
    target_under_test = ":defaulted_lib",
)

# Two ways to state one fact is two ways for it to be wrong, so setting both is
# refused whether or not they currently agree.
dart_library(
    name = "double_declared",
    package_name = "ident_fixture",
    srcs = ["lib/model.dart"],
    package = ":pkg",
    tags = ["manual"],
)

package_and_inline_conflict_test(
    name = "package_and_inline_conflict_test",
    size = "small",
    target_under_test = ":double_declared",
)
