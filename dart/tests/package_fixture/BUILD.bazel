"""One `dart_package_metadata` declaration, and the ways rules can contradict it.

`dart_codegen` and the `dart_library` collecting its output each name the
package they belong to, in BUILD files that may not even be the same one. These
fixtures pin both halves: pointing both at one `dart_package_metadata` states
the package once, and naming two different ones stops the build.

Nothing here executes. Every assertion is an `analysistest`, so the generator
is never run and its outputs are never produced.
"""

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//dart:defs.bzl", "dart_codegen", "dart_library", "dart_package_metadata")
load(
    "//dart/tests:package_identity_test.bzl",
    "codegen_identity_conflict_test",
    "identity_probe",
)
load("//dart/tests:path_mapping_test.bzl", "path_mapping_test")

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "ident_fixture",
    language_version = "3.11",
)

# The shape this rule exists for: two rules building one package, neither
# repeating what the other says.

dart_codegen(
    name = "model_g",
    src = "lib/model.dart",
    generator = "//dart/tests/fixture_generator:generator",
    output_suffixes = [".g.dart"],
    package = ":pubspec-metadata",
    tags = ["manual"],
)

dart_library(
    name = "ident_fixture",
    srcs = [
        "lib/model.dart",
        ":model_g",
    ],
    package = ":pubspec-metadata",
    tags = ["manual"],
)

# The declaration reaches `DartInfo`: a library that names no `language_version`
# of its own still compiles as 3.11, because `:pkg` said so.
identity_probe(
    name = "identity_probe_target",
    expected_language_version = "3.11",
    expected_package_name = "ident_fixture",
    target = ":ident_fixture",
)

build_test(
    name = "identity_probe_test",
    size = "small",
    targets = [":identity_probe_target"],
)

# --- contradictions the build must refuse -----------------------------------

# A codegen naming no declaration, so its package is named after its
# directory, collected by a library of the package `:pkg` declares.
dart_codegen(
    name = "misnamed_g",
    src = "lib/misnamed.dart",
    generator = "//dart/tests/fixture_generator:generator",
    output_suffixes = [".g.dart"],
    tags = ["manual"],
)

dart_library(
    name = "misnamed_lib",
    srcs = [
        "lib/misnamed.dart",
        ":misnamed_g",
    ],
    package = ":pubspec-metadata",
    tags = ["manual"],
)

codegen_identity_conflict_test(
    name = "codegen_package_name_conflict_test",
    size = "small",
    message = "generates sources for package \"package_fixture\", which names no `dart_package_metadata`, but @@//dart/tests/package_fixture:misnamed_lib collects them into the package `@@//dart/tests/package_fixture:pubspec-metadata` declares",
    target_under_test = ":misnamed_lib",
)

# Codegen and library naming two declarations of one package name: the
# generator would run at one declaration's language version and the library
# compile at the other's.
dart_library(
    name = "defaulted_lib",
    srcs = [
        "lib/defaulted.dart",
        "//dart/tests/package_fixture/other:defaulted_g",
    ],
    package = ":pubspec-metadata",
    tags = ["manual"],
)

codegen_identity_conflict_test(
    name = "codegen_declaration_conflict_test",
    size = "small",
    message = "generates sources for the package `@@//dart/tests/package_fixture/other:pubspec-metadata` declares, but @@//dart/tests/package_fixture:defaulted_lib collects them into the package `@@//dart/tests/package_fixture:pubspec-metadata` declares",
    target_under_test = ":defaulted_lib",
)

path_mapping_test(
    name = "model_g_path_mapping_test",
    size = "small",
    target_under_test = ":model_g",
)
