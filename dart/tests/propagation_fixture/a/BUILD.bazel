load("//dart:defs.bzl", "dart_library", "dart_package_metadata")

# The middle of the diamond: depends on the asset-owning package, declares no
# assets itself, and must still carry `prop_b`'s asset to its own consumers.

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "prop_a",
)

dart_library(
    name = "a",
    srcs = ["lib/a.dart"],
    package = ":pubspec-metadata",
    visibility = ["//dart/tests:__subpackages__"],
    deps = ["//dart/tests/propagation_fixture/b"],
)
