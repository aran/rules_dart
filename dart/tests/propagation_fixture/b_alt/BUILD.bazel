load("//dart:defs.bzl", "dart_code_asset", "dart_library", "dart_package_metadata")

# `prop_b` again, as a second producer would supply it, backing the same id
# with a different library: two definitions of one id reached through `deps`.
dart_code_asset(
    name = "alt_code_asset",
    asset_id = "package:prop_b/src/ffi/prop_b.g.dart",
    file = "//dart/tests/cc_fixture:empty_shared_alt",
)

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "prop_b",
    code_assets = [":alt_code_asset"],
    tags = ["manual"],
)

dart_library(
    name = "b_alt",
    package = ":pubspec-metadata",
    tags = ["manual"],
    visibility = ["//dart/tests:__subpackages__"],
)
