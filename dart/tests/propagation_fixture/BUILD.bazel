load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//dart:defs.bzl", "dart_binary", "dart_code_asset")
load("//dart/tests:propagation_test.bzl", "asset_conflict_test", "diamond_probe", "manifest_contains_test", "opt_mode", "ownership_violation_test", "two_configurations_test", "version_conflict_test")

# The near side of the diamond. `:app` names no `code_assets` at all — it
# depends on `prop_a`, which depends on `prop_b`, which owns the asset.

dart_binary(
    name = "app",
    main = "main.dart",
    deps = ["//dart/tests/propagation_fixture/a"],
)

diamond_probe(
    name = "diamond_probe_target",
    expected_asset_ids = ["package:prop_b/src/ffi/prop_b.g.dart"],
    expected_file_count = 1,
    deps = ["//dart/tests/propagation_fixture/a"],
)

build_test(
    name = "diamond_probe_test",
    targets = [":diamond_probe_target"],
)

manifest_contains_test(
    name = "propagated_asset_in_manifest_test",
    size = "small",
    expected_asset_ids = ["package:prop_b/src/ffi/prop_b.g.dart"],
    target_under_test = ":app",
)

ownership_violation_test(
    name = "ownership_violation_test",
    size = "small",
    target_under_test = "//dart/tests/propagation_fixture/misowned:pubspec-metadata",
)

# Same asset id as the one `prop_b` propagates, but backed by a different
# library and named outright: it replaces the propagated one, which is how a
# target loads a differently built library under a package's id.
dart_code_asset(
    name = "replacing_asset",
    asset_id = "package:prop_b/src/ffi/prop_b.g.dart",
    file = "//dart/tests/cc_fixture:empty_shared_alt",
)

dart_binary(
    name = "replacing_app",
    code_assets = [":replacing_asset"],
    main = "main.dart",
    deps = ["//dart/tests/propagation_fixture/a"],
)

manifest_contains_test(
    name = "replacing_asset_in_manifest_test",
    size = "small",
    expected_asset_ids = ["package:prop_b/src/ffi/prop_b.g.dart"],
    expected_libraries = ["empty_alt"],
    target_under_test = ":replacing_app",
)

# Two dependencies propagating different libraries under one id. The Dart VM
# resolves an id to exactly one library, so taking either silently would pick
# by graph-traversal order.
dart_binary(
    name = "conflicting_app",
    main = "main.dart",
    tags = ["manual"],
    deps = [
        "//dart/tests/propagation_fixture/a",
        "//dart/tests/propagation_fixture/b_alt",
    ],
)

asset_conflict_test(
    name = "asset_conflict_test",
    size = "small",
    target_under_test = ":conflicting_app",
)

# One library target reached in two configurations is two libraries: `-c opt`
# may build it differently, and nothing at analysis time compares the bytes.
opt_mode(
    name = "a_opt",
    dep = "//dart/tests/propagation_fixture/a",
)

dart_binary(
    name = "two_configurations_app",
    main = "main.dart",
    tags = ["manual"],
    deps = [
        ":a_opt",
        "//dart/tests/propagation_fixture/a",
    ],
)

two_configurations_test(
    name = "two_configurations_test",
    size = "small",
    target_under_test = ":two_configurations_app",
)

# Two hubs supplying one package at different versions — the shape a pair of
# drifted lock files produces, with `pub.from_lock()` and rules_flutter's
# `flutter.pub()` each generating a spoke for the same package. The two
# `dart_library` targets stand in for those spokes, so the fixture needs no
# network. Before the agreement check this built successfully: first-record-wins
# resolved `dupver` to whichever arrived first in dependency order, and the
# other version's sources were simply never compiled against.

dart_binary(
    name = "dupver_app",
    main = "main.dart",
    tags = ["manual"],
    deps = [
        "//dart/tests/propagation_fixture/dupver_a:dupver",
        "//dart/tests/propagation_fixture/dupver_b:dupver",
    ],
)

version_conflict_test(
    name = "version_conflict_test",
    size = "small",
    target_under_test = ":dupver_app",
)
