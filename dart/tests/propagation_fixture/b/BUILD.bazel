load("//dart:defs.bzl", "dart_code_asset", "dart_library", "dart_package_metadata")

# The far side of the diamond: the package that *owns* a native code asset.
# Nothing downstream names this asset; it must arrive by propagation alone.

dart_code_asset(
    name = "code_asset",
    asset_id = "package:prop_b/src/ffi/prop_b.g.dart",
    file = "//dart/tests/cc_fixture:empty_shared",
    visibility = ["//dart/tests:__subpackages__"],
)

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "prop_b",
    code_assets = [":code_asset"],
)

dart_library(
    name = "b",
    srcs = ["lib/b.dart"],
    package = ":pubspec-metadata",
    visibility = ["//dart/tests:__subpackages__"],
)
