load("//dart:defs.bzl", "dart_test")

# A test no package holds runs at its repository's root in runfiles, as Bazel
# starts every test, so `data` is found by workspace-relative path.
dart_test(
    name = "cwd_test",
    size = "small",
    data = ["data.txt"],
    main = "cwd_test.dart",
    deps = ["@ext_pub_deps//:test"],
)

# `env` reaches the test, with location functions expanded against `data`.
dart_test(
    name = "env_test",
    size = "small",
    data = ["data.txt"],
    env = {
        "DATA_RLOCATIONPATH": "$(rlocationpath data.txt)",
        "PLAIN": "as written",
    },
    main = "env_test.dart",
    deps = [
        "//dart/runfiles",
        "@ext_pub_deps//:test",
    ],
)
