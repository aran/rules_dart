"""Fixtures for `//dart/tests:codegen_test.bzl`'s input-set tests. Nothing is built."""

load("//dart:defs.bzl", "dart_aggregate_codegen", "dart_codegen", "dart_library", "dart_sqlcodegen")
load("//dart/tests:codegen_test.bzl", "codegen_inputs_test", "codegen_language_version_test", "codegen_sdk_test")

# The embedder fixture is built only with analysis against summaries.
_SUMMARIES_ONLY = select({
    "//dart:is_analysis_summaries": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

dart_library(
    name = "lib",
    srcs = ["lib/b.dart"],
)

# What each generator resolves against: the library, and a dependency whose
# resource a generator reads. A codegen rule's `deps` are not judged by the
# unused check, and a file read at build time reaches it only through them.
_DEPS = [
    ":lib",
    "//dart/tests/codegen_fixture/dep",
]

dart_codegen(
    name = "per_file",
    src = "lib/a.dart",
    generator = "//dart/tests/fixture_generator:generator",
    output_suffixes = [".g.dart"],
    tags = ["manual"],
    deps = _DEPS,
)

codegen_inputs_test(
    name = "per_file_inputs_test",
    size = "small",
    target_under_test = ":per_file",
)

dart_aggregate_codegen(
    name = "aggregate",
    srcs = ["lib/a.dart"],
    generator = "//dart/tests/fixture_generator:generator",
    outputs = ["lib/a.agg.dart"],
    tags = ["manual"],
    deps = _DEPS,
)

codegen_inputs_test(
    name = "aggregate_inputs_test",
    size = "small",
    target_under_test = ":aggregate",
)

dart_sqlcodegen(
    name = "sql",
    src = "lib/a.dart",
    generator = "//dart/tests/fixture_generator:generator",
    output_suffixes = [".sql.json"],
    tags = ["manual"],
    deps = _DEPS,
)

codegen_inputs_test(
    name = "sql_inputs_test",
    size = "small",
    target_under_test = ":sql",
)

# None of the generators above states a language version.
[
    codegen_language_version_test(
        name = target + "_language_version_test",
        size = "small",
        target_under_test = ":" + target,
    )
    for target in [
        "per_file",
        "aggregate",
        "sql",
    ]
]

# Each reads the summary of the SDK its generator wrote.
[
    codegen_sdk_test(
        name = target + "_sdk_test",
        size = "small",
        sdk = "summary",
        target_under_test = ":" + target,
    )
    for target in [
        "per_file",
        "aggregate",
        "sql",
    ]
]

# Only the SDK's sources hold what a `sky_engine`'s `_embedder.yaml` adds.
dart_codegen(
    name = "embedder",
    src = "lib/a.dart",
    generator = "//dart/tests/fixture_generator:generator",
    output_suffixes = [".e.dart"],
    tags = ["manual"],
    target_compatible_with = _SUMMARIES_ONLY,
    deps = ["//dart/tests/embedder_fixture/engine"],
)

codegen_sdk_test(
    name = "embedder_sdk_test",
    size = "small",
    sdk = "source",
    target_compatible_with = _SUMMARIES_ONLY,
    target_under_test = ":embedder",
)

# A generator not built on the shim runner runs no analyzer.
dart_codegen(
    name = "combining",
    src = "lib/a.dart",
    generator = "//dart/ext/combining_shim:bin",
    output_suffixes = [".c.dart"],
    tags = ["manual"],
)

codegen_sdk_test(
    name = "combining_sdk_test",
    size = "small",
    sdk = "none",
    target_under_test = ":combining",
)
