load("//dart:defs.bzl", "dart_binary", "dart_js_binary", "dart_library", "dart_test")
load("//dart/tests:package_config_test.bzl", "package_config_own_srcs_test")
load("//dart/tests:web_test.bzl", "web_compile_hermetic_test")

# Façade: carries the package metadata (name + lib_root) but no sources.
# The consuming binary/test supplies the package's files via its own `srcs`.
dart_library(
    name = "pc_facade_lib",
    package_name = "pc_own_srcs_fixture",
    srcs = [],
)

dart_binary(
    name = "pc_binary",
    srcs = ["lib/util.dart"],
    main = "bin/main.dart",
    deps = [":pc_facade_lib"],
)

dart_test(
    name = "pc_test",
    size = "small",
    srcs = ["lib/util.dart"],
    main = "test/main_test.dart",
    deps = [":pc_facade_lib"],
)

package_config_own_srcs_test(
    name = "pc_binary_package_config_test",
    size = "small",
    target_under_test = ":pc_binary",
)

package_config_own_srcs_test(
    name = "pc_test_package_config_test",
    size = "small",
    target_under_test = ":pc_test",
)

dart_js_binary(
    name = "pc_web",
    srcs = ["lib/util.dart"],
    defines = ["banner=hello world"],
    main = "bin/main.dart",
    deps = [":pc_facade_lib"],
)

web_compile_hermetic_test(
    name = "web_compile_hermetic_test",
    size = "small",
    target_under_test = ":pc_web",
)
