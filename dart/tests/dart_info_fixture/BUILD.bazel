load("//dart:defs.bzl", "dart_code_asset", "dart_library", "dart_package_metadata")
load(
    "//dart/tests:dart_info_test.bzl",
    "analyzable_no_package_test",
    "analyzable_with_package_test",
    "bare_executable",
    "entry_srcs_under_lib_test",
    "facade_library",
    "forwards_closures_test",
    "language_version_passthrough_test",
    "misowned_asset_test",
    "no_package_empty_test",
    "no_package_name_test",
    "no_package_test",
    "wrapper_executable",
    "wrapper_library",
)

# The dependency carries one of each thing `DartInfo` propagates, so a wrapper
# that forgets any single merge loses something observable.

dart_code_asset(
    name = "dep_asset",
    asset_id = "package:info_dep/src/ffi/dep.g.dart",
    file = "//dart/tests/cc_fixture:empty_shared",
)

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "info_dep",
    code_assets = [":dep_asset"],
)

dart_library(
    name = "dep",
    srcs = ["lib/dep.dart"],
    package = ":pubspec-metadata",
    resources = ["lib/dep.yaml"],
)

wrapper_library(
    name = "wrapper",
    package_name = "wrapper_pkg",
    srcs = ["lib/wrapped.dart"],
    deps = [":dep"],
)

forwards_closures_test(
    name = "forwards_closures_test",
    size = "small",
    target_under_test = ":wrapper",
)

# `:wrapper` sets no `language_version`, so its rule passes `""` to the
# constructor — the "this package states none" answer, which must still produce
# a record rather than an error.
language_version_passthrough_test(
    name = "empty_language_version_test",
    size = "small",
    expected_language_version = "",
    expected_package = "wrapper_pkg",
    target_under_test = ":wrapper",
)

# The stated half: a value declared on the rule reaches the package record it
# describes.
wrapper_library(
    name = "wrapper_stated_lv",
    package_name = "stated_lv_pkg",
    srcs = ["lib/wrapped.dart"],
    language_version = "3.11",
)

language_version_passthrough_test(
    name = "stated_language_version_test",
    size = "small",
    expected_language_version = "3.11",
    expected_package = "stated_lv_pkg",
    target_under_test = ":wrapper_stated_lv",
)

# A facade over the same dependency: forwards everything, contributes no
# package record of its own.
facade_library(
    name = "facade",
    deps = [":dep"],
)

no_package_test(
    name = "no_package_test",
    size = "small",
    target_under_test = ":facade",
)

# The production shape: a non-Dart file and no deps at all, the way
# `flutter_material_icons` carries a font.
facade_library(
    name = "font_only_facade",
    data = ["lib/dep.yaml"],
)

no_package_empty_test(
    name = "no_package_empty_test",
    size = "small",
    target_under_test = ":font_only_facade",
)

# An executable that also contributes a package: `lib/owned.dart` is the
# package's, `entry.dart` is the entrypoint outside it. The two lists are what
# the constructor keeps apart, and the fixture supplies one of each so a
# collapse in either direction is observable.
#
# It carries a resource and a code asset of its own for the same reason the
# `dep` above does: every parameter this constructor forwards is a line that
# could be dropped without a test noticing, and the record it forwards them
# onto is this target's own rather than a dependency's.
dart_code_asset(
    name = "exec_asset",
    asset_id = "package:exec_pkg/src/ffi/owned.g.dart",
    # A different library from `dep_asset`'s: the two records would dedupe to a
    # single file otherwise, and the flat-depset assertion could not tell a
    # forwarded asset from a dropped one.
    file = "//dart/tests/cc_fixture:empty_shared_alt",
)

wrapper_executable(
    name = "exec",
    package_name = "exec_pkg",
    srcs = ["lib/owned.dart"],
    code_assets = [":exec_asset"],
    entry_srcs = ["entry.dart"],
    language_version = "3.11",
    resources = ["lib/owned.yaml"],
    # Two packages rooted at one directory, which no package_config may hold:
    # a provider-shape fixture, not a project the analyzer can resolve.
    tags = ["no-dart-analyze"],
    deps = [":dep"],
)

analyzable_with_package_test(
    name = "analyzable_with_package_test",
    size = "small",
    target_under_test = ":exec",
)

# No package name means the caller wanted the other constructor.
# `DartPackageInfo(...)` would build a nameless package record instead of saying
# so.
wrapper_executable(
    name = "unnamed_exec",
    package_name = "",
    entry_srcs = ["entry.dart"],
    tags = ["manual"],
)

no_package_name_test(
    name = "no_package_name_test",
    size = "small",
    target_under_test = ":unnamed_exec",
)

# The asset id is namespaced to `info_dep`; a wrapper claiming a different
# package must be refused by the constructor, not by `dart_library`.
wrapper_library(
    name = "misowned_wrapper",
    package_name = "not_info_dep",
    code_assets = [":dep_asset"],
    tags = ["manual"],
)

misowned_asset_test(
    name = "misowned_asset_test",
    size = "small",
    target_under_test = ":misowned_wrapper",
)

# An executable contributing no package: the entrypoint outside every `lib/`
# and a dependency's closure, nothing of its own in `DartInfo`.
bare_executable(
    name = "bare_exec",
    entry_srcs = ["entry.dart"],
    # `entry.dart` imports the package `:exec` states, which this target does
    # not: a provider-shape fixture, not a project the analyzer can resolve.
    tags = ["no-dart-analyze"],
    deps = [":dep"],
)

analyzable_no_package_test(
    name = "analyzable_no_package_test",
    size = "small",
    target_under_test = ":bare_exec",
)

# A package's own `lib/` file handed over as an entrypoint is the swap the docs
# used to warn failed silently; the constructor refuses it.
wrapper_executable(
    name = "misplaced_entry",
    package_name = "exec_pkg",
    entry_srcs = ["lib/owned.dart"],
    language_version = "3.11",
    tags = ["manual"],
)

entry_srcs_under_lib_test(
    name = "entry_srcs_under_lib_test",
    size = "small",
    target_under_test = ":misplaced_entry",
)
