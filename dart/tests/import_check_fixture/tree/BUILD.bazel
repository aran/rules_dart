load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("//dart:defs.bzl", "dart_library", "dart_package_metadata")

copy_to_directory(
    name = "tree_set",
    srcs = ["lib/tree.dart"],
)

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "import_check_tree",
)

dart_library(
    name = "tree_lib",
    package = ":pubspec-metadata",
    srcs_dir = ":tree_set",
    visibility = ["//dart/tests:__subpackages__"],
)
