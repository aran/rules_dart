dart_program_assets(
    name = "linked_with_data",
    recorded_uses = "uses.json",
    tags = ["manual"],
    deps = [
        ":lib",
        "//dart/tests/link_hook_fixture/plain_data",
    ],
)

link_hook_data_assets_test(
    name = "link_hook_data_assets_test",
    size = "small",
    target_under_test = ":linked_with_data",
)

# The same, with the hook's package the program's own and no library of it in
# `deps`: its assets are the hook's input as a dependency's would be.
dart_program_assets(
    name = "linked_own_package_with_data",
    package = ":pubspec-metadata",
    recorded_uses = "uses.json",
    tags = ["manual"],
    deps = [
        "//dart/tests/link_hook_fixture/dep",
        "//dart/tests/link_hook_fixture/plain_data",
    ],
)

link_hook_data_assets_test(
    name = "link_hook_own_package_data_assets_test",
    size = "small",
    target_under_test = ":linked_own_package_with_data",
)

# The hook receives its package's code asset, with the target it is built
# for; whether it ships is the hook's to say, so it is not known.
dart_program_assets(
    name = "linked_with_code",
    recorded_uses = "uses.json",
    tags = ["manual"],
    deps = ["//dart/tests/link_hook_fixture/coded"],
)

link_hook_code_assets_test(
    name = "link_hook_code_assets_test",
    size = "small",
    target_under_test = ":linked_with_code",
)

# An action given the program's assets with `program_assets_action_args()`:
# one flag, one param file holding what the action reads, every file it names
# an input and no other: all of them; the data alone; the code alone, with its
# libraries or by name, where a hook's selection is an input and its
# libraries are not.
VIEWS = [
    # (suffix, data, code)
    ("", True, "libraries"),
    ("_data", True, "none"),
    ("_code", False, "libraries"),
    ("_code_names", False, "names"),
]

[
    read_assets(
        name = name + view + "_read",
        assets = ":" + name,
        code = code,
        data = data,
        tags = ["manual"],
    )
    for name in [
        "linked_with_code",
        "linked_with_data",
    ]
    for view, data, code in VIEWS
]

[
    assets_action_args_test(
        name = "linked_with_code%s_action_args_test" % view,
        size = "small",
        assets = ":linked_with_code",
        code = code,
        data = data,
        expected_candidates = ["package:link_hook_coded/native"],
        target_under_test = ":linked_with_code%s_read" % view,
    )
    for view, data, code in VIEWS
]

[
    assets_action_args_test(
        name = "linked_with_data%s_action_args_test" % view,
        size = "small",
        assets = ":linked_with_data",
        code = code,
        data = data,
        expected_data = [
            "package:link_hook_fixture/data/index.json",
            "package:plain_data/banner.txt",
        ],
        target_under_test = ":linked_with_data%s_read" % view,
    )
    for view, data, code in VIEWS
]

# A tool handed nothing, or a code view that does not exist, is refused.
read_assets(
    name = "nothing_read",
    assets = ":linked_with_data",
    code = "none",
