    target_under_test = ":asset_without_hook",
)

dart_link_hook(
    name = "malformed_asset_id",
    data_assets = ["link_hook_fixture/x.json"],
    recorded_uses = "uses.json",
    tags = ["manual"],
    deps = [":lib"],
)

malformed_asset_id_test(
    name = "malformed_asset_id_test",
    size = "small",
    target_under_test = ":malformed_asset_id",
)

dart_link_hook(
    name = "recorded_uses_not_json",
    recorded_uses = ":plain",
