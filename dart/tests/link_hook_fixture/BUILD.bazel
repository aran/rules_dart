"""Fixtures for the `analysistest`s in `//dart/tests:link_hook_test.bzl`.

Nothing here is built — every target an assertion reads is tagged `manual` —
so the hook is never run and no binary is compiled. The behaviour the hooks
produce is `e2e/examples/native_hooks`'s to show.
"""

load("//dart:defs.bzl", "dart_binary", "dart_code_asset", "dart_data_asset", "dart_library", "dart_package_metadata", "dart_program_assets")
load(
    "//dart/tests:link_hook_test.bzl",
    "assets_action_args_test",
    "assets_without_cpp",
    "empty_recording_binary_test",
    "known_asset",
    "known_asset_test",
    "library_records_link_hook_test",
    "link_hook_actions_test",
    "link_hook_code_assets_test",
    "link_hook_data_assets_test",
    "native_link_test",
    "not_recording_binary_test",
    "nothing_read_test",
    "own_package_not_named_test",
    "read_assets",
    "recorded_uses_not_json_test",
    "recording_binary_test",
    "unknown_asset_test",
    "unknown_code_view_test",
    "unlinked_assets_test",
    "validation_runs_assetless_hook_test",
    "without_cpp_test",
)
load("//dart/tests:path_mapping_test.bzl", "path_mapping_test")

# What the package's build hook would route to its link hook.
dart_data_asset(
    name = "raw",
    src = "raw.json",
    asset_id = "package:link_hook_fixture/data/raw.json",
    tags = ["manual"],
)

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "link_hook_fixture",
    data_assets = [":raw"],
    link_hook = "hook/link.dart",
    link_hook_assets = ["package:link_hook_fixture/data/index.json"],
)

dart_library(
    name = "lib",
    srcs = ["lib/fixture.dart"],
    package = ":pubspec-metadata",
    deps = ["//dart/tests/link_hook_fixture/dep"],
)

library_records_link_hook_test(
    name = "library_records_link_hook_test",
    package_name = "link_hook_fixture",
    size = "small",
    target_under_test = ":lib",
)

# --- dart_binary(record_use) ---

dart_binary(
    name = "exe",
    main = "main.dart",
    record_use = True,
    tags = ["manual"],
    deps = [":lib"],
)

recording_binary_test(
    name = "exe_records_test",
    size = "small",
    target_under_test = ":exe",
)

dart_binary(
    name = "aot",
    compile_mode = "aot-snapshot",
    main = "main.dart",
    record_use = True,
    tags = ["manual"],
    deps = [":lib"],
)

recording_binary_test(
    name = "aot_snapshot_records_test",
    size = "small",
    target_under_test = ":aot",
)

# With a code asset the front end gets a native-assets mapping; recording still happens
# in the `dart compile` that tree-shakes the resulting kernel.
dart_code_asset(
    name = "asset",
    asset_id = "package:link_hook_fixture/src/ffi.g.dart",
    file = "//dart/tests/cc_fixture:empty_shared",
    tags = ["manual"],
)

dart_binary(
    name = "staged",
    code_assets = [":asset"],
    main = "main.dart",
    record_use = True,
    tags = ["manual"],
    deps = [":lib"],
)

recording_binary_test(
    name = "staged_records_test",
    size = "small",
    target_under_test = ":staged",
)

dart_binary(
    name = "kernel",
    compile_mode = "kernel",
    main = "main.dart",
    record_use = True,
    tags = ["manual"],
    deps = [":lib"],
)

empty_recording_binary_test(
    name = "kernel_records_nothing_test",
    size = "small",
    target_under_test = ":kernel",
)

dart_binary(
    name = "plain",
    main = "main.dart",
    tags = ["manual"],
    deps = [":lib"],
)

not_recording_binary_test(
    name = "plain_records_nothing_test",
    size = "small",
    target_under_test = ":plain",
)

# --- dart_program_assets ---

dart_program_assets(
    name = "linked",
    recorded_uses = ":exe",
    tags = ["manual"],
    deps = [":lib"],
