load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("//dart:defs.bzl", "dart_binary", "dart_code_asset", "dart_library", "dart_package_metadata", "dart_test")
load("//dart/tests:propagation_test.bzl", "manifest_contains_test")
load(":transitioned_asset.bzl", "transitioned_asset")

# A test whose code asset is built in another configuration than the test,
# while the test's own configuration builds a library of the same name at the
# same package path: the VM must load the one the asset names.

bool_flag(
    name = "transitioned",
    build_setting_default = False,
)

config_setting(
    name = "is_transitioned",
    flag_values = {":transitioned": "True"},
)

cc_library(
    name = "which",
    srcs = ["which.cc"],
    local_defines = select({
        ":is_transitioned": ["WHICH=2"],
        "//conditions:default": ["WHICH=1"],
    }),
)

cc_shared_library(
    name = "which_shared",
    # On Windows a DLL exports nothing unless told to.
    features = select({
        "@platforms//os:windows": ["windows_export_all_symbols"],
        "//conditions:default": [],
    }),
    deps = [":which"],
)

dart_code_asset(
    name = "asset",
    asset_id = "package:code_asset_config_fixture/which.dart",
    file = ":which_shared",
)

transitioned_asset(
    name = "transitioned_asset",
    asset = ":asset",
)

dart_test(
    name = "transitioned_asset_test",
    size = "small",
    code_assets = [":transitioned_asset"],
    # The same library in the test's configuration, where a lookup that walks
    # the wrong tree would find it.
    data = [":asset"],
    main = "transitioned_asset_test.dart",
)

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "code_asset_config_fixture",
    code_assets = [":asset"],
)

# The package that owns the asset, carrying the ordinary build of it.
dart_library(
    name = "owner",
    package = ":pubspec-metadata",
)

# The same test, but the asset reaches it through `deps`, and the transitioned
# build named in `code_assets` replaces it.
dart_test(
    name = "replaced_asset_test",
    size = "small",
    code_assets = [":transitioned_asset"],
    main = "transitioned_asset_test.dart",
    deps = [":owner"],
)

# A program in the package that declares the asset, with no library of the
# package in `deps`: its own package's assets reach it as a dependency's do.
dart_test(
    name = "own_package_asset_test",
    size = "small",
    main = "own_package_asset_test.dart",
    package = ":pubspec-metadata",
)

dart_binary(
    name = "own_package_app",
    main = "own_package_asset_test.dart",
    package = ":pubspec-metadata",
)

manifest_contains_test(
    name = "own_package_app_manifest_test",
    size = "small",
    expected_asset_ids = ["package:code_asset_config_fixture/which.dart"],
    target_under_test = ":own_package_app",
)
