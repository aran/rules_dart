"""Fixtures for the `analysistest`s in `//dart/tests:license_file_test.bzl`.

Nothing here is built: every target an assertion reads is tagged `manual`.
"""

load("//dart:defs.bzl", "dart_binary", "dart_library")
load("//dart/tests:license_file_test.bzl", "conflicting_license_test", "records_license_test")

dart_library(
    name = "lib",
    package_name = "license_file_fixture",
    srcs = ["lib/fixture.dart"],
    license_file = "LICENSE",
    tags = ["manual"],
    deps = ["//dart/tests/license_file_fixture/other"],
)

records_license_test(
    name = "library_records_license_test",
    size = "small",
    license_files = {
        "license_file_fixture": "dart/tests/license_file_fixture/LICENSE",
        "license_file_other": "",
    },
    target_under_test = ":lib",
)

# A target of the same package that names no license: the merge keeps the one
# that does, whichever record comes first.
dart_library(
    name = "unstated",
    package_name = "license_file_fixture",
    srcs = ["lib/fixture.dart"],
    tags = ["manual"],
)

dart_library(
    name = "facade",
    package_name = "license_file_facade",
    tags = ["manual"],
    deps = [
        ":lib",
        ":unstated",
    ],
)

records_license_test(
    name = "merge_keeps_stated_license_test",
    size = "small",
    license_files = {
        "license_file_facade": "",
        "license_file_fixture": "dart/tests/license_file_fixture/LICENSE",
        "license_file_other": "",
    },
    target_under_test = ":facade",
)

# Two targets of one package naming different licenses.
dart_library(
    name = "notices",
    package_name = "license_file_fixture",
    srcs = ["lib/fixture.dart"],
    license_file = "NOTICES",
    tags = ["manual"],
)

dart_binary(
    name = "conflict",
    main = "main.dart",
    tags = ["manual"],
    deps = [
        ":lib",
        ":notices",
    ],
)

conflicting_license_test(
    name = "conflicting_license_test",
    size = "small",
    target_under_test = ":conflict",
)

records_license_test(
    name = "member_records_license_test",
    size = "small",
    license_files = {"license_file_member": "dart/tests/license_file_fixture/member/LICENSE"},
    target_under_test = "//dart/tests/license_file_fixture/member",
)

records_license_test(
    name = "pub_library_records_license_test",
    size = "small",
    license_files = {"license_file_member": "dart/tests/license_file_fixture/member/LICENSE"},
    target_under_test = "//dart/tests/license_file_fixture/member:library",
)
