"""Fixtures for the `analysistest`s in `//dart/tests:license_file_test.bzl`.

Nothing here is built: every target an assertion reads is tagged `manual`.
`license_file_fixture` itself, and its second copy, are declared as fetchers
declare packages, in `@fetched_fixtures//license`.
"""

load("//dart:defs.bzl", "dart_binary")
load("//dart/tests:license_file_test.bzl", "conflicting_license_test", "records_license_test")

records_license_test(
    name = "library_records_license_test",
    size = "small",
    license_files = {
        "license_file_fixture": "../+local_repository+fetched_fixtures/license/first/LICENSE",
        "license_file_other": "",
    },
    target_under_test = "@fetched_fixtures//license/first:lib",
)

# Another target of the package carries the license too, from the one
# declaration, whichever of the two a program reaches.
records_license_test(
    name = "every_target_carries_license_test",
    size = "small",
    license_files = {
        "license_file_facade": "",
        "license_file_fixture": "../+local_repository+fetched_fixtures/license/first/LICENSE",
    },
    target_under_test = "//dart/tests/license_file_fixture/facade",
)

# A package two producers supply, each stating a different license: rooted
# apart, so compared by value.
dart_binary(
    name = "conflict",
    main = "main.dart",
    tags = ["manual"],
    deps = [
        "@fetched_fixtures//license/first:lib",
        "@fetched_fixtures//license/second",
    ],
)

conflicting_license_test(
    name = "conflicting_license_test",
    size = "small",
    target_under_test = ":conflict",
)

records_license_test(
    name = "member_records_license_test",
    size = "small",
    license_files = {"license_file_member": "dart/tests/license_file_fixture/member/LICENSE"},
    target_under_test = "//dart/tests/license_file_fixture/member",
)

records_license_test(
    name = "pub_library_records_license_test",
    size = "small",
    license_files = {"license_file_member": "dart/tests/license_file_fixture/member/LICENSE"},
    target_under_test = "//dart/tests/license_file_fixture/member:library",
)
