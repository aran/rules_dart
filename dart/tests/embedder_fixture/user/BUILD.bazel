load("//dart:defs.bzl", "dart_library", "dart_package_metadata")

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "fake_engine_user",
)

dart_library(
    name = "user",
    srcs = ["lib/user.dart"],
    # The engine provides `dart:fake`, which no import of a package names, as
    # `sky_engine` provides `dart:ui`.
    features = ["-dart_unused_deps"],
    package = ":pubspec-metadata",
    # Analyzed against summaries only (see `../engine`).
    target_compatible_with = select({
        "//dart:is_analysis_summaries": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//dart/tests/embedder_fixture:__pkg__"],
    deps = ["//dart/tests/embedder_fixture/engine"],
)
