"""Synthetic Dart SDK layout under `dart-sdk/` for `declare_dart_sdk_toolchains` tests."""

load("//dart:repositories.bzl", "declare_dart_sdk_toolchains")
load(
    "//dart/tests:toolchains_test.bzl",
    "sdk_toolchain_macro_alias_test",
    "sdk_toolchain_macro_cross_test",
    "sdk_toolchain_macro_native_test",
)

declare_dart_sdk_toolchains(
    cross_targets = [
        ("linux-arm64", "linux", "arm64"),
    ],
    dart = "dart-sdk/bin/dart",
    prefix = "dart-sdk/",
    sdk_root_name = "dart_sdk_files",
    version = "3.11.0",
)

sdk_toolchain_macro_native_test(
    name = "sdk_toolchain_macro_native_test",
    size = "small",
    target_under_test = ":dart_toolchain",
)

sdk_toolchain_macro_cross_test(
    name = "sdk_toolchain_macro_cross_test",
    size = "small",
    target_under_test = ":dart_toolchain_cross_linux-arm64",
)

sdk_toolchain_macro_alias_test(
    name = "sdk_toolchain_macro_alias_test",
    size = "small",
    target_under_test = ":sdk_root",
)
