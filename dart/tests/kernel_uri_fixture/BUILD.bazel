load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//dart:defs.bzl", "dart_binary", "dart_code_asset", "dart_library", "dart_test")

# Exes from one entrypoint, differing in what reaches the kernel step. Run by
# the test below.

dart_library(
    name = "where",
    srcs = ["lib/where.dart"],
)

dart_binary(
    name = "probe",
    main = "bin/probe.dart",
    deps = [":where"],
)

# The kernel itself, to read: it must name no path of where it was built.
dart_binary(
    name = "probe_kernel",
    compile_mode = "kernel",
    main = "bin/probe.dart",
    deps = [":where"],
)

dart_code_asset(
    name = "asset",
    asset_id = "package:kernel_uri_fixture/src/ffi/kernel_uri_fixture.g.dart",
    file = "//dart/tests/cc_fixture:empty_shared",
)

dart_binary(
    name = "probe_with_asset",
    code_assets = [":asset"],
    main = "bin/probe.dart",
    deps = [":where"],
)

# A generated file among the binary's own `srcs`, beside the entrypoint: the
# entrypoint keeps its URI.
write_file(
    name = "generated",
    out = "bin/generated.dart",
    content = ["const generated = true;"],
)

dart_binary(
    name = "probe_beside_generated",
    srcs = [":generated"],
    main = "bin/probe.dart",
    deps = [":where"],
)

dart_test(
    name = "kernel_uri_test",
    size = "small",
    data = [
        ":probe",
        ":probe_beside_generated",
        ":probe_kernel",
        ":probe_with_asset",
    ],
    main = "kernel_uri_test.dart",
    deps = ["//dart/runfiles"],
)
