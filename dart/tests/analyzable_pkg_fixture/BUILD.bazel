load("//dart/tests:analyze_test.bzl", "analyzed_test", "fixable_test")
load("//dart/tests:dart_info_test.bzl", "wrapper_executable")

# The shape a downstream `flutter_test` has, under a real `dart analyze` run.
#
# Analysis is where this constructor is actually load-bearing: the provider
# assertions next door prove the package record reaches the nested `DartInfo`,
# but only the analyzer proves that record is what makes
# `package:analyzable_pkg/…` resolve. Built through
# `dart_analyzable_info_no_package()` instead, every import in these three files
# reports `uri_does_not_exist` and this target goes red.

wrapper_executable(
    name = "exec",
    package_name = "analyzable_pkg",
    srcs = [
        "lib/model.dart",
        "lib/view.dart",
    ],
    entry_srcs = ["main.dart"],
    language_version = "3.11",
)

analyzed_test(
    name = "analyze_exec",
    size = "small",
    target = ":exec",
)

# Fixes stage through the same project, so they inherit the fix and would
# inherit the regression. Cheap to pin from the side that applies fixes.
fixable_test(
    name = "fix_exec_test",
    size = "small",
    target = ":exec",
)
