load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("//dart:defs.bzl", "dart_binary", "dart_code_asset", "dart_test")
load(":manifest_test.bzl", "one_path_test")

# One shared library serving two packages' asset ids: the VM must open one
# path for both, so the OS loader returns one image.

cc_library(
    name = "counter",
    srcs = ["counter.cc"],
)

cc_shared_library(
    name = "counter_shared",
    # On Windows a DLL exports nothing unless told to.
    features = select({
        "@platforms//os:windows": ["windows_export_all_symbols"],
        "//conditions:default": [],
    }),
    # Also a prebuilt library's stand-in.
    visibility = ["//dart/tests/prebuilt_library_fixture:__pkg__"],
    deps = [":counter"],
)

dart_code_asset(
    name = "a",
    asset_id = "package:a/a.dart",
    file = ":counter_shared",
)

dart_code_asset(
    name = "b",
    asset_id = "package:b/b.dart",
    file = ":counter_shared",
)

dart_test(
    name = "shared_library_asset_test",
    size = "small",
    code_assets = [
        ":a",
        ":b",
    ],
    main = "shared_library_asset_test.dart",
    # `test_runner_test` runs it through its launcher as `bazel run` would.
    visibility = ["//dart/private/tools:__pkg__"],
)

dart_binary(
    name = "shared_library_asset_bin",
    code_assets = [
        ":a",
        ":b",
    ],
    main = "shared_library_asset_test.dart",
)

one_path_test(
    name = "binary_manifest_test",
    size = "small",
    asset_ids = [
        "package:a/a.dart",
        "package:b/b.dart",
    ],
    target_under_test = ":shared_library_asset_bin",
)

one_path_test(
    name = "test_manifest_test",
    size = "small",
    asset_ids = [
        "package:a/a.dart",
        "package:b/b.dart",
    ],
    target_under_test = ":shared_library_asset_test",
)
