# Native code built in place of a package's build hook is identified as what
# it is built from, not as the Dart package: SQLite as the BCR module, the
# BoringSSL webcrypto vendors as BoringSSL. webcrypto's own C glue is in its
# pub archive, so is that package's.
package_metadata_check(
    name = "curated_package_metadata",
    want = {
        "//dart/ext/sqlite3:libsqlite3": "//dart/ext/sqlite3:sqlite3_package_metadata",
        "//dart/ext/sqlite3:code_asset": "//:package_metadata",
        "@webcrypto_pub_archive//:boringssl_crypto": "@webcrypto_pub_archive//:boringssl_package_metadata",
        "@webcrypto_pub_archive//:webcrypto": "@webcrypto_pub_archive//:package_metadata",
        "//dart/ext/webcrypto:libwebcrypto": "//:package_metadata",
    },
    deps = [
        "//dart/ext/sqlite3:code_asset",
        "//dart/ext/webcrypto:code_asset",
    ],
)

build_test(
    name = "curated_package_metadata_test",
    targets = [":curated_package_metadata"],
)

