load("//dart:defs.bzl", "dart_library")

# The library lives here rather than in `//dart/tests` so that its `lib_root`
# is this directory and `lib/shape.dart` sits under it — the layout every real
# Dart package has, and the one `check_srcs_under_lib_root` requires.
dart_library(
    name = "shape_fixture_lib",
    package_name = "shape_fixture",
    srcs = ["lib/shape.dart"],
    visibility = ["//dart/tests:__pkg__"],
)
