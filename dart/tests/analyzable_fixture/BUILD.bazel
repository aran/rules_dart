load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//dart:defs.bzl", "dart_analyze_test", "dart_binary", "dart_fix", "dart_js_binary", "dart_library")
load(
    "//dart/tests:analyze_test.bzl",
    "analyzable_provider_test",
    "binary_not_a_dep_test",
    "both_operands_test",
    "no_operand_test",
    "stages_entrypoint_test",
)

# A binary whose `main` sits beside `lib/`, importing a library inside it: the
# shape nine of this repo's e2e workspaces have, and the one nothing could
# analyze until `dart_analyze_test` learned to take an executable.

dart_library(
    name = "dep",
    package_name = "analyzable_dep",
    srcs = ["lib/dep.dart"],
)

dart_binary(
    name = "bin",
    main = "main.dart",
    deps = [":dep"],
)

analyzable_provider_test(
    name = "analyzable_provider_test",
    size = "small",
    target_under_test = ":bin",
)

dart_analyze_test(
    name = "analyze_bin",
    size = "small",
    target = ":bin",
)

stages_entrypoint_test(
    name = "stages_entrypoint_test",
    size = "small",
    target_under_test = ":analyze_bin",
)

# The only targets still spelling the operand `lib`, and the only reason they
# exist: rules_flutter has 15 `dart_analyze_test(lib = ...)` call sites, and
# every in-repo one moved to `target`. Without these, the alias could stop
# working and nothing here would notice until a downstream bump.
#
# Both rules are pinned even though they share `analyze_operand`, because the
# attribute declaration each carries is exactly the part they do not share.
dart_analyze_test(
    name = "analyze_via_lib_alias",
    size = "small",
    lib = ":dep",
)

dart_fix(
    name = "fix_via_lib_alias",
    lib = ":dep",
)

build_test(
    name = "fix_via_lib_alias_test",
    size = "small",
    targets = [":fix_via_lib_alias"],
)

# `manual` on every negative fixture below: each is expected to fail analysis,
# and a `//dart/tests/...` wildcard that built them would fail the build before
# any test ran. The `*_test` targets next to them are what actually assert the
# failure.

dart_library(
    name = "bad",
    tags = ["manual"],
    deps = [":bin"],
)

binary_not_a_dep_test(
    name = "binary_not_a_dep_test",
    size = "small",
    target_under_test = ":bad",
)

dart_analyze_test(
    name = "both_operands",
    lib = ":dep",
    tags = ["manual"],
    target = ":dep",
)

both_operands_test(
    name = "both_operands_test",
    size = "small",
    target_under_test = ":both_operands",
)

dart_analyze_test(
    name = "no_operand",
    tags = ["manual"],
)

no_operand_test(
    name = "no_operand_test",
    size = "small",
    target_under_test = ":no_operand",
)

# `dart_js_binary` and `dart_wasm_binary` share `_dart_web_compile`'s provider
# list, so they carry `DartAnalyzableInfo` too — untested until now, which meant
# the web rules could stop providing it without a failure anywhere.
dart_js_binary(
    name = "web_bin",
    main = "main.dart",
    deps = [":dep"],
)

dart_analyze_test(
    name = "analyze_web_bin",
    size = "small",
    target = ":web_bin",
)
