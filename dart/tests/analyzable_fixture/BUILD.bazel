load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//dart:defs.bzl", "dart_binary", "dart_fix", "dart_js_binary", "dart_library")
load(
    "//dart/tests:analyze_test.bzl",
    "analyzable_provider_test",
    "analyzed_test",
    "binary_not_a_dep_test",
)

# A binary whose `main` sits beside `lib/`, importing a library inside it: the
# shape nine of this repo's e2e workspaces have. Its entrypoint belongs to no
# package's `lib/`, so the aspect reaches it through `DartAnalyzableInfo`.

dart_library(
    name = "dep",
    package_name = "analyzable_dep",
    srcs = ["lib/dep.dart"],
)

dart_binary(
    name = "bin",
    main = "main.dart",
    deps = [":dep"],
)

analyzable_provider_test(
    name = "analyzable_provider_test",
    size = "small",
    target_under_test = ":bin",
)

analyzed_test(
    name = "analyze_bin",
    size = "small",
    target = ":bin",
)

dart_fix(
    name = "fix_bin",
    target = ":bin",
)

build_test(
    name = "fix_bin_test",
    size = "small",
    targets = [":fix_bin"],
)

# `manual`: expected to fail analysis. The `*_test` target next to it is what
# actually asserts the failure.
dart_library(
    name = "bad",
    tags = ["manual"],
    deps = [":bin"],
)

binary_not_a_dep_test(
    name = "binary_not_a_dep_test",
    size = "small",
    target_under_test = ":bad",
)

# `dart_js_binary` and `dart_wasm_binary` share `_dart_web_compile`'s provider
# list, so they carry `DartAnalyzableInfo` too — untested until now, which meant
# the web rules could stop providing it without a failure anywhere.
dart_js_binary(
    name = "web_bin",
    main = "main.dart",
    deps = [":dep"],
)

analyzed_test(
    name = "analyze_web_bin",
    size = "small",
    target = ":web_bin",
)
