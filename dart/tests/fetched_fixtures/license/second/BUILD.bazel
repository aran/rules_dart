load("@rules_dart//dart:defs.bzl", "dart_library")

# A fetcher's generated BUILD file loads it so.
# buildifier: disable=bzl-visibility
load("@rules_dart//dart/private:fetched_package_metadata.bzl", "fetched_package_metadata")

# `license_file_fixture` again, as a second fetcher would supply it: rooted
# here, fetched alike, with another license.
fetched_package_metadata(
    name = "pubspec-metadata",
    package_name = "license_file_fixture",
    license_file = "NOTICES",
    purl = "pkg:pub/license_file_fixture@1.0.0",
    tags = ["manual"],
    version = "1.0.0",
)

dart_library(
    name = "second",
    srcs = ["lib/fixture.dart"],
    package = ":pubspec-metadata",
    tags = ["manual"],
    visibility = ["@rules_dart//dart/tests/license_file_fixture:__pkg__"],
)
