load("@rules_dart//dart:defs.bzl", "dart_code_asset", "dart_library")

# A fetcher's generated BUILD file loads it so.
# buildifier: disable=bzl-visibility
load("@rules_dart//dart/private:fetched_package_metadata.bzl", "fetched_package_metadata")

# The far side of the diamond: the package that *owns* a native code asset.
# Nothing downstream names this asset; it must arrive by propagation alone.
# It is declared as a fetcher declares a package it fetched, so `b_alt` can
# stand in for a second fetcher's copy of it.

dart_code_asset(
    name = "code_asset",
    asset_id = "package:prop_b/src/ffi/prop_b.g.dart",
    file = "@rules_dart//dart/tests/cc_fixture:empty_shared",
    visibility = ["@rules_dart//dart/tests:__subpackages__"],
)

fetched_package_metadata(
    name = "pubspec-metadata",
    package_name = "prop_b",
    code_assets = [":code_asset"],
    purl = "pkg:pub/prop_b@1.0.0",
    version = "1.0.0",
)

dart_library(
    name = "b",
    srcs = ["lib/b.dart"],
    package = ":pubspec-metadata",
    visibility = ["@rules_dart//dart/tests:__subpackages__"],
)
