load("//dart:defs.bzl", "dart_binary", "dart_library", "dart_package_metadata")
load("//dart/tests:executable_package_test.bzl", "executable_package_refused_test")

# Names no `dart_package_metadata`.
dart_library(
    name = "silent",
    srcs = ["lib/silent.dart"],
)

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "silent",
    language_version = "3.6",
    tags = ["manual"],
)

# The same package, naming a declaration its library does not: the library's
# files would compile at 3.6 in this binary and at the SDK's version everywhere
# else.
dart_binary(
    name = "loud",
    main = "bin/loud.dart",
    package = ":pubspec-metadata",
    tags = ["manual"],
    deps = [":silent"],
)

executable_package_refused_test(
    name = "loud_test",
    size = "small",
    message = "The package rooted at `dart/tests/exec_package_fixture/silent` is built by targets naming different `dart_package_metadata`:\n  - none (package \"silent\"), named by @@//dart/tests/exec_package_fixture/silent:silent\n  - @@//dart/tests/exec_package_fixture/silent:pubspec-metadata (package \"silent\"), named by @@//dart/tests/exec_package_fixture/silent:loud\n",
    target_under_test = ":loud",
)

# An entrypoint from another directory cannot take this package's version.
dart_binary(
    name = "outside",
    main = "//dart/tests/exec_package_fixture:test/member_test.dart",
    package = ":pubspec-metadata",
    tags = ["manual"],
    deps = ["//dart/tests/exec_package_fixture:lib"],
)

executable_package_refused_test(
    name = "outside_test",
    size = "small",
    message = "but its source `dart/tests/exec_package_fixture/test/member_test.dart` is outside that directory",
    target_under_test = ":outside",
)
