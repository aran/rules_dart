"""An executable stating the package it belongs to, and every contradiction refused.

`exec_pkg` is a library package at 3.8, declared once in `:meta`. Its test
joins it through the same declaration, and so do the binaries in `bin/`, whose
BUILD file is below the package root; `nested_example/` is a different package
nested inside it, which Dart allows. Every other executable here names a
package its `deps` contradict, is tagged `manual`, and is pinned by the error
that names both sides.
"""

load("//dart:defs.bzl", "dart_binary", "dart_codegen", "dart_library", "dart_package_metadata", "dart_test")
load(
    "//dart/tests:executable_package_test.bzl",
    "executable_package_refused_test",
    "package_config_probe_test",
)

exports_files(["test/member_test.dart"])

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "exec_pkg",
    language_version = "3.8",
    visibility = ["//dart/tests/exec_package_fixture:__subpackages__"],
)

dart_library(
    name = "lib",
    srcs = ["lib/exec_pkg.dart"],
    package = ":pubspec-metadata",
    visibility = ["//dart/tests/exec_package_fixture:__subpackages__"],
)

# The library's own test, a member of its package: one record, one version.
dart_test(
    name = "member_test",
    size = "small",
    main = "test/member_test.dart",
    package = ":pubspec-metadata",
    deps = [":lib"],
)

package_config_probe_test(
    name = "member_test_package_config_test",
    size = "small",
    expected = ['"name": "exec_pkg", "rootUri": "org-dartlang-root:///dart/tests/exec_package_fixture/", "packageUri": "lib/", "languageVersion": "3.8"'],
    expected_language_version = "3.8",
    expected_package_name = "exec_pkg",
    target_under_test = ":member_test",
)

# --- contradictions the build must refuse -----------------------------------

# An entrypoint inside a package nested in this one: Dart gives it the inner
# package's version, never this one's.
dart_binary(
    name = "swallowed",
    main = "//dart/tests/exec_package_fixture/inner:bin/inner_main.dart",
    package = ":pubspec-metadata",
    tags = ["manual"],
    deps = [
        ":lib",
        "//dart/tests/exec_package_fixture/inner",
    ],
)

executable_package_refused_test(
    name = "swallowed_test",
    size = "small",
    message = "lies inside package \"inner_pkg\" (root `dart/tests/exec_package_fixture/inner`",
    target_under_test = ":swallowed",
)

# A generated source for a package naming no declaration, collected by an
# executable of the package `:meta` declares.
dart_codegen(
    name = "misnamed_g",
    src = "test/member_test.dart",
    generator = "//dart/tests/fixture_generator:generator",
    output_suffixes = [".g.dart"],
    tags = ["manual"],
)

dart_test(
    name = "misnamed_codegen",
    srcs = [":misnamed_g"],
    main = "test/member_test.dart",
    package = ":pubspec-metadata",
    tags = ["manual"],
    deps = [":lib"],
)

executable_package_refused_test(
    name = "misnamed_codegen_test",
    size = "small",
    message = "generates sources for package \"exec_package_fixture\", which names no `dart_package_metadata`, but @@//dart/tests/exec_package_fixture:misnamed_codegen collects them into the package `@@//dart/tests/exec_package_fixture:pubspec-metadata` declares",
    target_under_test = ":misnamed_codegen",
)
