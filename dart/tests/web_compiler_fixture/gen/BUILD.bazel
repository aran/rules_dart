load("//dart:defs.bzl", "dart_codegen", "dart_library")

# Codegen resets the web compiler: its outputs are the same whichever binary
# reaches it, so it runs once.
dart_codegen(
    name = "model_g",
    package_name = "gen",
    src = "lib/model.dart",
    generator = "//dart/tests/package_fixture:gen.dart",
    output_suffixes = [".g.dart"],
    # The stand-in generator writes nothing: analysis only.
    tags = ["manual"],
)

dart_library(
    name = "gen",
    srcs = [
        "lib/model.dart",
        ":model_g",
    ],
    tags = ["manual"],
    visibility = ["//dart/tests/web_compiler_fixture:__subpackages__"],
)
