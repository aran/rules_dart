load("//dart:defs.bzl", "dart_code_asset", "dart_library", "dart_package_metadata")

# A native library under a web binary: `dart_code_asset` resets the web
# compiler, so the shared library is built once, in the configuration a plain
# build uses.
dart_code_asset(
    name = "native",
    asset_id = "package:asset/asset.dart",
    file = "//dart/tests/cc_fixture:empty_shared",
)

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "asset",
    code_assets = [":native"],
    tags = ["manual"],
)

dart_library(
    name = "asset",
    srcs = ["lib/asset.dart"],
    package = ":pubspec-metadata",
    tags = ["manual"],
    visibility = ["//dart/tests/web_compiler_fixture:__subpackages__"],
)
