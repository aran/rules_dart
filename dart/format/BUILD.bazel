load("//dart/private:apply_changes.bzl", "apply_changes_binary")

# Formats the Dart targets the patterns name as their format check would have
# them:
#   bazel run @rules_dart//dart/format -- //app/...
#   bazel run @rules_dart//dart/format -- --dry-run //app:lib
#   bazel run @rules_dart//dart/format -- --config=deep -- //app/... -//app/gen/...
# After `--dry-run`, the arguments are `bazel build`'s.
apply_changes_binary(
    name = "format",
    command = "format",
    output_group = "dart_format_changes",
)
