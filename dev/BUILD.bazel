load("@bazel_gazelle//:def.bzl", "gazelle", "gazelle_binary", "gazelle_generation_test")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@rules_dart//dart:defs.bzl", "dart_test")

# gazelle:map_kind bzl_library bzl_library @bazel_skylib//:bzl_library.bzl
gazelle_binary(
    name = "gazelle_bin",
    languages = [
        "@bazel_skylib_gazelle_plugin//bzl",
        "@rules_dart_gazelle_plugin//dart",
    ],
)

# Gazelle writes rules_dart's `bzl_library` targets, and only those: its Dart
# targets are test fixtures and tools laid out by hand, often to be what
# Gazelle would not write. CI fails when this would change a BUILD file.
gazelle_binary(
    name = "bzl_gazelle_bin",
    languages = ["@bazel_skylib_gazelle_plugin//bzl"],
)

gazelle(
    name = "gazelle",
    gazelle = "bzl_gazelle_bin",
)

dart_test(
    name = "gazelle_test",
    size = "small",
    args = ["$(rlocationpath :gazelle_bin)"],
    data = [":gazelle_bin"],
    main = "gazelle_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)

filegroup(
    name = "testdata",
    srcs = glob(["testdata/**"]),
)

gazelle_generation_test(
    name = "gazelle_generation_test",
    size = "small",
    gazelle_binary = ":gazelle_bin",
    test_data = [":testdata"],
)

# The plugin's filter and rules_dart's `check_dual_build_collisions` know the
# same generated-file extensions. Each module ships its own copy, since
# neither depends on the other.
diff_test(
    name = "generated_extensions_agree_test",
    size = "small",
    file1 = "@rules_dart//dart/ext/tools:baseline_generated_extensions.txt",
    file2 = "@rules_dart_gazelle_plugin//dart:baseline_generated_extensions.txt",
)
