load("@rules_dart//dart:defs.bzl", "dart_codegen", "dart_library")
load("@rules_dart//dart/ext/copy_with_extension_gen:defs.bzl", "copy_with_library")
load("@rules_dart//dart/ext/json_serializable:defs.bzl", "json_serializable_library")

# gazelle:dart_builder_config CopyWith {"copy_with_null": true}

dart_codegen(
    name = "_event_freezed_gen",
    package_name = "build_yaml_fixture",
    src = "event.dart",
    generator_bin = "@rules_dart//dart/ext/freezed:shim",
    language_version = "3.11",
    output_suffixes = [".freezed.dart"],
    deps = ["@freezed_annotation"],
)

dart_codegen(
    name = "_event_json_serializable_gen",
    package_name = "build_yaml_fixture",
    src = "event.dart",
    asset_deps = [":_event_freezed_gen"],
    config = "{\"explicit_to_json\":true,\"field_rename\":\"pascal\"}",
    generator_bin = "@rules_dart//dart/ext/json_serializable:shim",
    language_version = "3.11",
    output_suffixes = [".json_serializable.g.part"],
    deps = [
        "@freezed_annotation",
        "@json_annotation",
    ],
)

dart_codegen(
    name = "_event_combined",
    package_name = "build_yaml_fixture",
    src = "event.dart",
    generator_bin = "@rules_dart//dart/ext/_shared/combining_shim:bin",
    language_version = "3.11",
    output_suffixes = [".g.dart"],
    parts = [":_event_json_serializable_gen"],
)

dart_library(
    name = "event",
    package_name = "build_yaml_fixture",
    srcs = [
        "event.dart",
        ":_event_combined",
        ":_event_freezed_gen",
    ],
    language_version = "3.11",
    visibility = ["//visibility:public"],
    deps = ["@freezed_annotation"],
)

copy_with_library(
    name = "profile",
    package_name = "build_yaml_fixture",
    srcs = ["profile.dart"],
    annotation_dep = "@copy_with_extension",
    config = "{\"copy_with_null\": true}",
    language_version = "3.11",
    visibility = ["//visibility:public"],
    deps = ["@copy_with_extension"],
)

json_serializable_library(
    name = "user",
    package_name = "build_yaml_fixture",
    srcs = ["user.dart"],
    annotation_dep = "@json_annotation",
    config = "{\"explicit_to_json\":true,\"field_rename\":\"pascal\"}",
    language_version = "3.11",
    visibility = ["//visibility:public"],
    deps = ["@json_annotation"],
)
