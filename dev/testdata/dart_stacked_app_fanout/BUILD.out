load("@rules_dart//dart:defs.bzl", "dart_codegen", "dart_library", "dart_package_metadata")

# gazelle:dart_package_name stacked_fanout
# gazelle:dart_language_version 3.11

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "stacked_fanout",
    language_version = "3.11",
    visibility = ["//:__subpackages__"],
)

dart_codegen(
    name = "_app_stacked_app_bottomsheets_gen",
    src = "lib/app.dart",
    generator = "@rules_dart//dart/ext/stacked:shim_bottomsheet",
    output_suffixes = [".bottomsheets.dart"],
    package = ":pubspec-metadata",
    deps = ["@stacked"],
)

dart_codegen(
    name = "_app_stacked_app_dialogs_gen",
    src = "lib/app.dart",
    generator = "@rules_dart//dart/ext/stacked:shim_dialog",
    output_suffixes = [".dialogs.dart"],
    package = ":pubspec-metadata",
    deps = ["@stacked"],
)

dart_codegen(
    name = "_app_stacked_app_locator_gen",
    src = "lib/app.dart",
    generator = "@rules_dart//dart/ext/stacked:shim_locator",
    output_suffixes = [".locator.dart"],
    package = ":pubspec-metadata",
    deps = ["@stacked"],
)

dart_codegen(
    name = "_app_stacked_app_logger_gen",
    src = "lib/app.dart",
    generator = "@rules_dart//dart/ext/stacked:shim_logger",
    output_suffixes = [".logger.dart"],
    package = ":pubspec-metadata",
    deps = ["@stacked"],
)

dart_codegen(
    name = "_app_stacked_app_router_gen",
    src = "lib/app.dart",
    generator = "@rules_dart//dart/ext/stacked:shim_router",
    output_suffixes = [".router.dart"],
    package = ":pubspec-metadata",
    deps = ["@stacked"],
)

dart_library(
    name = "stacked_fanout",
    srcs = [
        "lib/app.dart",
        ":_app_stacked_app_bottomsheets_gen",
        ":_app_stacked_app_dialogs_gen",
        ":_app_stacked_app_locator_gen",
        ":_app_stacked_app_logger_gen",
        ":_app_stacked_app_router_gen",
    ],
    package = ":pubspec-metadata",
    visibility = ["//visibility:public"],
    deps = ["@stacked"],
)
