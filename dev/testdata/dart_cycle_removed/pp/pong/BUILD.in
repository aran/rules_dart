load("@rules_dart//dart:defs.bzl", "dart_package_member", "dart_package_metadata")

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "pong",
    visibility = ["//pp/pong:__subpackages__"],
)

dart_package_member(
    name = "pong_member",
    srcs = ["lib/pong.dart"],
    package = ":pubspec-metadata",
    visibility = ["//pp:__pkg__"],
)

alias(
    name = "pong",
    actual = "//pp:ping_pong",
    visibility = ["//visibility:public"],
)
