load("@rules_dart//dart:defs.bzl", "dart_codegen", "dart_library", "dart_package_metadata")

dart_package_metadata(
    name = "pkg",
    package_name = "decl_fixture",
    language_version = "3.11",
    visibility = ["//:__subpackages__"],
)

dart_codegen(
    name = "_event_freezed_gen",
    src = "lib/event.dart",
    generator_bin = "@rules_dart//dart/ext/freezed:shim",
    output_suffixes = [".freezed.dart"],
    package = ":pkg",
    deps = ["@freezed_annotation"],
)

dart_codegen(
    name = "_event_json_serializable_gen",
    src = "lib/event.dart",
    asset_deps = [":_event_freezed_gen"],
    generator_bin = "@rules_dart//dart/ext/json_serializable:shim",
    output_suffixes = [".json_serializable.g.part"],
    package = ":pkg",
    deps = [
        "@freezed_annotation",
        "@json_annotation",
    ],
)

dart_codegen(
    name = "_event_combined",
    src = "lib/event.dart",
    generator_bin = "@rules_dart//dart/ext/combining_shim:bin",
    output_suffixes = [".g.dart"],
    package = ":pkg",
    parts = [":_event_json_serializable_gen"],
)

dart_library(
    name = "decl_fixture",
    srcs = [
        "lib/event.dart",
        ":_event_combined",
        ":_event_freezed_gen",
    ],
    package = ":pkg",
    visibility = ["//visibility:public"],
    deps = [
        "@freezed_annotation",
        "@json_annotation",
    ],
)
