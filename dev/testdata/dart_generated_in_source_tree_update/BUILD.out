load("@rules_dart//dart:defs.bzl", "dart_library", "dart_package_metadata")
load("@rules_dart//dart/ext/json_serializable:defs.bzl", "json_serializable_codegen")

# gazelle:dart_package_name generated_in_source_tree_update

dart_library(
    name = "generated_in_source_tree_update",
    srcs = [
        "lib/user.dart",
        "lib/user.freezed.dart",
        ":user_codegen",
    ],
    package = ":pubspec-metadata",
    visibility = ["//visibility:public"],
    deps = ["@json_annotation"],
)

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "generated_in_source_tree_update",
    visibility = ["//:__subpackages__"],
)

json_serializable_codegen(
    name = "user_codegen",
    srcs = ["lib/user.dart"],
    annotation_dep = "@json_annotation",
    package = ":pubspec-metadata",
    deps = ["@json_annotation"],
)
