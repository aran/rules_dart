load("@rules_dart//dart:defs.bzl", "dart_codegen", "dart_library")
load("@rules_dart//dart/ext/freezed:defs.bzl", "freezed_codegen")

freezed_codegen(
    name = "event_codegen",
    package_name = "kind_change",
    srcs = ["lib/event.dart"],
    language_version = "3.11",
    deps = ["@freezed_annotation"],
)

dart_codegen(
    name = "_user_copy_with_gen",
    package_name = "kind_change",
    src = "lib/user.dart",
    generator = "@rules_dart//dart/ext/copy_with_extension_gen:shim",
    language_version = "3.11",
    output_suffixes = [".copy_with_extension_gen.g.part"],
    deps = ["@copy_with_extension"],
)

dart_codegen(
    name = "_user_json_serializable_gen",
    package_name = "kind_change",
    src = "lib/user.dart",
    generator = "@rules_dart//dart/ext/json_serializable:shim",
    language_version = "3.11",
    output_suffixes = [".json_serializable.g.part"],
    deps = ["@json_annotation"],
)

dart_codegen(
    name = "_user_combined",
    package_name = "kind_change",
    src = "lib/user.dart",
    generator = "@rules_dart//dart/ext/combining_shim:bin",
    language_version = "3.11",
    output_suffixes = ["lib/.g.dart"],
    parts = [
        ":_user_copy_with_gen",
        ":_user_json_serializable_gen",
    ],
)

dart_library(
    name = "kind_change",
    package_name = "kind_change",
    srcs = [
        "lib/event.dart",
        "lib/user.dart",
        ":_user_combined",
        ":event_codegen",
    ],
    language_version = "3.11",
    visibility = ["//visibility:public"],
    deps = [
        "@copy_with_extension",
        "@freezed_annotation",
        "@json_annotation",
    ],
)
