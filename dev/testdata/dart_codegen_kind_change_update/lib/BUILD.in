load("@rules_dart//dart:defs.bzl", "dart_codegen", "dart_library")
load("@rules_dart//dart/ext/freezed:defs.bzl", "freezed_library")

freezed_library(
    name = "event",
    package_name = "kind_change",
    srcs = ["event.dart"],
    language_version = "3.11",
    visibility = ["//visibility:public"],
    deps = ["@freezed_annotation"],
)

dart_codegen(
    name = "_user_copy_with_gen",
    package_name = "kind_change",
    src = "user.dart",
    generator_bin = "@rules_dart//dart/ext/copy_with_extension_gen:shim",
    language_version = "3.11",
    output_suffixes = [".copy_with_extension_gen.g.part"],
    deps = ["@copy_with_extension"],
)

dart_codegen(
    name = "_user_json_serializable_gen",
    package_name = "kind_change",
    src = "user.dart",
    generator_bin = "@rules_dart//dart/ext/json_serializable:shim",
    language_version = "3.11",
    output_suffixes = [".json_serializable.g.part"],
    deps = ["@json_annotation"],
)

dart_codegen(
    name = "_user_combined",
    package_name = "kind_change",
    src = "user.dart",
    generator_bin = "@rules_dart//dart/ext/_shared/combining_shim:bin",
    language_version = "3.11",
    output_suffixes = [".g.dart"],
    parts = [
        ":_user_copy_with_gen",
        ":_user_json_serializable_gen",
    ],
)

dart_library(
    name = "user",
    package_name = "kind_change",
    srcs = [
        "user.dart",
        ":_user_combined",
    ],
    language_version = "3.11",
    visibility = ["//visibility:public"],
    deps = [
        "@copy_with_extension",
        "@json_annotation",
    ],
)
