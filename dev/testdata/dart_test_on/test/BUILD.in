load("@rules_dart//dart:defs.bzl", "dart_test")

dart_test(
    name = "untagged_test",
    main = "untagged_test.dart",
    target_compatible_with = ["@platforms//os:linux"],
)

dart_test(
    name = "kept_test",
    main = "kept_test.dart",
    target_compatible_with = ["@platforms//:incompatible"],  # keep
)

dart_test(
    name = "vm_test",
    main = "vm_test.dart",
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)
