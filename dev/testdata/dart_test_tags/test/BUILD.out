    name = "named_library_test",
    main = "named_library_test.dart",
    tags = ["slow"],
    deps = ["@test"],
)

dart_test(
    name = "prefixed_test",
    main = "prefixed_test.dart",
    tags = ["db"],
    deps = ["@test"],
)

dart_test(
    name = "reserved_test",
