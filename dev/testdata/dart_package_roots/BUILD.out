load("@rules_dart//dart:defs.bzl", "dart_library", "dart_package_metadata")

dart_package_metadata(
    name = "pubspec",
    package_name = "app",
    visibility = ["//:__subpackages__"],
)

dart_library(
    name = "app",
    srcs = ["lib/app.dart"],
    package = ":pubspec",
    visibility = ["//visibility:public"],
)
