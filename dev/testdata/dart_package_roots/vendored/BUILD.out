load("@rules_dart//dart:defs.bzl", "dart_library", "dart_package_metadata")

dart_package_metadata(
    name = "metadata",
    package_name = "vendored",
    visibility = ["//vendored:__subpackages__"],
)

dart_library(
    name = "vendored",
    srcs = ["lib/vendored.dart"],
    package = ":metadata",
    visibility = ["//visibility:public"],
)
