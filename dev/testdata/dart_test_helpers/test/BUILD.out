load("@rules_dart//dart:defs.bzl", "dart_test")

filegroup(
    name = "test",
    srcs = [
        "fixtures.dart",
        "names.dart",
    ],
    visibility = ["//test:__subpackages__"],
)

dart_test(
    name = "greeter_test",
    srcs = [
        "fixtures.dart",
        "names.dart",
    ],
    main = "greeter_test.dart",
    package = "//:pubspec-metadata",
    deps = [
        "//:helpers_fixture",
        "@meta",
        "@test",
    ],
)

dart_test(
    name = "plain_test",
    main = "plain_test.dart",
    package = "//:pubspec-metadata",
    deps = ["@test"],
)
