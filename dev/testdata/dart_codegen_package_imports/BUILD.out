load("@rules_dart//dart:defs.bzl", "dart_library")
load("@rules_dart//dart/ext/freezed:defs.bzl", "freezed_codegen")
load("@rules_dart//dart/ext/json_serializable:defs.bzl", "json_serializable_codegen")

# gazelle:dart_package_name imports

freezed_codegen(
    name = "role_codegen",
    package_name = "imports",
    srcs = ["lib/role.dart"],
    annotation_dep = "@freezed_annotation",
    deps = ["@freezed_annotation"],
)

json_serializable_codegen(
    name = "user_codegen",
    package_name = "imports",
    srcs = ["lib/user.dart"],
    annotation_dep = "@json_annotation",
    asset_deps = [
        "lib/imports.dart",
        "lib/role.dart",
        "lib/src/helper.dart",
        ":role_codegen",
    ],
    deps = [
        "@collection",
        "@freezed_annotation",
        "@json_annotation",
        "@meta",
    ],
)

dart_library(
    name = "imports",
    package_name = "imports",
    srcs = [
        "lib/imports.dart",
        "lib/role.dart",
        "lib/src/helper.dart",
        "lib/user.dart",
        ":role_codegen",
        ":user_codegen",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@collection",
        "@freezed_annotation",
        "@json_annotation",
        "@meta",
    ],
)
