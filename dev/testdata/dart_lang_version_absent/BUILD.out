load("@rules_dart//dart:defs.bzl", "dart_library")
load("@rules_dart//dart/ext/json_serializable:defs.bzl", "json_serializable_codegen")

json_serializable_codegen(
    name = "user_codegen",
    package_name = "lib",
    srcs = ["lib/user.dart"],
    annotation_dep = "@json_annotation",
    deps = ["@json_annotation"],
)

dart_library(
    name = "lib",
    srcs = [
        "lib/user.dart",
        ":user_codegen",
    ],
    visibility = ["//visibility:public"],
    deps = ["@json_annotation"],
)
