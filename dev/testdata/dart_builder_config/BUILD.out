load("@rules_dart//dart:defs.bzl", "dart_library", "dart_package_metadata")
load("@rules_dart//dart/ext/json_serializable:defs.bzl", "json_serializable_codegen")

# gazelle:dart_package_name builder_config_fixture
# gazelle:dart_language_version 3.11
# gazelle:dart_builder_config JsonSerializable {"field_rename": "snake"}

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "builder_config_fixture",
    language_version = "3.11",
    visibility = ["//:__subpackages__"],
)

json_serializable_codegen(
    name = "user_codegen",
    srcs = ["lib/user.dart"],
    annotation_dep = "@json_annotation",
    config = "{\"field_rename\": \"snake\"}",
    package = ":pubspec-metadata",
    deps = ["@json_annotation"],
)

dart_library(
    name = "builder_config_fixture",
    srcs = [
        "lib/user.dart",
        ":user_codegen",
    ],
    package = ":pubspec-metadata",
    visibility = ["//visibility:public"],
    deps = ["@json_annotation"],
)
