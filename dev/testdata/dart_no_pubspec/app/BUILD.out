load("@rules_dart//dart:defs.bzl", "dart_library", "dart_package_metadata")

dart_package_metadata(
    name = "package",
    package_name = "app",
    language_version = "3.13",
)

dart_library(
    name = "app",
    srcs = [
        "lib/app.dart",
        "lib/src/model.dart",
    ],
    package = ":package",
    visibility = ["//visibility:public"],
    deps = ["//greet"],
)
