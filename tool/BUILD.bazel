load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//dart:defs.bzl", "dart_binary", "dart_test")

# Read by //tools/vm:run_e2e, which runs what CI runs.
exports_files(
    ["ci_workflow.dart"],
    visibility = ["//tools/vm:__pkg__"],
)

# Read by every `starlark_docs_test`.
exports_files(
    [
        "starlark_docs.dart",
        "starlark_docs_check.dart",
    ],
    visibility = ["//dart:__subpackages__"],
)

# Checks (or with `-- --refresh`, rewrites) the pubspec.lock files outside
# e2e/. MODULE.bazel.lock files are `bazel run @overhead//locks:check`'s.
dart_binary(
    name = "pub_locks",
    main = "pub_locks.dart",
)

# Prints the Dart SDK archive hashes a toolchain pin needs (see the file).
dart_binary(
    name = "fetch_sdk_hashes",
    main = "fetch_sdk_hashes.dart",
)

# Checks that CI's `conclusion` job gates on every job that must pass, and that
# some job runs in every e2e workspace. CI runs it; see ci_check.dart.
dart_binary(
    name = "ci_check",
    srcs = ["ci_workflow.dart"],
    main = "ci_check.dart",
    deps = ["@ext_pub_deps//:yaml"],
)

dart_test(
    name = "ci_workflow_test",
    size = "small",
    srcs = ["ci_workflow.dart"],
    main = "ci_workflow_test.dart",
    deps = [
        "@ext_pub_deps//:test",
        "@ext_pub_deps//:yaml",
    ],
)

dart_test(
    name = "starlark_docs_test",
    size = "small",
    srcs = ["starlark_docs.dart"],
    data = ["//tool/testdata:undocumented.binaryproto"],
    main = "starlark_docs_test.dart",
    deps = [
        "//dart/runfiles",
        "@ext_pub_deps//:protobuf",
        "@ext_pub_deps//:test",
    ],
)

bzl_library(
    name = "starlark_docs",
    srcs = ["starlark_docs.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//dart:defs"],
)
