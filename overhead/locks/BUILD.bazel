load("@rules_dart//dart:defs.bzl", "dart_binary", "dart_test")

# Checks (or with `-- --refresh`, rewrites) every workspace's MODULE.bazel.lock,
# without the developer's `.bazelrc.user`. See locks.dart.
dart_binary(
    name = "locks",
    srcs = ["lock_workspaces.dart"],
    main = "locks.dart",
    visibility = ["//visibility:public"],
)

dart_test(
    name = "lock_workspaces_test",
    size = "small",
    srcs = ["lock_workspaces.dart"],
    main = "test/lock_workspaces_test.dart",
    deps = ["@overhead_dev_deps//:test"],
)
