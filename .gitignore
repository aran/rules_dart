# pubspec.lock files generated by `dart pub get` in e2e dirs that only use
# local path deps (no pub packages). These pubspec.yaml files exist solely to
# satisfy the Dart analyzer in the IDE; the locks are trivial and not used by
# Bazel. The locks pub.from_lock() reads at build time (e2e/examples/pub/lock/,
# e2e/examples/tests/package_test/, e2e/examples/web/app/ and others) ARE tracked.
e2e/examples/tests/pubspec.lock
e2e/examples/library_deps/pubspec.lock
e2e/examples/gazelle/pubspec.lock
e2e/examples/pub/package/pubspec.lock
