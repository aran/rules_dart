"""File declaring metadata applying to all packages and targets in the Bazel module."""

repo(
    default_package_metadata = [
        "//:package_metadata",
    ],
)

# Not packages of this module, here or in a consumer's copy of it (where
# `.bazelignore` would not apply): the end-to-end workspaces; overhead, a
# workspace of its own; gazelle, the Gazelle plugin's module; dev, a module the
# root depends on for development; and the checkout's own state.
ignore_directories([
    "bazel-*",
    ".bazel_env",
    # Claude Code keeps its worktrees here, full checkouts Bazel would read as packages.
    ".claude",
    ".github",
    "dev",
    "docs",
    "e2e",
    "gazelle",
    "overhead",
    "references",
])
